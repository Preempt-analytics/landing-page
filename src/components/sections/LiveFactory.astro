---
// §9.2 Live Factory — connective tissue between the abstract hero and the physical
// hardware. Real isometric CNC-floor photo (design/visual-assets/cnc_factory_floor.png,
// human review 2026-07-28), with the drift-alert callout as a UI overlay on top.
// No card border/fill (human review, 2026-07-28): a soft radial mask fades the photo
// to transparent at the edges instead, so it bleeds into the section's own bg-navy-900
// rather than sitting in a boxed card.
import { withBase } from '../../lib/site';
import { liveMachines } from '../../lib/live-machines';

// Mini sparkline for each machine's hover card — the same recorded run
// /product's Live Machines panel replays (src/data/live-machines.json), drawn
// at BUILD time as a plain <svg polyline>, so this costs zero client JS and no
// extra payload beyond the points string itself.
//
// NOTE ON NAMING: the CNC-0N names in this section are illustrative (see the
// `machines` comment below); the traces are real. CNC-0N maps to the recording's
// machine_0N, and the card labels the line as a recorded run rather than as
// live telemetry from the illustrated machine.
const recording = liveMachines();
const PROB = recording._meta.fields.indexOf('failure_prob');

function sparkPoints(name: string): string {
  const idx = Number(name.split('-')[1]) - 1;
  const frames = recording.machines[idx]?.frames ?? [];
  if (frames.length < 2) return '';
  // ~40 points is plenty at this size and keeps each points string short.
  const stride = Math.max(1, Math.round(frames.length / 40));
  const pts: string[] = [];
  for (let i = 0; i < frames.length; i += stride) {
    const p = Number(frames[i][PROB]);
    pts.push(`${((i / (frames.length - 1)) * 100).toFixed(1)},${(18 - p * 16).toFixed(1)}`);
  }
  return pts.join(' ');
}

// Named for immersion (human-requested, 2026-07-28) — CNC-01 matches the exact
// machine name already used in UserStory.astro's "Tool-wear shift spotted on
// CNC-01" beat, so this section's alert ties into that same story rather than
// introducing a second, disconnected machine id. Coordinates/delays unchanged
// from the original pin placement (read directly off cnc-factory-floor.png).
// bootDelay staggers the one-time "power-up" flash each pin plays the first
// time the section scrolls into view (human-requested, 2026-07-28) — a
// separate concern from `delay`, which offsets each pin's *continuous*
// ambient pulse so five sensors don't breathe in lockstep. Both live on the
// same element at once (see .sensor-pin's two-animation rule in <style>).
// `detail` varies per healthy machine (human-requested, 2026-08-05) — four
// identical "Nominal — no anomalies" cards read as one templated string
// copy-pasted four times rather than four independently-monitored machines.
// The status line above it (`No drift detected`, in the template below)
// stays fixed across all four: that's the real signal this section is
// demonstrating, so it matches the alert card's own fixed "Drift detected"
// wording. Only this flavor caption varies, purely cosmetic.
//
// `hint`/`hintDelay` (human-requested, 2026-08-07; eased down to just one
// pin the same day — two, even fully sequenced one-at-a-time, was still more
// than needed to make the point). Only CNC-05 gets a "Hover for details"
// discovery bubble, not all four — it's the healthy machine sitting
// bottom-right of CNC-01's always-open drift card, so a first-time visitor
// who's already looking at that card has it in the corner of their eye,
// nudging them to notice the OTHER dots are interactive too without needing
// a bubble on every one of them.
const machines = [
  { name: 'CNC-02', left: 27.7, top: 30.8, delay: '-0.6s', bootDelay: '0ms', alert: false, detail: 'Nominal — no anomalies' },
  { name: 'CNC-01', left: 61.5, top: 24.4, delay: '0s', bootDelay: '150ms', alert: true },
  { name: 'CNC-03', left: 80.1, top: 26.9, delay: '-1.7s', bootDelay: '300ms', alert: false, detail: 'All parameters normal' },
  { name: 'CNC-04', left: 39.1, top: 56.2, delay: '-0.9s', bootDelay: '450ms', alert: false, detail: 'Within safe operating band' },
  { name: 'CNC-05', left: 67.1, top: 56.6, delay: '-2.1s', bootDelay: '600ms', alert: false, detail: 'Everything looks fine here', hint: true, hintDelay: '2.2s' },
];
// The always-visible drift-card below reads its position off this SAME
// machine's own left/top rather than a separate hand-picked coordinate
// (mobile-audit follow-up, 2026-08-07 — a fixed top-left-corner placement
// on narrow viewports put the card far from CNC-01's actual pin, closer in
// screen space to a healthy machine, which read as "the alert is about the
// wrong machine"). Deriving the card's position from `alertMachine` makes
// that class of bug structurally impossible — there is only one machine
// with `alert: true`, and the card is always anchored to its exact pin.
const alertMachine = machines.find((m) => m.alert)!;

// Scattered catwalk/background indicator lights (human-requested, 2026-07-28,
// replacing an earlier roaming-spotlight version) — deliberately placed away
// from the 5 machines above and the drift callout's own corner (roughly
// left 40–54%, top 3–20%) so they read as background texture, not more
// things demanding attention next to the section's actual focal points.
// Durations are all different (and not simple multiples of each other) so
// no two lights ever visibly fall into sync. bootDelay staggers each light's
// one-time "power surging on" flicker the first time the section scrolls
// into view (human-requested, 2026-07-28) — deliberately NOT the same
// stagger schedule as the machines' own bootDelay above, so the whole
// scene's lights don't power on in two neat, separately-timed sequences —
// some of these flicker on before, between, and after the machine pins do,
// reading as one uneven facility waking up rather than two clean cascades.
const structureLights = [
  { left: 8, top: 18, duration: 5.2, delay: 0, bootDelay: 0.05 },
  { left: 92, top: 14, duration: 7.4, delay: 1.1, bootDelay: 0.5 },
  { left: 14, top: 62, duration: 6.1, delay: 2.6, bootDelay: 0.25 },
  { left: 90, top: 66, duration: 8.7, delay: 0.4, bootDelay: 0.7 },
  { left: 50, top: 78, duration: 9.6, delay: 3.3, bootDelay: 0.4 },
];
---

<section class="relative overflow-hidden border-t border-white/5 bg-navy-900 py-20" id="live-factory">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 md:px-8 lg:grid-cols-2">
    <!-- Copy -->
    <div data-reveal>
      <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl 2xl:text-6xl">
        <span class="text-offwhite">Live Factory.</span><br />
        <span class="text-teal-400">Real Predictions.</span>
      </h2>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted 2xl:max-w-xl 2xl:text-xl">
        The system can watch CNC milling machines around the clock. The moment
        tool wear, or process temperature starts to shift, it catches the change — often
        hours before that could cause a failure.
      </p>

      <!-- Ambient "system's actively working" status line — moved here from
           Hero.astro 2026-08-07 (human-requested relocation, larger) rather
           than embedded in the photo on the right: that photo is already
           busy (5 machine pins, the drift-detected callout, structure
           lights), so another moving element there risked competing for
           attention right next to CNC-05's own pin. This line's content —
           the general failure TAXONOMY the model watches for — is also a
           different scope than the photo's per-machine status pins, so it
           reads more naturally as supporting prose next to this section's
           own copy. Cycles all four of the dataset's real, non-random
           failure modes (RNF excluded everywhere in this codebase on
           purpose — see Hero.astro's markers for why). Pure CSS, no client
           JS: a chasing-dot spinner (8 dots, opacity staggered via
           animation-delay) and a 4-way cross-fading text cycle (four
           stacked spans sharing one grid-area, each on-screen for its own
           quarter of one shared loop via a negative animation-delay per
           span) — same techniques as Hero.astro's own markers, just sized
           up here since this section has the room for it. Purely
           decorative — doesn't convey anything the photo's own pins don't
           already — so aria-hidden rather than screen-reader noise for an
           endless loop with no unique content.

           Order is "Checking for" → spinner → failure mode (human-requested
           follow-up, 2026-08-07 — a Krug-style pass on the original "spinner
           → Checking for [mode] …" layout): the spinner is the "something's
           happening" cue, so it reads better sitting directly before the
           thing it's about to reveal instead of stranded at the front of
           the line with a trailing "…" doing the same job a second time at
           the far end. That trailing ellipsis is gone outright now that the
           spinner already covers "in progress" — keeping both was two
           different loading affordances for one idea, and the ellipsis sat
           past `.factory-status-cycle`'s own reserved min-width, reading as
           a stray period floating in dead space whenever the current word
           was shorter than the longest one ("Power Failure" vs. "Heat
           Dissipation Failure"). The failure-mode text itself is now a
           small pill (see `.factory-status-cycle span` below), not plain
           text — the one piece of this line that's actually changing gets
           its own visual chunk instead of blending into the static prefix. -->
      <p
        class="factory-status-line mt-5 flex items-center gap-2 text-base text-muted/80"
        aria-hidden="true"
      >
        <span>Checking for</span>
        <span class="factory-status-spinner">
          <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
        </span>
        <span class="factory-status-cycle">
          <span>Tool Wear Failure</span>
          <span>Power Failure</span>
          <span>Heat Dissipation Failure</span>
          <span>Overstrain Failure</span>
        </span>
      </p>
    </div>

    <!-- CNC floor photo -->
    <div class="factory-scene relative z-0" data-reveal style="transition-delay: 100ms">
      <!-- Ambient glow behind the photo — same slow breathing treatment as
           Hero's ambient light (global.css's ambient-breathe), so the two
           sections read as one consistent "the scene is alive" system
           rather than motion being a one-off on the homepage's first fold.
           z-0 above (not just relative) so this -z-10 layer stays contained
           behind the photo instead of escaping to paint behind unrelated
           page content — the exact bug Hero.astro's own z-0 comment flags. -->
      <div
        class="hero-glow pointer-events-none absolute -inset-8 -z-10"
        style="background: radial-gradient(50% 50% at 50% 40%, rgba(45,212,191,0.18), transparent 70%); animation-duration: 13s; filter: blur(20px);"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative aspect-[3/2] w-full overflow-hidden"
        style="mask-image: radial-gradient(ellipse 100% 100% at center, black 15%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 100% 100% at center, black 15%, transparent 100%);"
      >
        <img
          src={withBase('/images/live-factory/cnc-factory-floor.png')}
          alt="Isometric view of a CNC milling factory floor with five machines, glowing teal sensor lights, and a catwalk structure."
          class="factory-photo-parallax h-full w-full object-cover"
        />
      </div>

      <!-- Structure lights: small, dim indicator lights scattered around the
           catwalk/background — NOT the 5 named machines' own sensor pins
           below, a separate, more numerous layer of tiny ambient lights that
           blink occasionally and irregularly rather than breathing smoothly
           (human-requested, 2026-07-28, replacing an earlier roaming-
           spotlight version — this reads as "a real industrial facility,"
           since real indicator/catwalk lighting flickers unevenly, not in
           one uniform pulse). Each gets its own animation-duration/delay so
           they blink independently, never in sync with each other. -->
      {
        structureLights.map((l) => (
          <span
            class="structure-light"
            style={`left: ${l.left}%; top: ${l.top}%; animation-duration: ${l.duration}s, 1.3s; animation-delay: ${l.delay}s, ${l.bootDelay}s;`}
            aria-hidden="true"
          />
        ))
      }

      <!-- Sensor-light overlay: each pin sits on that machine's actual antenna/
           mount stub in the photo (coordinates read directly off
           cnc-factory-floor.png, not the old placeholder-SVG percentages).
           4 teal = healthy; CNC-01 (back-center) is red — its callout card
           below is anchored directly off this same machine's coordinates
           (alertMachine, computed above) so it always sits immediately next
           to its own pin at every viewport width, close enough that
           proximity alone says which machine it's about (no leader line
           needed: a long diagonal across the whole scene makes the viewer
           trace a line to find the answer, where sitting right next to it
           gives the answer for free — Krug/Redish, human review 2026-07-28).

           Each pin is now wrapped in a real <button> hotspot (human-requested,
           2026-07-28): hovering/focusing a healthy machine reveals its own
           "No drift detected" card, mirroring CNC-01's always-visible one but
           in green — proximity again does the disambiguation, since each
           card is anchored to its own hotspot, not a shared/roaming tooltip.
           CNC-01 keeps its callout always visible (the section's main "aha"
           moment shouldn't require a hover to see) but still gets the same
           hotspot wrapper so its glow gets the same hover-pause affordance
           as the other four.

           One healthy pin, CNC-05 (see `hint`/`hintDelay` in the `machines`
           comment above), also gets a one-time "Hover for details" bubble —
           same self-fading technique as Hero.astro's hero-marker-hint.
           Deliberately just the one, not two or all four (human-requested
           follow-up, 2026-08-07, eased down from an earlier two-pin pass):
           CNC-05 sits bottom-right of CNC-01's always-open drift card, so it
           nudges a visitor already looking at that card to notice the other
           dots are interactive too, without its own competing show. CNC-01's
           card is already always open, so it never gets one — there's
           nothing left for "hover for details" to invite there. -->
      {
        machines.map((m) => (
          <button
            type="button"
            class={`machine-hotspot ${m.alert ? 'machine-hotspot--alert' : ''}`}
            style={`left: ${m.left}%; top: ${m.top}%;`}
            aria-label={
              m.alert
                ? `${m.name}: drift detected, tool wear shift, 2.3 hours to failure`
                : `${m.name}: no drift detected, Safe `
            }
          >
            <span
              class={`sensor-pin ${m.alert ? 'sensor-pin--alert' : ''}`}
              style={`animation-delay: ${m.bootDelay}, ${m.delay};`}
              aria-hidden="true"
            />
            {m.hint && (
              <span class="machine-hover-hint" aria-hidden="true" style={`animation-delay: ${m.hintDelay};`}>
                Hover for details
              </span>
            )}
            {!m.alert && (
              <span class="machine-card machine-card--healthy">
                <span class="machine-card-header">
                  <span class="machine-card-status">
                    <span class="machine-card-dot" aria-hidden="true" />
                    No drift detected
                  </span>
                  <span class="machine-card-name">{m.name}</span>
                </span>
                <span class="machine-card-detail">{m.detail}</span>
              </span>
            )}
          </button>
        ))
      }

      <!-- Drift callout card (UI overlay, independent of the photo underneath).
           `left`/`bottom` come from an inline style keyed directly off
           alertMachine's own left/top (mobile-audit follow-up, 2026-08-07 —
           see the frontmatter comment on alertMachine). Horizontal centering
           on the pin's exact x is the STYLESHEET's `.drift-card { transform:
           translateX(-50%); }` below, deliberately NOT inlined alongside
           left/bottom — .tile-hover's own hover/active rules (global.css)
           set a plain `transform: translateY(...)`, and an inline transform
           always wins the cascade over any stylesheet rule regardless of
           :hover, which would freeze this card at rest and silently kill
           the hover lift rather than combine with it. Keeping `transform`
           itself out of the inline style is what lets the stylesheet's own
           :hover/:active overrides (see below) actually take effect. Same
           centering technique the hover-only `.machine-card` above already
           uses on its own pin, so the always-visible drift card now reads
           as the same kind of object instead of a bespoke one-off. (An
           earlier right-edge-anchored pass put the pin under the card's
           corner rather than its middle — human-reported same-day follow-
           up: "should be more centered above the red dot".) Bottom edge a
           fixed 14px above the pin's y, growing up from there — into the
           open padding above the photo, not down into the pin — so it stays
           correct with no separate mobile/tablet/desktop breakpoint
           overrides, at every viewport width. `max-width` below keeps this
           safe on a narrow phone even centered — CNC-01 sits at 61.5%,
           comfortably clear of both edges for this card's capped width.
           Always-visible by default (unchanged from before) rather than
           folded into the hover-only `.machine-card` treatment above, so a
           visitor who never hovers anything still sees the section's
           point. -->
      <a
        href={withBase('/product/#live-machines')}
        class="drift-card tile-hover"
        style={`left: ${alertMachine.left}%; bottom: calc(${100 - alertMachine.top}% + 14px);`}
      >
        <span class="machine-card-header">
          <span class="machine-card-status">
            <span class="machine-card-dot" aria-hidden="true"></span>
            Drift detected
          </span>
          <span class="machine-card-name">CNC-01</span>
        </span>
        <span class="machine-card-title">Tool Wear Shift</span>
        <span class="machine-card-detail">2.3 hrs to failure</span>
        <span class="machine-spark machine-spark--reveal">
          <svg viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
            <polyline points={sparkPoints('CNC-01')} />
          </svg>
          <span class="machine-spark-cta">See it in action →</span>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  // Touch devices have no :hover, and iOS Safari never moves real focus to a
  // tapped <button> (so :focus/:focus-visible don't fire either) — without
  // this, the healthy-machine cards would be unreachable on mobile. Tapping a
  // hotspot toggles .is-tapped (which the CSS below treats like hover/focus);
  // tapping it again, tapping a different hotspot, or tapping anywhere else
  // closes it. Bound to astro:page-load, not top-level: this section lives
  // inside <main>, which isn't transition:persist-ed, so a fresh <script>
  // arrives every time a visitor navigates back to "/" via a client-side
  // transition, not just on the first hard load.
  document.addEventListener('astro:page-load', () => {
    const hotspots = document.querySelectorAll<HTMLButtonElement>('.machine-hotspot');

    hotspots.forEach((hotspot) => {
      hotspot.addEventListener('click', (event) => {
        event.stopPropagation();
        const wasOpen = hotspot.classList.contains('is-tapped');
        hotspots.forEach((h) => h.classList.remove('is-tapped'));
        if (!wasOpen) hotspot.classList.add('is-tapped');
      });
    });

    document.addEventListener('click', () => {
      hotspots.forEach((h) => h.classList.remove('is-tapped'));
    });
  });
</script>

<style>
  /* Invisible ~2rem hit target centered on the pin's coordinate — the visible
     dot is only 0.65rem, well under a real tap/click target size, so the
     button is sized for touch/click while the dot inside stays visually
     small. Reset to look like nothing (no button chrome) until its contents
     are styled below. */
  .machine-hotspot {
    position: absolute;
    z-index: 20;
    transform: translate(-50%, -50%);
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* .machine-card's z-index:40 only wins *inside* this button's own stacking
     context — its permanent `transform` above (for centering) creates one,
     per spec. From outside, the whole button is just one auto-z-index box,
     so the always-visible red drift card (later in the DOM, same level)
     paints over it regardless of the popup's z-index. Raising the button's
     own z-index — only while its card is actually showing — is what lets
     the popup rise above the red card where they overlap
     (human-requested, 2026-07-28). */
  .machine-hotspot:hover,
  .machine-hotspot:focus-visible,
  .machine-hotspot:focus {
    z-index: 50;
  }

  /* Reuses global.css's pulse-pin keyframe. Per-pin animation-delay is
     negative so each starts mid-cycle at a different phase — five sensors
     pulsing in lockstep would read as one fake blinking light, not five
     independent machines. Positioned centered *within* the hotspot button
     (left/top 50% + its own translate), the same technique the button uses
     to center on its coordinate in the photo — keeps this rule reusable
     regardless of what it's nested inside. */
  .sensor-pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 9999px;
    transform: translate(-50%, -50%);
    background-color: var(--color-teal-400);
    box-shadow: 0 0 10px 3px color-mix(in srgb, var(--color-teal-400) 70%, transparent);
    /* Two animations, always both listed (never redeclared later) so the
       inline animation-delay="{bootDelay}, {delay}" above always matches up
       positionally — pulse-pin is the continuous ambient breathing (as
       before); boot-flash is the one-time "power-up" this pin plays the
       first time the section scrolls into view. boot-flash starts *paused*
       — frozen on its neutral 0% frame, so it visibly does nothing — until
       .factory-scene.is-visible below flips it to running. Without this
       gate it would just play immediately on page load, off-screen, and be
       long over by the time anyone actually scrolls down to see it. */
    animation: pulse-pin 3.6s var(--ease-ios-in-out) infinite, boot-flash 0.7s var(--ease-ios) both;
    animation-play-state: running, paused;
  }
  .factory-scene.is-visible .sensor-pin {
    animation-play-state: running, running;
  }
  @keyframes boot-flash {
    0% { filter: brightness(1); }
    40% { filter: brightness(2.2); }
    100% { filter: brightness(1); }
  }
  .sensor-pin--alert {
    background-color: var(--color-alert-400);
    box-shadow: 0 0 12px 4px color-mix(in srgb, var(--color-alert-400) 75%, transparent);
    animation-duration: 2.4s;
  }
  /* Hovering/focusing a hotspot settles its own light rather than leaving it
     pulsing right next to the card that just appeared — a small "focused"
     cue, and one less thing competing for attention with the card's text. */
  .machine-hotspot:hover .sensor-pin,
  .machine-hotspot:focus-visible .sensor-pin,
  .machine-hotspot.is-tapped .sensor-pin {
    animation-play-state: paused;
    transform: translate(-50%, -50%) scale(1.2);
  }

  /* Per-machine hover/focus card — same proven hover+focus popover technique
     as InfoTip.astro's glossary popover (opacity/transform/visibility, not
     display, so it can transition), sized and typeset to match CNC-01's
     always-visible callout below so the two read as one design system. Not
     gated behind (hover: hover): unlike the purely decorative .tile-hover
     lift used elsewhere, this card *is* the requested feature, so it also
     has to work via tap-to-focus on touch devices, not just mouse hover. */
  /* Shared type/padding scale for BOTH card kinds, so the always-visible red
     drift card and the hover-only green cards read as one system rather than
     two lookalikes that drift apart. Compact below sm — at phone widths the
     old fixed widths were too narrow for the header to fit on one line, which
     is what made "NO DRIFT / DETECTED" and "CNC-\n01" wrap into the squashed
     proportions this replaces. */
  .machine-card,
  .drift-card {
    --fc-pad: 0.55rem;
    --fc-label: 0.55rem;
    --fc-name: 0.5rem;
    --fc-detail: 0.65rem;
    --fc-title: 0.78rem;
  }
  @media (min-width: 640px) {
    .machine-card,
    .drift-card {
      --fc-pad: 0.75rem;
      --fc-label: 0.65rem;
      --fc-name: 0.6rem;
      --fc-detail: 0.75rem;
      --fc-title: 0.875rem;
    }
  }

  /* Always-visible drift callout. Position (left/bottom) comes from the
     inline style in the markup above, derived from alertMachine's own
     left/top — a single formula that holds at every breakpoint, so there's
     no separate mobile/tablet/desktop override to keep in sync. max-width
     is a safety net, same reasoning as InfoTip.astro's own popover: without
     it, a very narrow viewport could still push this max-content box past
     the opposite edge. */
  .drift-card {
    position: absolute;
    display: block;
    text-decoration: none;
    z-index: 10;
    width: max-content;
    max-width: min(80vw, 15rem);
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-alert-400) 50%, transparent);
    background: color-mix(in srgb, var(--color-navy-950) 90%, transparent);
    backdrop-filter: blur(4px);
    padding: var(--fc-pad);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
  }
  /* The inline `transform: translateX(-50%)` centers the card on the pin
     (see the markup comment above). .tile-hover's own hover/active rules
     (global.css) set a PLAIN `transform: translateY(...)` on this same
     element, which would replace rather than combine with that centering —
     the exact transform-composition bug already fixed once on .mlops-node
     and .sensor-pin (see MlopsSystem.astro's .mlops-node comment for the
     full mechanics). Re-authoring the resting/hover/active states here,
     each keeping translateX(-50%) as the first function, is the same fix:
     a component-scoped class selector already outranks global.css's plain
     .tile-hover class regardless of source order (Astro adds a scoping
     attribute to every selector in this block), so these three rules win
     without needing !important. */
  .drift-card {
    transform: translateX(-50%);
  }
  @media (hover: hover) and (pointer: fine) {
    .drift-card:hover {
      transform: translateX(-50%) translateY(-4px);
    }
  }
  .drift-card:active {
    transform: translateX(-50%) translateY(-1px) scale(0.99);
  }
  .drift-card .machine-card-status,
  .drift-card .machine-card-dot {
    color: var(--color-alert-400);
    background-color: transparent;
  }
  .drift-card .machine-card-dot {
    background-color: var(--color-alert-400);
  }
  .machine-card-title {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--fc-title);
    font-weight: 600;
    color: var(--color-offwhite);
  }

  /* One-time "Hover for details" discovery bubble, on two of the four
     healthy pins only (see the `hint`/`hintDelay` comment on `machines` in
     the frontmatter, and the markup comment above) — same visual recipe and
     self-fading `animation-delay` + `both` fill-mode technique as
     Hero.astro's .hero-marker-hint, duplicated rather than shared for the
     same reason the spinner/cycle CSS above already is (Astro scopes
     <style> per component). Anchored identically to .machine-card just
     below (bottom: calc(100% + 10px); left: 50%) so it sits exactly where
     the real card will appear, and gets out of the way immediately once
     that card opens (see the :hover/:focus/.is-tapped override further
     down) rather than letting its own animation finish underneath it.
     Gated behind .factory-scene.is-visible — same paused/running technique
     as .sensor-pin's boot-flash — so each one's `hintDelay` only starts
     counting once the section has actually scrolled into view. */
  .machine-hover-hint {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    z-index: 15;
    transform: translate(-50%, 0);
    white-space: nowrap;
    border-radius: 0.5rem;
    border: 1px solid rgba(45, 212, 191, 0.35);
    background: color-mix(in srgb, var(--color-navy-800) 95%, transparent);
    color: var(--color-teal-300);
    padding: 0.3rem 0.6rem;
    font-size: 0.68rem;
    font-weight: 600;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    pointer-events: none;
    opacity: 0;
    animation: machine-hover-hint-fade 5s var(--ease-ios-in-out) both;
    animation-play-state: paused;
  }
  .factory-scene.is-visible .machine-hover-hint {
    animation-play-state: running;
  }
  .machine-hover-hint::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    margin-left: -4px;
    transform: rotate(45deg);
    background: inherit;
    border: inherit;
    border-top: none;
    border-left: none;
  }
  @keyframes machine-hover-hint-fade {
    0%, 8% { opacity: 0; transform: translate(-50%, 4px); }
    18% { opacity: 1; transform: translate(-50%, 0); }
    70% { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; transform: translate(-50%, 0); }
  }
  /* Hovering/focusing/tapping means the visitor already found it — cut the
     hint immediately rather than letting it run out its own animation
     underneath the real .machine-card that's about to appear on top of it. */
  .machine-hotspot:hover .machine-hover-hint,
  .machine-hotspot:focus-visible .machine-hover-hint,
  .machine-hotspot:focus .machine-hover-hint,
  .machine-hotspot.is-tapped .machine-hover-hint {
    animation: none;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-ios);
  }

  .machine-card {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    z-index: 40;
    width: max-content;
    transform: translate(-50%, 4px) scale(0.96);
    transform-origin: bottom center;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-success-400) 50%, transparent);
    background: color-mix(in srgb, var(--color-navy-950) 90%, transparent);
    backdrop-filter: blur(4px);
    padding: var(--fc-pad);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-ios), transform var(--dur-base) var(--ease-ios),
      visibility 0s linear var(--dur-base);
  }
  /* .is-tapped: touch equivalent of :hover/:focus-visible, toggled by the script
     below. iOS Safari doesn't move real DOM focus to a tapped <button> (a
     long-standing WebKit quirk), so :focus-visible/:focus alone never fire on
     mobile — without this, the healthy-machine cards would be permanently
     unreachable for touch users. */
  .machine-hotspot:hover .machine-card,
  .machine-hotspot:focus-visible .machine-card,
  .machine-hotspot:focus .machine-card,
  .machine-hotspot.is-tapped .machine-card {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0) scale(1);
    /* --ease-spring only on the way in — a slight overshoot reads as a small
       "discovery" delight when the card appears. The hide direction (base
       .machine-card rule above) keeps --ease-ios: overshooting on the way
       OUT would look like a glitch, not a pop. */
    transition: opacity var(--dur-fast) var(--ease-ios), transform var(--dur-base) var(--ease-spring), visibility 0s;
  }
  /* Header row: status on the left (the point of the card), machine name
     small/muted in the upper-right corner — a label for context, not
     competing with the status for attention (human-requested, 2026-07-28). */
  /* nowrap on both halves + width:max-content on the cards is what keeps the
     status label and the machine name on a single line at every width. */
  .machine-card-header {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .machine-card-status {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    font-size: var(--fc-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-success-400);
  }
  .machine-card-dot {
    display: inline-block;
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background-color: var(--color-success-400);
  }
  .machine-card-name {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: var(--fc-name);
    font-weight: 500;
    color: var(--color-muted);
    opacity: 0.7;
  }
  .machine-card-detail {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--fc-detail);
    color: var(--color-muted);
  }

  /* Mini version of /product's Live Machines trace — the same recorded run,
     drawn at build time (see sparkPoints() in the frontmatter). Purely an
     <svg polyline>, so it costs no client JS and nothing is computed live.
     Drift card only (human review, 2026-08-05): on the four healthy cards it
     was decoration on a card whose whole message is "nothing to see here". */
  .machine-spark {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-alert-400);
  }
  .machine-spark svg {
    display: block;
    width: 100%;
    height: 1.3rem;
  }
  .machine-spark polyline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    /* preserveAspectRatio="none" stretches the viewBox non-uniformly, which
       would smear the stroke thickness with it without this. */
    vector-effect: non-scaling-stroke;
  }
  /* "See it in action" is the site's settled look-verb CTA for /product
     (ARCHITECTURE.md §5) — reused verbatim rather than inventing a card-sized
     synonym, since the two-verb system is explicitly a Danger Zone. */
  .machine-spark-cta {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-teal-300);
  }

  /* The drift card is always visible, so its sparkline stays collapsed until
     CNC-01 is hovered/focused/tapped — otherwise the extra height would push
     the card back down onto that machine's own pin, the overlap this pass
     just fixed. :has() lets the sibling hotspot drive it with no extra JS;
     browsers without :has() simply never expand it, which is a clean no-op. */
  .machine-spark--reveal {
    max-height: 0;
    margin-top: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height var(--dur-base) var(--ease-ios),
      margin-top var(--dur-base) var(--ease-ios),
      opacity var(--dur-fast) var(--ease-ios);
  }
  .drift-card:hover .machine-spark--reveal,
  .drift-card:focus-visible .machine-spark--reveal,
  .factory-scene:has(.machine-hotspot--alert:hover) .machine-spark--reveal,
  .factory-scene:has(.machine-hotspot--alert:focus-visible) .machine-spark--reveal,
  .factory-scene:has(.machine-hotspot--alert.is-tapped) .machine-spark--reveal {
    max-height: 3.5rem;
    margin-top: 0.4rem;
    opacity: 1;
  }

  /* Structure lights (see the markup comment above): small, dim indicator
     dots, each with its own animation-duration/delay set inline so they
     never blink in sync. The keyframe stays dim for nearly the whole cycle
     with one sharp spike near the end — an occasional flicker, not a smooth
     breathing pulse (that's what the machines' own .sensor-pin already
     does, and this needs to read as a visually distinct, lesser layer, not
     five more sensor pins). Positioned with left/top directly (not
     transform), same reasoning as the roaming spotlight this replaced: an
     animated `transform` here would have to repeat this element's static
     centering translate in every keyframe stop or lose it outright (the
     transform-composition gotcha) — animating left/top instead sidesteps
     that category of bug entirely rather than working around it. */
  .structure-light {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    transform: translate(-50%, -50%);
    background-color: #eafffb;
    box-shadow: 0 0 4px 1px rgba(234, 255, 251, 0.8);
    opacity: 0.15;
    /* structure-blink (unchanged, still the permanent occasional-flicker
       loop) plus boot-flicker, a one-time "power surging on unevenly" burst
       layered on top the first time the section scrolls into view — the
       same paused/running gating technique as .sensor-pin's boot-flash
       above. boot-flicker's own last keyframe stop matches structure-
       blink's idle value (0.15) and it carries NO fill-mode, so the moment
       it finishes it stops affecting opacity at all and hands control back
       to structure-blink cleanly — a *filled* one-time animation would
       otherwise permanently win every future frame for this property (same-
       property animations composite "last listed wins," and a finished-
       but-filled animation still counts as "listed" forever after). */
    animation-name: structure-blink, structure-boot-flicker;
    animation-timing-function: ease-out, linear;
    animation-iteration-count: infinite, 1;
    animation-play-state: running, paused;
  }
  .factory-scene.is-visible .structure-light {
    animation-play-state: running, running;
  }
  @keyframes structure-blink {
    0%, 90%, 100% { opacity: 0.15; }
    93% { opacity: 1; }
    96% { opacity: 0.15; }
  }
  @keyframes structure-boot-flicker {
    0%   { opacity: 0.15; }
    8%   { opacity: 1; }
    14%  { opacity: 0.15; }
    22%  { opacity: 1; }
    28%  { opacity: 0.15; }
    40%  { opacity: 0.9; }
    46%  { opacity: 0.15; }
    70%  { opacity: 1; }
    100% { opacity: 0.15; }
  }

  /* Scroll-driven parallax on the photo itself: drifts slightly slower than
     the surrounding content as the section passes through the viewport,
     the classic "background sits further away" depth cue — chosen over
     cursor-parallax specifically because it needs no hover and works on
     touch (human-requested, 2026-07-28). Wrapped in @supports so browsers
     without scroll-driven animations get the plain, unscaled, un-shifted
     image exactly as before — not scoping this would otherwise show every
     unsupporting browser permanently frozen at this animation's un-timed
     *end* keyframe (translateY(2.5%)), a real regression, not a graceful
     no-op. The 1.06 scale supplies the overscan the ±2.5% vertical drift
     needs so the shift never uncovers empty space at the image's own edges. */
  @supports (animation-timeline: view()) {
    .factory-photo-parallax {
      animation: factory-parallax linear both;
      animation-timeline: view();
      animation-range: cover 0% cover 100%;
    }
    @keyframes factory-parallax {
      from { transform: scale(1.06) translateY(-2.5%); }
      to { transform: scale(1.06) translateY(2.5%); }
    }
  }

  /* Chasing-dot spinner + cross-fading text cycle for the "Checking for…"
     status line above (see its own markup comment for the full rationale).
     Same technique as Hero.astro's .hero-marker-card-spinner/.hero-status-
     cycle, duplicated rather than shared — Astro scopes <style> per
     component, so there's no import path for CSS between them — and sized
     up here to match this section's text-base line height instead of
     Hero's smaller text. */
  .factory-status-spinner {
    position: relative;
    display: inline-block;
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }
  /* History: started as a 1s chase, got slowed to 1.5s, then simplified to a
     flat static ring entirely (human-requested, 2026-08-07 — even the 1.5s
     chase still competed for attention). Restored again the same day
     (human-requested follow-up) — a fully static glyph read as broken/
     stalled rather than calm, not the intended effect. Two slower/subtler
     attempts in between (3s/0.3–0.65, then 2s/0.2–0.85) both undershot —
     settled back on the ORIGINAL 1s/0.15–1 chase, same as before any of
     this tuning started. */
  .factory-status-spinner i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.14rem;
    height: 0.14rem;
    margin: -0.07rem 0 0 -0.07rem;
    border-radius: 9999px;
    background: var(--color-teal-400);
    animation: factory-spinner-fade 1s linear infinite;
  }
  .factory-status-spinner i:nth-child(1) { transform: rotate(0deg) translateY(-0.43rem); animation-delay: -0.875s; }
  .factory-status-spinner i:nth-child(2) { transform: rotate(45deg) translateY(-0.43rem); animation-delay: -0.75s; }
  .factory-status-spinner i:nth-child(3) { transform: rotate(90deg) translateY(-0.43rem); animation-delay: -0.625s; }
  .factory-status-spinner i:nth-child(4) { transform: rotate(135deg) translateY(-0.43rem); animation-delay: -0.5s; }
  .factory-status-spinner i:nth-child(5) { transform: rotate(180deg) translateY(-0.43rem); animation-delay: -0.375s; }
  .factory-status-spinner i:nth-child(6) { transform: rotate(225deg) translateY(-0.43rem); animation-delay: -0.25s; }
  .factory-status-spinner i:nth-child(7) { transform: rotate(270deg) translateY(-0.43rem); animation-delay: -0.125s; }
  .factory-status-spinner i:nth-child(8) { transform: rotate(315deg) translateY(-0.43rem); animation-delay: 0s; }
  @keyframes factory-spinner-fade {
    0%, 100% { opacity: 0.15; }
    12.5% { opacity: 1; }
  }

  /* Four stacked spans sharing one grid-area so they cross-fade in place
     without needing position:absolute (which would strip the real baseline
     these need to sit level with "Checking for" and the spinner beside them
     — the exact bug already fixed once on Hero.astro's own copy of this
     pattern). min-width holds the longest label's width so the line doesn't
     reflow as the text changes — grid's own auto track-sizing already grows
     past it to fit "Heat Dissipation Failure" plus the pill padding below,
     this is just a floor for the shorter words. */
  .factory-status-cycle {
    display: inline-grid;
    min-width: 13.5rem;
  }
  /* Pill, not plain text (human-requested follow-up, 2026-08-07 — see the
     markup comment above) — the one word in this line that's actually
     changing gets its own visual chunk instead of reading as more of the
     same static sentence. Teal/informational, matching Hero.astro's own
     failure-mode markers ("here's what the model watches for," not an
     alert, so no alert-400 red). `justify-self: start` keeps each pill
     hugging its own text width rather than stretching to fill the grid
     track's full reserved min-width (a plain background/border on a
     stretched item would recreate the exact "floating in dead space" bug
     this pass fixes) — the track itself still reserves the wider space
     behind the scenes, so the line's overall width stays stable regardless
     of which word is showing. */
  .factory-status-cycle span {
    grid-area: 1 / 1;
    justify-self: start;
    white-space: nowrap;
    opacity: 0;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-teal-400) 35%, transparent);
    background: color-mix(in srgb, var(--color-teal-400) 12%, transparent);
    padding: 0.2rem 0.75rem;
    font-weight: 600;
    color: var(--color-teal-300);
    /* 12s → 16s loop (same follow-up as the spinner above) — each word now
       lingers longer between cross-fades, reading as a slower, calmer
       rotation instead of a busy flicker next to the machine hotspots. */
    animation: factory-status-cycle-fade 16s ease-in-out infinite;
  }
  /* Delays stay each span's own quarter of the (now 16s) loop — 0/4/8/12s,
     scaled up from 0/3/6/9s in step with the duration change above so the
     four words still hand off cleanly with no overlap or gap. */
  .factory-status-cycle span:nth-child(1) { animation-delay: 0s; }
  .factory-status-cycle span:nth-child(2) { animation-delay: -4s; }
  .factory-status-cycle span:nth-child(3) { animation-delay: -8s; }
  .factory-status-cycle span:nth-child(4) { animation-delay: -12s; }
  @keyframes factory-status-cycle-fade {
    0%, 1.5% { opacity: 0; }
    4.5%, 21% { opacity: 1; }
    24%, 100% { opacity: 0; }
  }

  /* Simplified back down from a timed boot/reveal/settle keyframe
     (human-requested, 2026-08-07 — "leave it on always, don't need to
     reveal it only after 3 sec"): rather than staying hidden through the
     photo's boot-up, fading in, holding, then dimming, the line now just
     renders at this same quiet opacity from the start. Still "alive"
     underneath (the chase/cycle keep running at this low opacity), just
     without the multi-second choreography — simpler to reason about and one
     less thing timed against the photo's own boot-flash/boot-flicker. */
  .factory-status-line {
    opacity: 0.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .factory-status-line {
      display: none;
    }
    /* Same reasoning as Hero.astro's own .hero-marker-hint override — no
       good reduced-motion middle ground for a bubble whose entire job is to
       fade in and out, so it's simply skipped rather than shown statically
       forever. */
    .machine-hover-hint {
      animation: none;
      opacity: 0;
    }
  }
</style>
