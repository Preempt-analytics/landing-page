---
// Small reusable "what is this?" info icon — a CSS-only hover/focus popover
// (no client JS, per the Second Law) giving a short, plain-language definition
// of a jargon term inline in copy. Distinct from BeginnersTrail.astro: this is
// a one-line glossary entry, that's a guided walkthrough for bigger concepts.
interface Props {
  label?: string;
  // Which edge the popover opens from, so it doesn't get pushed off-screen
  // when the button sits near the left/right edge of a row of tiles (e.g.
  // HowItWorks' 6-card loop). 'start' (default) is the original left:0
  // behavior; the rest are additive, existing callers are unaffected.
  // 'start-lg'/'end-lg' anchor to that edge only from the lg breakpoint up
  // (where HowItWorks' cards form one row and Collect/Business Impact sit at
  // its true left/right edge) and fall back to centered below lg, where the
  // cards stack into a single centered column instead — anchoring to an edge
  // there pushed the popover off the opposite side of a narrow viewport,
  // since the button is no longer at the row's actual edge.
  position?: 'start' | 'center' | 'end' | 'start-lg' | 'end-lg';
  // Which glyph the trigger button shows. 'info' (default) is the circled-i
  // used for glossary/explainer tips everywhere else. 'eco' is a leaf,
  // reserved for Benefits.astro's environmental-benefit asides — same
  // popover behavior, just a visually distinct affordance so a reader can
  // tell at a glance "this one's about the planet, not a definition."
  icon?: 'info' | 'eco';
}
const { label = 'What is this?', position = 'start', icon = 'info' } = Astro.props;
---

<span class="info-tip" data-pos={position}>
  <button type="button" class="info-tip-btn" aria-label={label}>
    {icon === 'eco' ? (
      <svg class="eco-leaf" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 4C10 4 4 10 4 19c9 0 15-6 15-15z" />
        <path class="eco-leaf-vein" d="M19 4 6 17" pathLength="1" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="8" r="1.15" fill="currentColor" stroke="none" />
        <path d="M12 11.5v5" />
      </svg>
    )}
  </button>
  <span class="info-tip-pop" role="tooltip">
    {icon === 'eco' && (
      <svg class="benefit-sprout" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path class="sprout-stem" d="M12 21V9" pathLength="1" />
        <path class="sprout-leaf-r" d="M12 9Q17 8 17 3Q13 4 12 9Z" pathLength="1" />
        <path class="sprout-leaf-l" d="M12 13Q7 12 7 7Q11 8 12 13Z" pathLength="1" />
      </svg>
    )}
    <slot />
  </span>
</span>

<script>
  // Mobile-audit fix (2026-08-07): this popover is revealed purely via CSS
  // `:hover`/`:focus-within` (Second Law — no client JS for the reveal
  // itself). That's fine for a mouse, but touch devices have no `:hover`,
  // and — as Hero.astro's and LiveFactory.astro's own hover-card hotspots
  // already document from hitting this exact issue — iOS Safari doesn't
  // reliably move real DOM focus to a tapped <button> either. Without this,
  // every info-tip on the site (15+ instances) would be unopenable on an
  // iPhone: tapping the (i) would just do nothing.
  //
  // Rather than repeat those components' `.is-tapped` class + duplicated
  // CSS-selector approach (this component's popover has a lot more
  // hover/focus-within selectors to fork: position variants, the eco-leaf,
  // the sprout — see the style block below), this calls `.focus()` on the
  // button directly. An explicit JS `.focus()` call works on iOS Safari even
  // though an implicit tap-to-focus doesn't — so every existing
  // `:focus-within` rule below starts working correctly as-is, with zero
  // CSS changes. A document-level listener blurs whatever's focused on any
  // OTHER tap, so an open popover doesn't linger once you've tapped away
  // from it (`stopPropagation` on the button's own handler keeps the tap
  // that OPENS it from immediately blurring it via that same listener).
  //
  // One script, defined once in this component file — Astro dedupes a
  // component's own inline module script across multiple usages of that
  // component on the same page, so this still runs exactly once per page
  // regardless of how many <InfoTip> instances it renders.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('.info-tip-btn').forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        btn.focus();
      });
    });
    document.addEventListener('click', () => {
      (document.activeElement as HTMLElement | null)?.blur?.();
    });
  });
</script>

<style>
  .info-tip {
    position: relative;
    display: inline-flex;
    vertical-align: middle;
    margin: 0 0.15em;
  }
  /* Baked in here (not left to each consumer) so every usage is protected by
     default: a later sibling in the same stacking context — a following list
     item, card, etc. — can otherwise paint over an open popover even though
     the popover itself has z-index:20, because that z-index is only ever
     ranked *within* the nearest ancestor stacking context, and plenty of
     ordinary layout (flex items, an ancestor with a settled `transform`/
     `filter` from an entrance animation, etc.) can put the popover and its
     "later" sibling in the same context without the popover's own z-index
     actually winning. Bumping z-index on the trigger itself while open moves
     the whole open .info-tip — button, popover, everything — into its own
     higher-ranked context, which reliably wins regardless of DOM order.
     Confirmed necessary in practice: MlopsSystem's Powered By list showed
     exactly this — GitHub Actions' open popover rendering under DVC's row. */
  .info-tip:hover,
  .info-tip:focus-within {
    z-index: 20;
  }
  .info-tip-btn {
    position: relative; /* anchors the invisible expanded tap target below */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    padding: 0;
    border: none;
    border-radius: 9999px;
    background: none;
    color: var(--color-muted);
    cursor: help;
    opacity: 0.75;
    transition: color var(--dur-fast) var(--ease-ios-in-out), opacity var(--dur-fast) var(--ease-ios-in-out);
  }
  /* Mobile-audit fix (2026-08-07): the drawn circle is a deliberately small
     1.15rem (18.4px) glyph so it reads as an inline aside, not a competing
     button — shrinking the actual TAP target to match it, though, is well
     under the ~44px touch target every mobile guideline recommends (this
     repeats ~20 times across the site, so it's worth fixing once here
     rather than per-caller). A transparent pseudo-element enlarges only the
     hit area, centered on the visible glyph, without changing the button's
     own layout box — nothing around it has to shift. */
  .info-tip-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
  }
  .info-tip:hover .info-tip-btn,
  .info-tip:focus-visible .info-tip-btn {
    color: var(--color-teal-300);
    opacity: 1;
  }

  /* 'eco' icon only: a subtle Apple-style "growing" flourish, not a static
     glyph. The vein is undrawn at rest (a plain leaf silhouette reads fine
     on its own, so this never looks broken/incomplete before any hover) and
     draws in on hover/focus like a stem shooting up, paired with a gentle
     spring-eased grow-in-size from the leaf's own stem point. pathLength="1"
     on the vein keeps stroke-dasharray/-dashoffset in simple 0..1 units
     regardless of the path's real length — same trick as the MLOps claim
     strip's self-drawing checkmarks (MlopsSystem.astro). --ease-spring is
     the same "discovery moment" easing reserved for exactly this kind of
     accent elsewhere (see global.css's token comment). Transform-origin is
     79% 17% — the leaf's tip/stem point (19,4) in the 24-unit viewBox,
     expressed as a percentage of the rendered box since `transform-origin`
     on the <svg> element itself operates in its own CSS pixel box, not the
     viewBox's internal coordinate space.
     Benefits.astro adds a second trigger off the *card's* own hover (not
     just this button's) so the leaf reacts to hovering the tile at large,
     not only the tiny icon — this rule alone only covers hovering/focusing
     the icon directly, which still matters for keyboard/other consumers. */
  .eco-leaf {
    transform-origin: 79% 17%;
    transition: transform var(--dur-base) var(--ease-spring);
  }
  .eco-leaf-vein {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset var(--dur-slow) var(--ease-ios) 80ms;
  }
  .info-tip:hover .eco-leaf,
  .info-tip:focus-within .eco-leaf {
    transform: scale(1.15);
  }
  .info-tip:hover .eco-leaf-vein,
  .info-tip:focus-within .eco-leaf-vein {
    stroke-dashoffset: 0;
  }
  .info-tip-pop {
    position: absolute;
    left: 0;
    top: calc(100% + 8px);
    z-index: 20;
    width: 17rem;
    max-width: calc(100vw - 3rem);
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--color-navy-800);
    color: var(--color-offwhite);
    padding: 0.65rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(2px) scale(0.97);
    transform-origin: top left;
    transition: opacity var(--dur-fast) var(--ease-ios), transform var(--dur-base) var(--ease-ios), visibility 0s linear var(--dur-base);
  }
  .info-tip:hover .info-tip-pop,
  .info-tip:focus-within .info-tip-pop {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    transition: opacity var(--dur-fast) var(--ease-ios), transform var(--dur-base) var(--ease-ios), visibility 0s;
  }

  /* The "gently growing" plant, living inside the eco popover itself (a
     "hover card" in the UI sense — human-requested, 2026-07-31) rather than
     as a decoration on the outer benefit tile: the stem draws first, then
     each leaf unfurls a beat behind it, using the same pathLength="1" self-
     drawing trick as the eco-leaf button's own vein and the MLOps claim
     strip's checkmarks (MlopsSystem.astro). Same :hover/:focus-within
     conditions that reveal the popover drive this too, so the plant keeps
     growing for a few hundred ms after the popover itself has finished
     fading/scaling in — "something's still quietly happening in here"
     rather than everything landing in one instant. Transitions, not a one-
     shot @keyframes animation, so closing the popover lets it recede
     symmetrically instead of restarting from scratch next time. */
  .benefit-sprout {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    margin-bottom: 0.4rem;
    color: var(--color-teal-300);
  }
  .benefit-sprout path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset var(--dur-slow) var(--ease-ios);
  }
  .benefit-sprout .sprout-leaf-r {
    transition-delay: 150ms;
  }
  .benefit-sprout .sprout-leaf-l {
    transition-delay: 300ms;
  }
  .info-tip:hover .benefit-sprout path,
  .info-tip:focus-within .benefit-sprout path {
    stroke-dashoffset: 0;
  }

  /* 'center'/'end' and the lg-only edge anchors below: same fade/scale as the
     default 'start' anchor above, just anchored from a different edge so the
     popover opens toward open space instead of off the edge of the viewport.
     Each state pairs a matching transform function list (translateX first,
     then translateY/scale) at rest and on hover/focus — mismatched function
     lists between states forces the browser into matrix interpolation instead
     of per-function, which is what produced the "diagonal drift" bug already
     fixed once on .mlops-node (see MlopsSystem.astro's .mlops-node comment)
     and on .sensor-pin. */
  .info-tip[data-pos='center'] .info-tip-pop,
  .info-tip[data-pos='start-lg'] .info-tip-pop,
  .info-tip[data-pos='end-lg'] .info-tip-pop {
    left: 50%;
    transform: translateX(-50%) translateY(2px) scale(0.97);
    transform-origin: top center;
  }
  .info-tip[data-pos='center']:hover .info-tip-pop,
  .info-tip[data-pos='center']:focus-within .info-tip-pop,
  .info-tip[data-pos='start-lg']:hover .info-tip-pop,
  .info-tip[data-pos='start-lg']:focus-within .info-tip-pop,
  .info-tip[data-pos='end-lg']:hover .info-tip-pop,
  .info-tip[data-pos='end-lg']:focus-within .info-tip-pop {
    transform: translateX(-50%) translateY(0) scale(1);
  }
  .info-tip[data-pos='end'] .info-tip-pop {
    left: auto;
    right: 0;
    transform-origin: top right;
  }

  /* Mobile-audit fix (2026-08-07): the default ('start') anchor above pins
     the popover's LEFT edge to the TRIGGER's own position, not the
     viewport's — fine on desktop, where there's slack on both sides, but on
     a narrow phone a trigger that isn't near the left edge (e.g. a stat
     tile's "Failure Recall ⓘ") pushes this 17rem-wide popover past the
     right edge; the existing `max-width: calc(100vw - 3rem)` above only caps
     its OWN size, it can't fix a start position that's already off toward
     the edge. Confirmed empirically: the homepage's default info-tip
     measured 100px past the right edge of a 390px viewport before this fix.
     Below `sm`, fall back to the same centered-under-trigger behavior
     `data-pos="center"` already uses — roughly equal breathing room on both
     sides regardless of where the trigger sits. Deliberately does NOT touch
     `data-pos="end"`: that variant is chosen precisely for triggers already
     pinned near the right edge (e.g. Benefits.astro's corner eco-tip), and
     its `right: 0` anchor already keeps the popover on-screen by opening
     leftward — forcing it to center too was tried and made it overflow the
     right edge instead (its own earlier bug, caught by re-running this same
     audit after the first fix). 'start-lg'/'end-lg' don't need a rule here
     either: they already fall back to the centered `data-pos="center"`
     behavior below `lg` via the grouped selector above, unrelated to `sm`. */
  @media (max-width: 639px) {
    .info-tip-pop {
      left: 50%;
      right: auto;
      transform: translateX(-50%) translateY(2px) scale(0.97);
      transform-origin: top center;
    }
    .info-tip:hover .info-tip-pop,
    .info-tip:focus-within .info-tip-pop {
      transform: translateX(-50%) translateY(0) scale(1);
    }
  }

  /* From lg up, HowItWorks' cards form one row — Collect and Business Impact
     sit at its true left/right edge, so switch them to a plain edge anchor
     (matching 'start'/'end' above) instead of the centered fallback used
     below lg. */
  @media (min-width: 1024px) {
    .info-tip[data-pos='start-lg'] .info-tip-pop {
      left: 0;
      transform: translateY(2px) scale(0.97);
      transform-origin: top left;
    }
    .info-tip[data-pos='start-lg']:hover .info-tip-pop,
    .info-tip[data-pos='start-lg']:focus-within .info-tip-pop {
      transform: translateY(0) scale(1);
    }
    .info-tip[data-pos='end-lg'] .info-tip-pop {
      left: auto;
      right: 0;
      transform: translateY(2px) scale(0.97);
      transform-origin: top right;
    }
    .info-tip[data-pos='end-lg']:hover .info-tip-pop,
    .info-tip[data-pos='end-lg']:focus-within .info-tip-pop {
      transform: translateY(0) scale(1);
    }
  }
</style>
