---
// The "beginner's trail" guidepost — deliberately separate from InfoTip.astro.
// InfoTip is a one-line glossary definition for a single term; this is deeper,
// journey-level guidance for readers who may not know foundational concepts yet
// (what GitHub is, what a terminal is) and who a wall of setup commands could
// otherwise scare off entirely (human review, 2026-07-23: "let's put our user
// journey thinking cap on; many people do not even know what GitHub is or how
// to operate CLI commands").
//
// Interaction (human review, 2026-07-23, modeled on a hover-to-reveal /
// click-to-pin panel from a reference project): collapsed by default, expands
// on hover with a smooth height/opacity transition, a click pins it open
// (survives the mouse leaving), and it auto-collapses otherwise once the
// pointer leaves. This needs a little client JS — hover-expand plus
// click-to-pin has no reliable CSS-only equivalent — scoped to just this
// component, same precedent as Nav.astro's existing mobile-menu script.
interface Props {
  title: string;
  open?: boolean;
}
const { title, open = false } = Astro.props;
---

<div class={`trail${open ? ' is-open' : ''}`} data-trail data-pinned={open ? 'true' : 'false'}>
  <button type="button" class="trail-summary" data-trail-toggle aria-expanded={open ? 'true' : 'false'}>
    <span class="trail-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v3.5M12 21v-3.5M5 7.5l2.8 1.4M19 15.1l-2.8-1.4M5 16.5l2.8-1.4M19 7.9l-2.8 1.4" />
        <circle cx="12" cy="12" r="3" />
      </svg>
    </span>
    <span class="trail-label">Beginner's trail</span>
    <span class="trail-title">{title}</span>
    <span class="trail-hint">
      <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
        <path d="M4 2.2 12 8.6l-3.3.7L7.5 13 4 2.2z" fill="currentColor" />
        <path d="M11.2 2.3v1.3M14.3 5.4h-1.3M13.5 3.2l-0.95 0.95" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      </svg>
      click to stay open
    </span>
    <svg class="trail-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>
  <div class="trail-body" data-trail-body>
    <div class="trail-body-inner">
      <slot />
    </div>
  </div>
  <noscript>
    <style>
      .trail-body { max-height: none !important; opacity: 1 !important; visibility: visible !important; }
    </style>
  </noscript>
</div>

<script>
  const HOVER_OPEN_DELAY = 150;
  const HOVER_CLOSE_DELAY = 450;

  // Bound to astro:page-load, not top-level: this component lives inside
  // <main>, which isn't transition:persist-ed, so a fresh (unbound) instance
  // arrives on every client-side navigation to this page, not just the first.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-trail]').forEach((trail) => {
      const toggle = trail.querySelector<HTMLButtonElement>('[data-trail-toggle]');
      if (!toggle || toggle.dataset.trailBound === 'true') return;
      toggle.dataset.trailBound = 'true';

      let pinned = trail.dataset.pinned === 'true';
      let openTimer: ReturnType<typeof setTimeout> | undefined;
      let closeTimer: ReturnType<typeof setTimeout> | undefined;

      function setOpen(isOpen: boolean) {
        trail.classList.toggle('is-open', isOpen);
        toggle!.setAttribute('aria-expanded', String(isOpen));
      }

      trail.addEventListener('mouseenter', () => {
        clearTimeout(closeTimer);
        if (!trail.classList.contains('is-open')) {
          openTimer = setTimeout(() => setOpen(true), HOVER_OPEN_DELAY);
        }
      });

      trail.addEventListener('mouseleave', () => {
        clearTimeout(openTimer);
        if (!pinned) {
          closeTimer = setTimeout(() => setOpen(false), HOVER_CLOSE_DELAY);
        }
      });

      toggle.addEventListener('click', () => {
        pinned = !pinned;
        trail.dataset.pinned = String(pinned);
        setOpen(pinned || trail.matches(':hover'));
      });
    });
  });
</script>

<style>
  .trail {
    margin-top: 2rem;
    border: 1px dashed rgba(45, 212, 191, 0.35);
    border-radius: 0.75rem;
    background: rgba(45, 212, 191, 0.04);
  }
  .trail-summary {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border: none;
    background: none;
    cursor: pointer;
    text-align: left;
    font: inherit;
  }
  .trail-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-teal-300);
  }
  .trail-label {
    flex-shrink: 0;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-teal-400);
  }
  .trail-title {
    flex: 1;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-offwhite);
  }
  /* Hints at the hover-preview/click-to-pin behavior above — otherwise a
     reader who hovers, starts reading, then looks away has the panel
     collapse on them with no idea why. Only shown during that hover-preview
     window: hidden while closed (nothing to explain yet) and hidden again
     once actually pinned open (the instruction is moot at that point). */
  .trail-hint {
    display: none;
    flex-shrink: 0;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.6rem;
    color: var(--color-muted);
    opacity: 0.7;
  }
  .trail.is-open:not([data-pinned='true']) .trail-hint {
    display: inline-flex;
  }
  .trail-chevron {
    flex-shrink: 0;
    color: var(--color-muted);
    transition: transform var(--dur-base) var(--ease-ios);
  }
  .trail.is-open .trail-chevron {
    transform: rotate(180deg);
  }
  .trail-body {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height var(--dur-slow) var(--ease-ios), opacity var(--dur-base) var(--ease-ios);
  }
  .trail.is-open .trail-body {
    max-height: 32rem;
    opacity: 1;
  }
  .trail-body-inner {
    padding: 0 1rem 1rem 2.6rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .trail-body-inner :global(p + p) {
    margin-top: 0.5rem;
  }
  .trail-body-inner :global(strong) {
    color: var(--color-offwhite);
    font-weight: 600;
  }
</style>
