---
// §9.6 The MLOps System — the DEEP half of the two-loop design, positioned late for
// the interested reader. Same system as §9.3, one level deeper. Real pipeline labels,
// honest capstone-true claim strip. Circle diagram at every breakpoint (human review,
// 2026-07-28: kept as a circle even on mobile, not swapped for a text list — the
// diagram itself just scales down; see the responsive tile sizing below).
import Button from '../Button.astro';
import { withBase } from '../../lib/site';

const nodes = [
  { title: 'Sensor Data', body: 'Live/simulated readings from machines' },
  { title: 'Prediction API', body: 'Real-time inference & failure probability' },
  { title: 'Evidently Drift Check', body: 'Detects data & model drift' },
  { title: 'GitHub Actions', body: 'Automated CI/CD for ML' },
  { title: 'DVC Pipeline', body: 'Versioned data + retraining' },
  { title: 'MLflow Registry', body: 'Compare, track & promote models' },
];

// Positions around a circle (top start, clockwise) as percentages.
const R = 42;
const placed = nodes.map((n, i) => {
  const a = (-90 + i * 60) * (Math.PI / 180);
  return { ...n, left: 50 + R * Math.cos(a), top: 50 + R * Math.sin(a) };
});

// Connecting arrows between consecutive nodes (missing entirely before human
// review, 2026-07-28 — see technical_process.png). Drawn on a smaller INNER
// ring (not the R=42 ring the node tiles sit on) — human review, 2026-07-28:
// painting them on the node ring (even on top, z-order-wise) meant the arc
// line ran straight across each tile's own text, which read as broken/messy.
// At this inner radius they curve through the open space between the center
// mark and the tiles instead, clear of every tile's footprint at every
// breakpoint (checked against the smallest tile size too).
const ARC_R = 26;
const ARC_TRIM_DEG = 4;
const arcs = nodes.map((_, i) => {
  const a0 = (-90 + i * 60 + ARC_TRIM_DEG) * (Math.PI / 180);
  const a1 = (-90 + (i + 1) * 60 - ARC_TRIM_DEG) * (Math.PI / 180);
  const x0 = 50 + ARC_R * Math.cos(a0);
  const y0 = 50 + ARC_R * Math.sin(a0);
  const x1 = 50 + ARC_R * Math.cos(a1);
  const y1 = 50 + ARC_R * Math.sin(a1);
  return `M ${x0.toFixed(2)} ${y0.toFixed(2)} A ${ARC_R} ${ARC_R} 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`;
});

// Name + one-line purpose per tool, matching the reference mockup
// (design/mockups/Screenshot 2026-07-21 112150.png) — brand icons are a
// separate, sourced-not-generated follow-up (docs/IMAGE_ASSETS.md item 6).
const builtWith = [
  { name: 'Python', body: 'Data processing & modeling' },
  { name: 'Pandas', body: 'Data analysis' },
  { name: 'Scikit-learn', body: 'ML modeling' },
  { name: 'NumPy', body: 'Numerical computing' },
];
const poweredBy = [
  { name: 'GitHub Actions', body: 'Automated CI/CD for ML' },
  { name: 'DVC', body: 'Data version control' },
  { name: 'MLflow', body: 'Experiment tracking & model registry' },
  { name: 'Evidently AI', body: 'Data & model drift monitoring' },
];

const claims = [
  { title: 'Automated', body: 'No manual retraining' },
  { title: 'Reproducible', body: 'DVC-versioned data & pipeline' },
  { title: 'Monitored', body: 'Evidently drift checks' },
  { title: 'Open-source stack', body: 'Runs on your own machine' },
];
---

<section id="tech-stack" class="scroll-mt-20 border-t border-white/5 bg-navy-900 py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-teal-400">
        For the technical reader
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-offwhite sm:text-4xl 2xl:text-5xl">
        The MLOps System Behind the Predictions
      </h2>
      <p class="mt-4 text-lg text-muted">
        The same loop from
        <a href="#how-it-works" class="text-teal-300 underline decoration-teal-400/40 underline-offset-4 hover:text-teal-200">How it works</a>
        — now with the tools that run it.
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-[1fr_1.4fr_1fr] lg:items-center">
      <!-- Built With -->
      <div class="rounded-xl border border-white/10 bg-navy-800/40 p-5" data-reveal>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-muted/60">Built with</h3>
        <ul class="space-y-2">
          {builtWith.map((t) => (
            <li class="rounded-md border border-white/10 bg-navy-950/50 px-3 py-2 transition-colors duration-[var(--dur-base)] ease-[var(--ease-ios-in-out)] hover:border-teal-400/30 hover:bg-navy-800/60">
              <p class="text-sm font-semibold text-offwhite">{t.name}</p>
              <p class="text-xs text-muted">{t.body}</p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Circular diagram — same layout at every breakpoint (human review, 2026-07-28:
           no separate mobile text-list fallback). The container and node tiles scale
           down together so it stays a circle even on a narrow phone. -->
      <div data-reveal style="transition-delay: 80ms">
        <div class="relative mx-auto aspect-square w-full max-w-[15.5rem] sm:max-w-xs md:max-w-md">
          <!-- center mark -->
          <div class="absolute left-1/2 top-1/2 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-teal-400/40 bg-navy-950 sm:h-16 sm:w-16 md:h-20 md:w-20">
            <svg class="h-4 w-4 sm:h-6 sm:w-6 md:h-[30px] md:w-[30px]" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path d="M16 3 L29 28 L3 28 Z" stroke="var(--color-teal-400)" stroke-width="2" stroke-linejoin="round" />
              <path d="M16 13 L23 26 L9 26 Z" fill="var(--color-teal-400)" opacity="0.9" />
            </svg>
          </div>
          {
            placed.map((n, i) => (
              <div
                class="mlops-node absolute w-16 -translate-x-1/2 -translate-y-1/2 rounded-lg border border-white/10 bg-navy-800 p-1 text-center sm:w-28 sm:p-2 md:w-32 md:p-2.5"
                style={`left:${n.left}%; top:${n.top}%;`}
              >
                <p class="text-[0.5rem] font-semibold leading-tight text-teal-300 sm:text-[0.65rem] md:text-xs">{i + 1}. {n.title}</p>
                <p class="mt-0.5 hidden text-[0.65rem] leading-tight text-muted/80 sm:block">{n.body}</p>
              </div>
            ))
          }
          <!-- Arrows render last (on top of the tiles, human review 2026-07-28 — they were
               previously painting underneath and reading as hidden/invisible against the
               tiles' opaque backgrounds). pointer-events-none so they don't block clicks. -->
          <svg class="pointer-events-none absolute inset-0 h-full w-full overflow-visible" viewBox="0 0 100 100" fill="none" aria-hidden="true">
            <defs>
              <marker id="mlops-arrow-head" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="4" markerHeight="4" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-teal-400)" />
              </marker>
            </defs>
            {
              arcs.map((d) => (
                <path d={d} stroke="var(--color-teal-400)" stroke-opacity="0.85" stroke-width="0.8" marker-end="url(#mlops-arrow-head)" />
              ))
            }
          </svg>
        </div>
      </div>

      <!-- Powered By -->
      <div class="rounded-xl border border-white/10 bg-navy-800/40 p-5" data-reveal style="transition-delay: 140ms">
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-muted/60">Powered by</h3>
        <ul class="space-y-2">
          {poweredBy.map((t) => (
            <li class="rounded-md border border-white/10 bg-navy-950/50 px-3 py-2 transition-colors duration-[var(--dur-base)] ease-[var(--ease-ios-in-out)] hover:border-teal-400/30 hover:bg-navy-800/60">
              <p class="text-sm font-semibold text-offwhite">{t.name}</p>
              <p class="text-xs text-muted">{t.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Honest, capstone-true claim strip -->
    <div class="mt-14 grid gap-4 rounded-2xl border border-white/10 bg-navy-950/40 p-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {
        claims.map((c) => (
          <div class="text-center sm:text-left">
            <p class="text-sm font-semibold text-teal-300">{c.title}</p>
            <p class="mt-0.5 text-xs text-muted">{c.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex justify-center">
      <Button href={withBase('/try-it-yourself')} variant="solid">Test it on your device →</Button>
    </div>
  </div>
</section>

<style>
  /* Bespoke hover rule, not the shared .tile-hover utility: these node tiles
     already carry a -translate-x/y-1/2 centering transform (they're placed by
     percentage around a circle), and .tile-hover's plain `translateY(-4px)`
     would replace that transform outright rather than combine with it —
     scale (a "pop", not a "lift") reads better on a radially-placed node
     anyway, so it gets its own rule instead of forcing the shared one to fit. */
  .mlops-node {
    transition: transform var(--dur-base) var(--ease-ios), border-color var(--dur-base) var(--ease-ios),
      background-color var(--dur-base) var(--ease-ios);
  }
  @media (hover: hover) and (pointer: fine) {
    .mlops-node:hover {
      transform: translate(-50%, -50%) scale(1.08);
      border-color: color-mix(in srgb, var(--color-teal-400) 50%, transparent);
      background-color: var(--color-navy-700);
    }
  }
  .mlops-node:active {
    transform: translate(-50%, -50%) scale(1.03);
  }
</style>
