---
import Logo from './Logo.astro';
import InfoTip from './InfoTip.astro';
import { REPO_URL, TEAM, PROGRAM, KAGGLE_DATASET_URL, KAGGLE_DATASET_NAME, withBase } from '../lib/site';
import { useTranslations, DEFAULT_LOCALE } from '../i18n';

const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
const t = useTranslations(locale).footer;
const year = new Date().getFullYear();
// Only "AI4I 2020" is short enough to read as a link label without the
// underline swallowing the whole dataset name — the rest stays plain text,
// still derived from the shared constant (Contract 1) rather than re-typed.
const kaggleDatasetWords = KAGGLE_DATASET_NAME.split(' ');
const kaggleDatasetId = kaggleDatasetWords.slice(0, 2).join(' ');
const kaggleDatasetRest = kaggleDatasetWords.slice(2).join(' ');
---

<!-- transition:name is locale-keyed — see Nav.astro's identical comment on
     its own <header>. Without this, switching languages via
     LanguageSwitcher would leave this footer's persisted DOM frozen in
     whichever locale rendered it first. -->
<footer
  id="project-team"
  class="scroll-mt-20 border-t border-white/5 bg-navy-950"
  transition:persist
  transition:name={`site-footer-${locale}`}
>
  <div class="mx-auto max-w-7xl px-5 py-14 md:px-8">
    <!-- divide-y (mobile-only, human-requested, 2026-08-11 — Krug-style
         scannability pass): below md the three columns stack as plain
         siblings with nothing marking where one ends and the next begins,
         reading as one long undifferentiated block rather than three
         distinct groups. `divide-y` puts a hairline border-top on every
         child except the first — exactly "between stacked sections, not
         above the first one" — reusing the same border-white/5 hairline
         already used sitewide (this footer's own top border, every
         section's border-t) rather than a one-off color (Contract 4).
         `md:divide-y-0` turns it off once the grid becomes three real
         side-by-side columns, where a top border on column 2/3 would be
         meaningless. Order (Team → Links → About) is untouched — a
         CSS-order-based visual reshuffle was considered and turned down
         specifically because it would leave screen-reader/keyboard tab
         order silently mismatched from what's visually first. -->
    <div class="grid gap-10 divide-y divide-white/5 md:grid-cols-3 md:divide-y-0">
      <!-- Team -->
      <!-- id is a second, narrower target than the <footer>'s own
           id="project-team" above (which anchors the nav link's scroll
           position via scroll-mt-20) — this one is just for Nav.astro's
           targeting-reticule script to frame the column that actually says
           "Project & Team," not the whole three-column footer. -->
      <div id="team-panel">
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-muted/60">
          {t.projectAndTeam}
        </h2>
        <ul class="space-y-2 text-sm text-muted">
          {
            TEAM.map((m) => (
              <li class="flex items-center gap-1.5">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="shrink-0 text-muted/60"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10" />
                  <circle cx="12" cy="10" r="3" />
                  <path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662" />
                </svg>
                <span class="text-offwhite">{m.name}</span>{' '}
                <a href={m.url} class="footer-link text-teal-400 hover:text-teal-300" rel="noopener">
                  {m.handle}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-xs text-muted/70">{PROGRAM}</p>

        <!-- Data-source credit — lives in this column (human-requested
             2026-08-07, moved out of its own full-width row below) since it's
             the same kind of "credit," not a fourth item competing for its
             own row. Generic "dataset" glyph (a 2×2 grid, stroke="currentColor"
             so it inherits the link's teal-400), not Kaggle's own trademarked
             mark — see Contract 4: no one-off hex, no third-party logo asset.
             The icon is an INLINE child of the <p> itself (not a flex sibling
             before it) — human-requested 2026-08-07, so a wrapped second line
             returns flush to the icon's own left edge instead of hanging-
             indented under where "Built" starts on line one. A flex layout
             can't do that: both lines of a wrapped flex-sibling <p> share the
             p's own box edge, which sits to the right of the icon. -->
        <p class="mt-4 text-xs text-muted/60">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="mr-1.5 inline-block align-text-bottom text-teal-400">
            <rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" />
            <rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" />
            <rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" />
            <rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" />
          </svg>
          {t.builtUsingOpenData}{' '}
          <a
            href={KAGGLE_DATASET_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link text-teal-400 hover:text-teal-300"
          >
            Kaggle — {kaggleDatasetId}
          </a>{' '}
          {kaggleDatasetRest}.
        </p>

        <!-- Digital-sovereignty credit (human-requested, 2026-08-07) — the
             on-page expression of the same stance CLAUDE.md's own "Digital
             Sovereignty & Privacy" standing protocol holds about the
             site's tooling/infra: default to European-hosted/operated
             wherever a real choice exists. Same icon technique as the
             Kaggle credit above (generic abstracted glyph, fill via
             currentColor, no third-party trademarked mark — Contract 4) —
             twelve dots ringed like the EU flag's stars, in `--color-blue-500`
             (human-requested follow-up, 2026-08-07: closer to the flag's own
             blue than teal) — an existing site token already used elsewhere
             (Hero.astro's eyebrow), not a new one-off hex, so this still
             respects Contract 4 while nodding at the real flag color. Gold
             stays out: the dataset icon's own reasoning (no one-off color
             pair, no imitation of an official mark) still applies to that
             part. -->
        <p class="mt-4 text-xs text-muted/80">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="mr-1.5 inline-block align-text-bottom text-blue-500">
            <circle cx="12" cy="4" r="1.3" />
            <circle cx="16" cy="5.07" r="1.3" />
            <circle cx="18.93" cy="8" r="1.3" />
            <circle cx="20" cy="12" r="1.3" />
            <circle cx="18.93" cy="16" r="1.3" />
            <circle cx="16" cy="18.93" r="1.3" />
            <circle cx="12" cy="20" r="1.3" />
            <circle cx="8" cy="18.93" r="1.3" />
            <circle cx="5.07" cy="16" r="1.3" />
            <circle cx="4" cy="12" r="1.3" />
            <circle cx="5.07" cy="8" r="1.3" />
            <circle cx="8" cy="5.07" r="1.3" />
          </svg>
          {t.madeWithLoveIn}{' '}
          <a
            href="https://digital-strategy.ec.europa.eu/en/policies/eu-tech-sovereignty"
            target="_blank"
            rel="noopener noreferrer"
            class="border-b border-teal-400 transition-colors hover:text-offwhite hover:border-teal-300"
          >
            {t.europe}
          </a>.
        </p>
      </div>

      <!-- Links — nudged right on desktop (human-requested, 2026-08-07):
           a plain md:gap-x increase on the parent grid was tried first and
           rejected — widening the gap also narrows every column's own
           track to compensate, so it barely moved this column's actual
           start position (the two effects mostly cancel out). A direct
           margin on just this column and About's, below, moves them by
           the exact pixel amount asked for, independent of track/gap math,
           without touching Team's position at all. `lg:` not `md:` — the
           3-col grid already starts at md (768px), where a column is only
           ~200px wide before any margin; adding 4rem there would leave the
           Links list cramped. lg (1024px+) has more room to spare and is
           closer to what "desktop mode" means anyway. -->
      <div class="lg:ml-16">
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-muted/60">
          {t.links}
        </h2>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={withBase('/product', locale)} class="footer-link text-muted hover:text-offwhite">
              {t.seeItInAction}
            </a>
          </li>
          <li>
            <a href={withBase('/try-it-yourself', locale)} class="footer-link text-muted hover:text-offwhite">
              {t.testItOnYourDevice}
            </a>
          </li>
          <li>
            <a href={REPO_URL} class="footer-link text-muted hover:text-offwhite" rel="noopener">
              {t.githubRepository}
            </a>
          </li>
          <li>
            <a href="#top" class="footer-link text-muted hover:text-offwhite">{t.backToTop}</a>
          </li>
        </ul>
      </div>

      <!-- About / capstone framing — rightmost column (human-requested,
           2026-08-07): was the leftmost column originally; Team and Links
           each moved up one slot to fill in. Same lg:ml-16 rightward nudge
           as the Links column above (see its comment). -->
      <div class="lg:ml-16">
        <Logo class="mb-4" />
        <p class="max-w-sm text-sm leading-relaxed text-muted">
          {t.aboutBody}
        </p>
        <p class="mt-4 max-w-sm text-xs leading-relaxed text-muted/70">
          {t.aboutCapstonePrefix} <strong class="font-medium text-muted">{t.aboutCapstoneBold}</strong>{' '}
          {t.aboutCapstoneSuffix}
        </p>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/5 pt-6 text-xs text-muted/60 md:flex-row md:items-center md:justify-between">
      <p>{t.copyright(year)}</p>
      <!-- LED dot-matrix treatment on just the short status phrase, plain
           text for the rest (human-requested, 2026-08-07) — a dot-matrix
           face reads as noise at paragraph length, but a short all-caps
           "device status readout" phrase is exactly what it was designed
           for, and doubles as a quiet nod to the machines' own status
           screens shown in the hero photo.

           Scrolling marquee (human-requested follow-up, 2026-08-07 — "scroll
           horizontally very slowly/smoothly at the bottom like an LED
           screen"): the visible, animated `.led-ticker` is a decorative
           duplicate-content loop (two identical copies of the phrase back
           to back, scrolled by exactly one copy's own width so the loop has
           no visible seam/reset) — aria-hidden, since a screen reader
           reading two concatenated copies of the same phrase on a loop
           would be nonsense. `.sr-only` carries the one real reading of it.
           `.led-ticker-fallback` is a third, un-duplicated, unanimated copy
           that's hidden by default and only shown under
           prefers-reduced-motion (see <style> below) — without it, reduced-
           motion users would get a frozen frame of the scrolling version,
           which (being narrower than the full phrase by design, so it has
           something to scroll) would permanently show only PART of "NO
           ANALYTICS · NO TRACKING", cut off — worse than not animating it,
           not just less delightful. -->
      <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
        <span class="led-ticker" aria-hidden="true">
          <span class="led-ticker-track">
            <span class="led-readout">{t.ledTicker}</span>
            <span class="led-readout">{t.ledTicker}</span>
          </span>
        </span>
        <span class="led-readout led-ticker-fallback" aria-hidden="true">{t.ledTicker}</span>
        <span class="sr-only">{t.ledTickerSrOnly}</span>
        <span class="inline-flex items-center gap-1">
          {t.noLoggingSuffix}
          <InfoTip label={t.privacyTipLabel} position="end">
            {t.privacyTipBody}{' '}{t.privacyTipHostingPrefix}{' '}
            <!-- Only interactive element ever placed inside an InfoTip
                 popover (role="tooltip") — a deliberate, narrow exception:
                 the GitHub Pages hosting disclosure needs a real citation,
                 not just prose. The link stays reachable via the same
                 :focus-within chain that opens the popover (it's the (i)
                 button's next DOM sibling), so keyboard users can still tab
                 into it even though WAI-ARIA's tooltip pattern generally
                 assumes non-interactive content. -->
            <a
              href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link text-teal-400 hover:text-teal-300"
            >
              {t.privacyTipHostingLinkLabel}
            </a>{' '}
            {t.privacyTipHostingSuffix}
          </InfoTip>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  /* LED Dot-Matrix (global.css's font-led/@font-face) at a size/spacing tuned
     for its own shapes — dot-matrix glyphs are drawn on a coarse pixel grid,
     so they need more breathing room than a normal typeface at the same
     visual weight to stay legible rather than clumping into a smear. A
     restrained teal glow (not a full alert-style bloom) is the one liberty
     taken here — it's what reads as "lit segment" rather than "printed
     text pretending to be an LED," but stays subtle enough for a footer
     credit line, not a hero moment. */
  /* Gradient fill (human-requested follow-up, 2026-08-07: "a more modern
     gradient color" than the flat teal-300) — three EXISTING tokens
     (teal-300 → teal-400 → blue-500), not a new one-off pair, so this stays
     inside Contract 4. `color: transparent` + `background-clip: text` is
     what lets the gradient show through the glyph shapes instead of behind
     them; `-webkit-` prefixes are still required for this in Safari. The
     glow (`text-shadow`) is independent of fill color — it's drawn from the
     glyph outlines regardless — so it keeps working unchanged on top of the
     gradient instead of needing a separate glow-per-stop trick. */
  .led-readout {
    font-family: var(--font-led);
    font-size: 0.85em;
    letter-spacing: 0.08em;
    background: linear-gradient(90deg, var(--color-teal-300), var(--color-teal-400) 50%, var(--color-blue-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 6px color-mix(in srgb, var(--color-teal-400) 45%, transparent);
  }

  /* Scrolling "porthole" (see the markup comment above) — a fixed-width
     window narrower than the phrase itself, so there's actually something
     to scroll. 11rem is an estimate, not a measurement (this sandbox can't
     render a browser to check the LED font's real rendered width — see
     other comments this session for why); it's a plain `width`, the
     lowest-risk kind of value to nudge later; getting it slightly wrong
     just makes the window a bit bigger/smaller, it can't break anything. */
  .led-ticker {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    width: 11rem;
    white-space: nowrap;
  }
  /* Slightly wider porthole on super-widescreen (2xl: 1536px+, matching the
     site's existing convention — see ProductPreview.astro's 2xl:max-w-[1100px]
     — for where "super widescreen" treatments kick in). */
  @media (min-width: 1536px) {
    .led-ticker {
      width: 13rem;
    }
  }
  /* Two identical .led-readout copies laid out in a row (`display: flex`
     so there's no stray inline-whitespace gap between them from the
     template's own line breaks), each padded on its trailing edge —
     padding, not a flex `gap`, deliberately: with padding baked into each
     item's own box, both items end up EXACTLY the same width (text + its
     own trailing space), so "half the track's total width" is
     mathematically identical to "one item's full width" regardless of how
     wide the phrase actually renders. That identity is what makes the loop
     seamless: sliding left by exactly one item's width lands copy 2 exactly
     where copy 1 started, so the animation can jump back to 0% with no
     visible seam. A flex `gap` would break that — the gap only appears
     BETWEEN items, not after the last one, so "half the track" and "one
     item + its gap" stop being equal. */
  .led-ticker-track {
    display: flex;
    width: max-content;
    animation: led-scroll 16s linear infinite;
  }
  .led-ticker-track > .led-readout {
    padding-right: 2.5rem;
    flex-shrink: 0;
  }
  @keyframes led-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  /* Static fallback, hidden unless prefers-reduced-motion (see the markup
     comment above for why this exists at all — the animated version alone
     would otherwise permanently show only a clipped fragment of the phrase
     for these visitors). */
  .led-ticker-fallback {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .led-ticker {
      display: none;
    }
    .led-ticker-fallback {
      display: inline;
    }
  }

  /* Animated underline-in rather than a flat color swap, matching Nav.astro's
     .nav-link treatment so hover feedback reads as one system across the site. */
  .footer-link {
    position: relative;
    display: inline-block;
    transition: color var(--dur-base) var(--ease-ios-in-out);
  }
  .footer-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-ios);
  }
  .footer-link:hover::after,
  .footer-link:focus-visible::after {
    transform: scaleX(1);
  }
</style>
