---
import Logo from './Logo.astro';
import InfoTip from './InfoTip.astro';
import { REPO_URL, TEAM, PROGRAM, KAGGLE_DATASET_URL, KAGGLE_DATASET_NAME, withBase } from '../lib/site';
const year = new Date().getFullYear();
---

<footer
  id="project-team"
  class="scroll-mt-20 border-t border-white/5 bg-navy-950"
  transition:persist
  transition:name="site-footer"
>
  <div class="mx-auto max-w-7xl px-5 py-14 md:px-8">
    <div class="grid gap-10 md:grid-cols-3">
      <!-- About / capstone framing -->
      <div>
        <Logo class="mb-4" />
        <p class="max-w-sm text-sm leading-relaxed text-muted">
          Predictive maintenance for industrial equipment — a complete MLOps
          pipeline: live sensor predictions, automated drift monitoring, and
          self-triggering retraining.
        </p>
        <p class="mt-4 max-w-sm text-xs leading-relaxed text-muted/70">
          A capstone project showcase built on <strong class="font-medium text-muted">simulated CNC sensor data</strong> —
          not a live paying-customer deployment, yet.
        </p>
      </div>

      <!-- Team -->
      <div>
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-muted/60">
          Project &amp; Team
        </h2>
        <ul class="space-y-2 text-sm text-muted">
          {
            TEAM.map((m) => (
              <li>
                <span class="text-offwhite">{m.name}</span>{' '}
                <a href={m.url} class="footer-link text-teal-400 hover:text-teal-300" rel="noopener">
                  {m.handle}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-xs text-muted/70">{PROGRAM}</p>

        <!-- Data-source credit — lives in this column (human-requested
             2026-08-07, moved out of its own full-width row below) since it's
             the same kind of "credit," not a fourth item competing for its
             own row. Generic "dataset" glyph (a 2×2 grid, stroke="currentColor"
             so it inherits the link's teal-400), not Kaggle's own trademarked
             mark — see Contract 4: no one-off hex, no third-party logo asset.
             The icon is an INLINE child of the <p> itself (not a flex sibling
             before it) — human-requested 2026-08-07, so a wrapped second line
             returns flush to the icon's own left edge instead of hanging-
             indented under where "Built" starts on line one. A flex layout
             can't do that: both lines of a wrapped flex-sibling <p> share the
             p's own box edge, which sits to the right of the icon. -->
        <p class="mt-4 text-xs text-muted/60">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="mr-1.5 inline-block align-text-bottom text-teal-400">
            <rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" />
            <rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" />
            <rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" />
            <rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" />
          </svg>
          Built using open data from{' '}
          <a
            href={KAGGLE_DATASET_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link text-teal-400 hover:text-teal-300"
          >
            Kaggle — {KAGGLE_DATASET_NAME}
          </a>.
        </p>

        <!-- Digital-sovereignty credit (human-requested, 2026-08-07) — the
             on-page expression of the same stance CLAUDE.md's own "Digital
             Sovereignty & Privacy" standing protocol holds about the
             site's tooling/infra: default to European-hosted/operated
             wherever a real choice exists. Same icon technique as the
             Kaggle credit above (generic abstracted glyph, stroke/fill via
             currentColor, no third-party trademarked mark or one-off hex —
             Contract 4) — twelve dots ringed like the EU flag's stars
             rather than the flag's actual blue/gold, which would both
             introduce a one-off color pair and imitate an official mark. -->
        <p class="mt-2 text-xs text-muted/60">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="mr-1.5 inline-block align-text-bottom text-teal-400">
            <circle cx="12" cy="4" r="1.3" />
            <circle cx="16" cy="5.07" r="1.3" />
            <circle cx="18.93" cy="8" r="1.3" />
            <circle cx="20" cy="12" r="1.3" />
            <circle cx="18.93" cy="16" r="1.3" />
            <circle cx="16" cy="18.93" r="1.3" />
            <circle cx="12" cy="20" r="1.3" />
            <circle cx="8" cy="18.93" r="1.3" />
            <circle cx="5.07" cy="16" r="1.3" />
            <circle cx="4" cy="12" r="1.3" />
            <circle cx="5.07" cy="8" r="1.3" />
            <circle cx="8" cy="5.07" r="1.3" />
          </svg>
          Made with love in{' '}
          <a
            href="https://digital-strategy.ec.europa.eu/en/policies/eu-tech-sovereignty"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link text-teal-400 hover:text-teal-300"
          >
            Europe
          </a>.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-muted/60">
          Links
        </h2>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={withBase('/product')} class="footer-link text-muted hover:text-offwhite">
              See it in action
            </a>
          </li>
          <li>
            <a href={withBase('/try-it-yourself')} class="footer-link text-muted hover:text-offwhite">
              Test it on your device
            </a>
          </li>
          <li>
            <a href={REPO_URL} class="footer-link text-muted hover:text-offwhite" rel="noopener">
              GitHub repository
            </a>
          </li>
          <li>
            <a href="#top" class="footer-link text-muted hover:text-offwhite">Back to top ↑</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/5 pt-6 text-xs text-muted/60 md:flex-row md:items-center md:justify-between">
      <p>© {year} Preempt Analytics — capstone project. Built with Astro &amp; Tailwind.</p>
      <!-- LED dot-matrix treatment on just the short status phrase, plain
           text for the rest (human-requested, 2026-08-07) — a dot-matrix
           face reads as noise at paragraph length, but a short all-caps
           "device status readout" phrase is exactly what it was designed
           for, and doubles as a quiet nod to the machines' own status
           screens shown in the hero photo.

           Scrolling marquee (human-requested follow-up, 2026-08-07 — "scroll
           horizontally very slowly/smoothly at the bottom like an LED
           screen"): the visible, animated `.led-ticker` is a decorative
           duplicate-content loop (two identical copies of the phrase back
           to back, scrolled by exactly one copy's own width so the loop has
           no visible seam/reset) — aria-hidden, since a screen reader
           reading two concatenated copies of the same phrase on a loop
           would be nonsense. `.sr-only` carries the one real reading of it.
           `.led-ticker-fallback` is a third, un-duplicated, unanimated copy
           that's hidden by default and only shown under
           prefers-reduced-motion (see <style> below) — without it, reduced-
           motion users would get a frozen frame of the scrolling version,
           which (being narrower than the full phrase by design, so it has
           something to scroll) would permanently show only PART of "NO
           ANALYTICS · NO TRACKING", cut off — worse than not animating it,
           not just less delightful. -->
      <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <span class="led-ticker" aria-hidden="true">
          <span class="led-ticker-track">
            <span class="led-readout">NO ANALYTICS · NO TRACKING · NO SURVEILLANCE CAPITALISM</span>
            <span class="led-readout">NO ANALYTICS · NO TRACKING · NO SURVEILLANCE CAPITALISM</span>
          </span>
        </span>
        <span class="led-readout led-ticker-fallback" aria-hidden="true">NO ANALYTICS · NO TRACKING · NO SURVEILLANCE CAPITALISM</span>
        <span class="sr-only">No analytics. No tracking. No surveillance capitalism.</span>
        <span class="inline-flex items-center gap-1">
          — nothing you do here is logged.
          <InfoTip label="Our privacy approach" position="end">
            No cookies — not even "necessary" ones. No analytics, no trackers, no fingerprinting, and nothing sent
            to a third party. This site doesn't collect anything about your visit, so there's nothing to ask your
            consent for under GDPR/ePrivacy — which is also why there's no cookie banner here.
          </InfoTip>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  /* LED Dot-Matrix (global.css's font-led/@font-face) at a size/spacing tuned
     for its own shapes — dot-matrix glyphs are drawn on a coarse pixel grid,
     so they need more breathing room than a normal typeface at the same
     visual weight to stay legible rather than clumping into a smear. A
     restrained teal glow (not a full alert-style bloom) is the one liberty
     taken here — it's what reads as "lit segment" rather than "printed
     text pretending to be an LED," but stays subtle enough for a footer
     credit line, not a hero moment. */
  .led-readout {
    font-family: var(--font-led);
    font-size: 0.85em;
    letter-spacing: 0.08em;
    color: var(--color-teal-300);
    text-shadow: 0 0 6px color-mix(in srgb, var(--color-teal-400) 45%, transparent);
  }

  /* Scrolling "porthole" (see the markup comment above) — a fixed-width
     window narrower than the phrase itself, so there's actually something
     to scroll. 11rem is an estimate, not a measurement (this sandbox can't
     render a browser to check the LED font's real rendered width — see
     other comments this session for why); it's a plain `width`, the
     lowest-risk kind of value to nudge later; getting it slightly wrong
     just makes the window a bit bigger/smaller, it can't break anything. */
  .led-ticker {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    width: 11rem;
    white-space: nowrap;
  }
  /* Two identical .led-readout copies laid out in a row (`display: flex`
     so there's no stray inline-whitespace gap between them from the
     template's own line breaks), each padded on its trailing edge —
     padding, not a flex `gap`, deliberately: with padding baked into each
     item's own box, both items end up EXACTLY the same width (text + its
     own trailing space), so "half the track's total width" is
     mathematically identical to "one item's full width" regardless of how
     wide the phrase actually renders. That identity is what makes the loop
     seamless: sliding left by exactly one item's width lands copy 2 exactly
     where copy 1 started, so the animation can jump back to 0% with no
     visible seam. A flex `gap` would break that — the gap only appears
     BETWEEN items, not after the last one, so "half the track" and "one
     item + its gap" stop being equal. */
  .led-ticker-track {
    display: flex;
    width: max-content;
    animation: led-scroll 16s linear infinite;
  }
  .led-ticker-track > .led-readout {
    padding-right: 2.5rem;
    flex-shrink: 0;
  }
  @keyframes led-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  /* Static fallback, hidden unless prefers-reduced-motion (see the markup
     comment above for why this exists at all — the animated version alone
     would otherwise permanently show only a clipped fragment of the phrase
     for these visitors). */
  .led-ticker-fallback {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .led-ticker {
      display: none;
    }
    .led-ticker-fallback {
      display: inline;
    }
  }

  /* Animated underline-in rather than a flat color swap, matching Nav.astro's
     .nav-link treatment so hover feedback reads as one system across the site. */
  .footer-link {
    position: relative;
    display: inline-block;
    transition: color var(--dur-base) var(--ease-ios-in-out);
  }
  .footer-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-ios);
  }
  .footer-link:hover::after,
  .footer-link:focus-visible::after {
    transform: scaleX(1);
  }
</style>
