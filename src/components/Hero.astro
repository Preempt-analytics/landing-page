---

import Button from './Button.astro';
import StatRow from './StatRow.astro';
import { withBase } from '../lib/site';
---

<section class="relative z-0 overflow-hidden">
  <!-- `z-0` matters, not just cosmetic: `position:relative` alone doesn't create a
       stacking context without an explicit z-index, so the negative-z layers below
       would otherwise escape it and paint behind the page's own background instead
       of just behind this section's content — confirmed by direct DOM inspection,
       2026-07-28. This was silently hiding the photo below entirely. -->

  <!--
    Full-bleed hero photo, mirrors design/mockups/Screenshot 2026-07-21 112341.png:
    a background layer behind the copy, not a boxed/bordered image. Full-width behind
    the copy below lg — a near-opaque wash there, so the mobile view reads as faint
    texture, not a distinct photo (human review, 2026-07-28). From lg, narrows to the
    right 62% with the left/bottom fades below, so the photo reads clearly there,
    matching the mockup. Two gradient divs (not the photo itself) fade it into navy-950.

    ASSET: prototype-1-hero-image.png (design/visual-assets/), confirmed by human
    review 2026-07-28 as the image to use here.
  -->
  <div class="pointer-events-none absolute inset-0 -z-20 lg:left-auto lg:w-[62%]" aria-hidden="true">
    <img
      src={withBase('/images/hero/prototype-1-hero-image.png')}
      alt=""
      class="h-full w-full object-cover"
    />
    <!-- near-opaque wash below lg — the photo is felt, not seen, on narrow screens -->
    <div class="absolute inset-0 bg-navy-950/85 lg:hidden"></div>
    <!-- fade into the page background on the left edge (desktop only) -->
    <div
      class="absolute inset-0 hidden lg:block"
      style="background: linear-gradient(to right, var(--color-navy-950) 0%, transparent 42%);"
    >
    </div>
    <!-- fade into the page background at the bottom edge -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to bottom, transparent 55%, var(--color-navy-950) 100%);"
    >
    </div>
  </div>

  <!-- Cyberpunk glow overlay (separate from the photo, per §5). Two layers,
       each breathing on its own slow, offset cycle (ambient-breathe,
       global.css) instead of one static combined background — reads as
       ambient light drifting, not a single uniform pulse (human-requested,
       2026-07-28: ambient sophistication for the page's first impression). -->
  <div
    class="hero-glow pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(60% 55% at 78% 35%, rgba(45,212,191,0.16), transparent 70%); animation-duration: 11s;"
    aria-hidden="true"
  >
  </div>
  <div
    class="hero-glow pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(45% 40% at 12% 8%, rgba(59,130,246,0.14), transparent 70%); animation-duration: 15s; animation-delay: -6s;"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <!-- Copy block. Above-the-fold and already in view at first paint, so this
         uses a load-triggered staggered fade-up (.hero-fade-in) rather than the
         scroll-triggered [data-reveal] mechanism used everywhere below the fold —
         there's nothing to "scroll into view" here. -->
    <div class="max-w-2xl">
      <p
        class="hero-fade-in mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-blue-500"
        style="animation-delay: 0ms"
      >
        Predictive maintenance, powered by AI
      </p>

      <h1
        class="hero-fade-in text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl 2xl:text-7xl"
        style="animation-delay: 60ms"
      >
        <span class="text-offwhite">Predict failures.</span><br />
        <span class="text-teal-400">Prevent</span> <span class="text-offwhite">downtime.</span>
      </h1>

      <p
        class="hero-fade-in mt-6 max-w-xl text-lg leading-relaxed text-muted 2xl:max-w-2xl 2xl:text-xl"
        style="animation-delay: 140ms"
      >
        Preempt Analytics helps manufacturing teams predict machine failures
        before they happen—so you can maximize uptime and efficiency.
      </p>

      <div class="hero-fade-in mt-8 flex flex-wrap gap-4" style="animation-delay: 220ms">
        <Button href={withBase('/product')} variant="solid">See it in action →</Button>
        <Button href={withBase('/try-it-yourself')} variant="outline">
          Test it on your device
        </Button>
      </div>

      <p class="hero-fade-in mt-5 text-xs text-muted/60" style="animation-delay: 280ms">
        A capstone project showcase, running on simulated CNC sensor data.
      </p>
    </div>

    <!-- Stat row sits on the dark/faded area, wider than the copy block, as in the mockup -->
    <div class="hero-fade-in mt-10 max-w-4xl" style="animation-delay: 340ms">
      <StatRow />
    </div>
  </div>
</section>
