---
// §9.5 "While the employees sleep" — anonymized (no named person, no stock photo).
// Present-tense, active-voice timeline. Overnight Impact numbers are illustrative
// and labelled as such. Part of #solutions.
import { withBase } from '../../lib/site';
import { Image } from 'astro:assets';
import { OVERNIGHT_IMPACT_EUR, formatEur } from '../../lib/savings';
// Faceless illustration, not a stock photo of a real employee (see the
// no-fabricated-people rule in docs/IMAGE_ASSETS.md item 4 and ARCHITECTURE §9.5).
import maintenanceLead from '../../assets/maintenance-lead.png';

// Timeline copy + timestamps (human review, 2026-07-23): short, scannable status
// labels carry the contrast color (Krug — the label is what a scanning eye needs,
// not the clock); the body sentence underneath stays active-voice / present-tense
// (§9.5's original tense fix). Retrain/promote timestamps shift +8 min after the
// trigger to reflect a realistic GitHub Actions queue/startup delay.
const beats = [
  { time: '02:16 AM', title: 'Drift Detected', body: 'Tool-wear shift spotted on CNC-01 by Evidently AI.' },
  { time: '02:17 AM', title: 'Pipeline Triggered', body: 'The GitHub Actions pipeline kicks off automatically.' },
  { time: '02:28 AM', title: 'Model Retrained', body: 'A fresh model trains on the latest factory data.' },
  { time: '02:45 AM', title: 'Model Promoted', body: 'The new version beats the old one and goes live automatically.' },
  { time: '06:47 AM', title: 'System Healthy', body: 'The maintenance lead opens the dashboard. No calls. No incidents.' },
];

const impact = [
  '1 potential failure prevented',
  '~8 hours of downtime avoided',
  `${formatEur(OVERNIGHT_IMPACT_EUR)} saved`,
  'Production stayed on track',
];

---

<section class="border-t border-white/5 bg-navy-950 py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-bold tracking-tight sm:text-5xl 2xl:text-6xl">
        <span class="text-offwhite">While the dayshift</span>
        <span class="text-teal-400">sleep…</span>
      </h2>
      <p class="mt-4 text-lg text-muted">The system is able to monitor the machines all night.</p>
      <span class="mt-4 inline-flex rounded-full border border-teal-400/50 px-2.5 py-0.5 text-[0.65rem] font-medium text-teal-300">
        Illustrative example
      </span>
    </div>

    <!-- Timeline: horizontal on lg, stacked on mobile. Human review (2026-07-23):
         a one-time animated reveal when this scrolls into view — Drift Detected
         flashes red and holds red, a white light travels node to node lighting
         each one, and System Healthy flashes green at the end. Needs a small
         IntersectionObserver script (below) to trigger it once; without JS (or
         once it's played) it just holds today's plain teal dots / settled colors
         — never a broken or half-lit state. -->
    <!-- lg:gap-0 is load-bearing: .timeline-glow's left:10/30/50/70/90% assumes
         5 equal-width, gap-less columns. Any nonzero column gap eats pixels
         unevenly (the middle column stays exactly centered, the others drift),
         so the glow orb stops lining up with its dot everywhere but the
         center. Column spacing comes from each item's own max-w-[9rem] + mx-auto
         instead. -->
    <ol class="timeline relative mt-14 grid gap-10 lg:grid-cols-5 lg:gap-0" data-timeline>
      <div class="absolute left-0 right-0 top-[7px] hidden h-px bg-gradient-to-r from-transparent via-teal-400/40 to-transparent lg:block" aria-hidden="true"></div>
      <!-- Vertical connecting line, mobile/tablet only — same fading-gradient
           technique as the horizontal line above (via-color peak in the
           middle, transparent at both ends), so it doesn't need to land on
           the exact pixel of the first/last dot to read as "a line through
           the dots" (human-requested, 2026-07-30: center the stacked
           timeline and give it a real connecting line, not just left-aligned
           bare dots). -->
      <div class="absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2 bg-gradient-to-b from-transparent via-teal-400/40 to-transparent lg:hidden" aria-hidden="true"></div>
      <span class="timeline-glow" aria-hidden="true"></span>
      {
        beats.map((b) => (
          <li class="relative pt-6 text-center">
            <span class="absolute left-1/2 top-0 h-3.5 w-3.5 -translate-x-1/2" aria-hidden="true">
              <span class="timeline-dot block h-full w-full rounded-full border-2 border-teal-400 bg-navy-950"></span>
            </span>
            <p class="text-xs font-medium tracking-wide text-muted/70">{b.time}</p>
            <h3 class="mt-1 text-sm font-semibold text-teal-400">{b.title}</h3>
            <p class="mx-auto mt-1 max-w-[9rem] text-xs leading-relaxed text-muted">{b.body}</p>
          </li>
        ))
      }
    </ol>

    <!-- 3-column: impact / avatar / summary -->
    <div class="mt-16 grid gap-6 lg:grid-cols-3">
      <!-- Overnight Impact. justify-center: the center card's height is now driven
           by the maintenance-lead photo (taller than this card's own content), so
           this content is vertically centered in the stretched grid cell instead
           of pinning to the top and leaving dead space below.

           Card shell always visible, content gated (human-requested,
           2026-08-07 — same reasoning and same `.reveal-story` mechanism as
           Morning Summary just below: this tally of what the night cost IS
           the story's payoff too, not something that should be legible
           while the timeline is still mid-incident). Staggered slightly
           AFTER Morning Summary's own reveal (`.reveal-story--delayed`
           here, plain `.reveal-story` there — reversed 2026-08-11,
           human-requested: Morning Summary now lands first, this tally
           settles in 480ms later) so the two payoff cards still cascade
           rather than popping in simultaneously. -->
      <div class="flex h-full flex-col justify-center rounded-xl border border-white/10 bg-navy-800/40 p-6">
        <!-- mx-auto max-w-xs (human-requested, 2026-08-11): the outer card's
             justify-center above only ever centered this block VERTICALLY —
             horizontally it filled the card's full width, and since the
             bullet list/footnotes are short phrases that don't need that
             much room, the block read as flush-left with a slab of empty
             space to its right rather than centered in the card. Text stays
             left-aligned WITHIN this narrower block (unchanged — the bullet
             list still "genuinely reads better left-aligned," see the
             Morning Summary comment below for why that card, unlike this
             one, also centers its text); only the block itself is now
             centered as a unit. -->
        <div class="reveal-story reveal-story--delayed mx-auto w-full max-w-xs" data-overnight-impact>
          <div class="mb-4">
            <h3 class="text-lg font-semibold text-offwhite">Overnight Impact</h3>
            <span class="mt-2 inline-flex rounded-full border border-teal-400/50 px-2.5 py-0.5 text-[0.65rem] font-medium text-teal-300">
              Illustrative example
            </span>
          </div>
          <ul class="space-y-2.5">
            {
              impact.map((item) => (
                <li class="flex items-start gap-2 text-sm text-muted">
                  <svg class="mt-0.5 shrink-0 text-teal-400" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-xs italic text-muted/60">
            A walkthrough of one night — not aggregated customer data.
          </p>
          <p class="mt-3 border-t border-white/5 pt-3 text-xs text-muted">
            Try your own numbers in <a href="#savings-calculator" class="underline decoration-teal-300/30 underline-offset-2 hover:text-teal-200">the calculator below ↓</a>.
          </p>
        </div>
      </div>

      <!-- Illustration + Morning Summary share this wrapper (added 2026-08-07,
           human-requested) purely so the trace-line SVG below has one common
           `position: relative` ancestor to draw across — they were previously
           two independent grid siblings with a gap between them, which an
           absolutely-positioned line can't span without knowing exact
           cross-column pixel offsets. `lg:col-span-2 lg:grid-cols-2` at the
           OUTER 3-col grid's own lg breakpoint reproduces the identical
           visual layout as before (still effectively 3 equal-width columns
           at lg — this wrapper just internally re-splits its own 2/3 share
           into the same two panels), so this is a structural change for the
           trace line's benefit, not a visual one. Below lg it's a plain
           single-column stack, same as before. -->
      <div class="relative grid gap-6 lg:col-span-2 lg:grid-cols-2" data-tablet-trace>
        <!-- Illustration: anonymous maintenance lead, faceless/seen-from-behind,
             checking an abstract dashboard on a factory floor (no photo of a
             real person — docs/IMAGE_ASSETS.md item 4). mx-auto + max-w-sm below
             lg: this grid is single-column until lg (same breakpoint as the
             Overnight Impact/Morning Summary cards either side of it), so
             without a cap the square image stretched to the full row width —
             on a tablet-width viewport (e.g. iPad portrait) that's a
             near-viewport-height image (human-requested, 2026-07-30). At lg
             the column itself is already narrow enough, so the cap is lifted.
             data-trace-start: the trace line's own start point is computed
             from THIS element's rect (below), not a hardcoded pixel value —
             see the script's own comment for why. -->
        <div
          class="mx-auto w-full max-w-sm overflow-hidden rounded-xl border border-white/10 bg-gradient-to-b from-navy-800/60 to-navy-900 lg:max-w-none"
          data-trace-start
        >
          <Image
            src={maintenanceLead}
            alt="A maintenance lead, seen from behind with no identifiable face, checking an abstract glowing dashboard on a tablet on a factory floor at night."
            widths={[320, 480]}
            sizes="(min-width: 1024px) 33vw, 90vw"
            class="aspect-square w-full object-cover"
          />
        </div>

        <!-- Morning Summary. CTA deliberately reads "See the dashboard" rather than the
             site's standard "See it in action" (human review, 2026-07-23) — this one
             button mirrors the exact action the maintenance lead takes in the story
             beat above it, an intentional one-off exception to the settled two-verb
             CTA label, not a new third verb introduced sitewide. justify-center
             for the same reason as the Overnight Impact card: keeps content
             centered in the taller, photo-driven row instead of top-pinned. -->
        <!-- Card shell (border/background/padding) stays visible at all
             times, unlike the CONTENT inside it — human-requested follow-up,
             2026-08-07: hiding the whole card left this grid cell empty
             before the story resolves, breaking the always-3-panels
             composition the Overnight Impact card and illustration keep up
             their end of. Only `.ms-reveal` (the inner wrapper just below)
             answers to `[data-timeline].is-story-complete`; this outer div
             is permanently part of the layout, exactly like its two
             siblings. -->
        <div class="flex h-full flex-col justify-center rounded-xl border border-white/10 bg-navy-800/40 p-6">
          <!-- Held back until the timeline story actually resolves (human-
               requested, 2026-08-07: "have it only appear after the last
               light has passed into system healthy... hide the whole
               morning summary and see the dashboard button until then") —
               this content, and the tablet trace line, are the STORY'S
               PAYOFF (the night's work resolving into "here's what
               happened"), so showing them before System Healthy has even
               flashed green undercuts the beat.

               `.ms-reveal` (this card's own wrapper, not the shared
               `.reveal-story` Overnight Impact still uses) starts
               `visibility: hidden` and flips to visible the instant
               `[data-timeline].is-story-complete` is set — no opacity/scale
               transition of its own. Human-requested, 2026-08-11: rather
               than the whole card fading in as one flat block, each piece
               inside now plays its own staggered entrance (heading + badge
               first, then "No incidents.", then "Model upgraded
               overnight.", then the CTA — see the <style> block below for
               the full sequence), so `.ms-reveal` only needs to hand off
               "reachable now" to its children; the actual visual reveal is
               entirely theirs. Overnight Impact didn't ask for this
               treatment, so it keeps the original shared `.reveal-story`
               single-fade mechanism unchanged — a fork of just this card's
               wrapper class, not a change to the shared one. -->
          <!-- items-center text-center (human-requested, 2026-08-07: this
               card "sits completely to the left instead of being centered or
               making use of the card") — flex-col's own justify-center on
               the outer card only ever centered these children VERTICALLY;
               with no align-items set, they stretched full-width and their
               text/inline content packed to the left edge by default,
               reading as left-hugged rather than a balanced confirmation
               card. Unlike Overnight Impact's bullet list (genuinely reads
               better left-aligned), this content — a title, one short status
               line, one CTA — is short and self-contained enough that
               centering it uses the card's width instead of just occupying
               its left edge. -->
          <div class="ms-reveal flex flex-col items-center text-center" data-morning-summary>
            <h3 class="ms-heading text-lg font-semibold text-offwhite">Morning Summary</h3>
            <div class="mt-4 flex items-center gap-3">
              <!-- data-trace-end: the line's arrival point. This badge is
                   what the trace visually "delivers" the tablet's data into.
                   relative z-10 (human-requested, 2026-08-07): the trace SVG
                   is a later DOM sibling of the outer card (see
                   data-trace-svg below), so without an explicit z-index here
                   it painted OVER this badge's own ring regardless of how
                   precisely the line's endpoint math stopped at the circle's
                   edge — DOM order, not geometry, was deciding paint order.
                   A positioned element with an explicit z-index always
                   outranks a sibling left at the default z-index:auto,
                   independent of DOM order, so this alone is enough to put
                   the badge back on top without touching the SVG's own
                   stacking at all.

                   ms-badge fades in opacity-only, deliberately no
                   scale/translate (human-requested sequenced reveal,
                   2026-08-11) — the trace-line script below measures this
                   exact element's getBoundingClientRect() the instant the
                   story completes, in the same synchronous tick this badge's
                   entrance animation starts; a transform here would be
                   measured mid-animation and hand the trace line a stale
                   size/position. Opacity doesn't affect layout geometry at
                   all, so it's the one safe axis to animate on this
                   specific element. -->
              <span
                class="ms-badge relative z-10 inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-teal-400 text-teal-400"
                data-trace-end
              >
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path class="ms-check-path" pathLength="1" d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <p class="text-left text-sm text-muted">
                <span class="subtitle-line subtitle-line--1">No incidents.</span>
                <span class="subtitle-line subtitle-line--2">Model upgraded overnight.</span>
              </p>
            </div>
            <!-- Glassmorphic, not the site's usual solid-teal CTA
                 (human-requested, 2026-08-07: "more modern button style" —
                 picked from a set of concrete options). Deliberately a
                 one-off .btn-glass rather than a new Button.astro variant:
                 this button is already a one-off exception to the site's
                 two-verb CTA system (see the markup comment on this card
                 above), so a matching one-off visual treatment doesn't
                 introduce a third pattern other CTAs might reach for. */ -->
            <a href={withBase('/product')} class="ms-cta btn-glass mt-6 inline-flex items-center justify-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold">
              See the dashboard →
            </a>
          </div>
        </div>

        <!-- Watch Dogs 2-style data trace (human-requested, 2026-08-07: "that
             kind of watchdogs 2 white tracing line", same reticle family as
             Hero.astro's target-lock corners — white, self-drawing, Apple-
             sophisticated rather than glitch/scan-line). Desktop-only: below
             lg the two panels stack vertically in one column and read fine on
             their own without a connecting line; the line's whole point is
             showing a spatial relationship that only exists once they're
             side-by-side. Coordinates are set by the script below via
             getBoundingClientRect on data-trace-start/data-trace-end, not
             hardcoded percentages — a hardcoded guess can't account for the
             two panels' own heights differing (the image is a fixed square,
             the card's height is content-driven) or for the wrapper resizing
             between lg and 2xl.

             Pushed further "Watch Dogs 2" (human-requested follow-up,
             2026-08-07) with the two things that actually read as a live data
             trace rather than a plain connector line: a corner-bracket lock
             at the tablet end (data-trace-reticle — identical technique to
             Hero.astro's own target-lock corners, reused rather than
             reinvented, now that it's a documented pattern in
             ANIMATION_SCRAPBOOK.md) and a small dot that continuously travels
             the line once it's drawn (data-trace-pulse), the same "data/
             energy flowing" cue as the scrapbook's traveling-dot entry. The
             badge end doesn't get its own bracket — its existing circular
             border already reads as a lock-on target, a second bracket there
             would be redundant. -->
        <svg class="tablet-trace hidden lg:block" data-trace-svg aria-hidden="true">
          <line data-trace-line pathLength="1" x1="0" y1="0" x2="0" y2="0" />
          <g class="tablet-trace-reticle" data-trace-reticle>
            <path pathLength="1" d="M-10 -3V-10H-3" />
            <path pathLength="1" d="M3 -10H10V-3" />
            <path pathLength="1" d="M10 3V10H3" />
            <path pathLength="1" d="M-3 10H-10V3" />
          </g>
          <circle class="tablet-trace-pulse" data-trace-pulse r="2.5" />
        </svg>
      </div>
    </div>

    <p class="mt-14 text-center text-2xl font-semibold sm:text-3xl">
      <span class="text-offwhite">One system.</span>
      <span class="text-teal-400">Always learning.</span>
      <span class="text-offwhite">Always protecting.</span>
    </p>
  </div>
</section>

<script>
  // Plays the timeline reveal once, the first time it's ~40% visible — a story
  // beat, not a decoration that should replay every time someone scrolls past.
  // Bound to astro:page-load, not top-level: this section lives inside <main>,
  // which isn't transition:persist-ed, so a fresh <script> arrives every time
  // a visitor navigates back to "/" via a client-side transition, not just on
  // the first hard load — astro:page-load fires in both cases.
  document.addEventListener('astro:page-load', () => {
    const timeline = document.querySelector<HTMLElement>('[data-timeline]');
    if (!timeline || timeline.classList.contains('is-playing')) return;

    // The Morning Summary card + tablet trace line are the story's PAYOFF,
    // not an independent beat — they shouldn't appear until System Healthy
    // has actually resolved (human-requested, 2026-08-07). `story-complete`
    // (a plain DOM CustomEvent, not a shared module import — this file's
    // two <script> blocks are two independent inline scripts, no bundler
    // graph connects them) is what the trace-line script below listens for
    // instead of triggering on its own separate scroll-into-view. 4500ms
    // matches the timeline's own documented total run (see .timeline-glow's
    // comment) — if that schedule ever changes, this needs to move with it.
    function play() {
      timeline!.classList.add('is-playing');
      window.setTimeout(() => {
        timeline!.classList.add('is-story-complete');
        timeline!.dispatchEvent(new CustomEvent('story-complete', { bubbles: true }));
      }, 4500);
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              play();
              observer.disconnect();
            }
          }
        },
        { threshold: 0.4 }
      );
      observer.observe(timeline);
    } else {
      // No IntersectionObserver support — skip the travel/dot-flash
      // animation, but still fire story-complete on the same schedule so
      // the Morning Summary reveal and trace line stay consistent rather
      // than either never appearing or appearing with no story at all.
      play();
    }
  });

  // Tablet-to-Morning-Summary trace line — a separate listener, not folded
  // into the one above (different elements, different concerns), but
  // sequenced by it: reveals only once the timeline's own 'story-complete'
  // event fires (see that script's comment above), not on its own
  // independent scroll trigger. Layout math is computed via
  // getBoundingClientRect rather than hardcoded percentages — the two
  // panels it connects have different heights (the illustration is a fixed
  // square, the Morning Summary card's height is content-driven), so a
  // straight percentage-of-wrapper guess can't land on both the tablet's
  // actual glow point and the badge's actual center at once, and would
  // drift further wrong at 2xl where the wrapper itself is wider.
  document.addEventListener('astro:page-load', () => {
    const wrapper = document.querySelector<HTMLElement>('[data-tablet-trace]');
    const svg = wrapper?.querySelector<SVGSVGElement>('[data-trace-svg]');
    const line = wrapper?.querySelector<SVGLineElement>('[data-trace-line]');
    const reticle = wrapper?.querySelector<SVGGElement>('[data-trace-reticle]');
    const pulse = wrapper?.querySelector<SVGCircleElement>('[data-trace-pulse]');
    const startEl = wrapper?.querySelector<HTMLElement>('[data-trace-start]');
    const endEl = wrapper?.querySelector<HTMLElement>('[data-trace-end]');
    if (!wrapper || !svg || !line || !reticle || !pulse || !startEl || !endEl) return;

    function layout() {
      const wrapperRect = wrapper!.getBoundingClientRect();
      const startRect = startEl!.getBoundingClientRect();
      const endRect = endEl!.getBoundingClientRect();

      // Tablet glow point (corrected 2026-08-07 — human-reported: the line
      // was starting from a machine in the background, not the tablet). The
      // original 80%/40% guess was the single brightest PIXEL in the source
      // photo, which turned out to be an isolated stray highlight elsewhere
      // in the scene — a real screen glow is a coherent bright AREA, not one
      // pixel. Block-averaging brightness across the image instead (scripts/
      // one-off analysis, not run at build time) found a clear cluster of
      // bright pixels around 50%/56% — center-ish, waist-height — which also
      // just makes more physical sense for a tablet held by a person seen
      // from behind than a point 80% over toward the frame's edge.
      const startX = startRect.left - wrapperRect.left + startRect.width * 0.5;
      const startY = startRect.top - wrapperRect.top + startRect.height * 0.56;

      // End point: the circle's EDGE closest to the line's start, not its
      // center (human-reported, 2026-08-07 — the line was piercing through
      // to the middle of the badge instead of stopping at its border). Pull
      // the raw center-point back along the start→center direction by
      // exactly the circle's own radius, so the line always lands flush on
      // the ring regardless of the angle it's approaching from.
      const centerX = endRect.left - wrapperRect.left + endRect.width / 2;
      const centerY = endRect.top - wrapperRect.top + endRect.height / 2;
      const radius = endRect.width / 2;
      const dx = centerX - startX;
      const dy = centerY - startY;
      const dist = Math.hypot(dx, dy) || 1;
      const endX = centerX - (dx / dist) * radius;
      const endY = centerY - (dy / dist) * radius;

      svg!.setAttribute('width', String(wrapperRect.width));
      svg!.setAttribute('height', String(wrapperRect.height));
      svg!.setAttribute('viewBox', `0 0 ${wrapperRect.width} ${wrapperRect.height}`);
      line!.setAttribute('x1', String(startX));
      line!.setAttribute('y1', String(startY));
      line!.setAttribute('x2', String(endX));
      line!.setAttribute('y2', String(endY));
      // Reticle is a <g> of fixed-shape corner paths — repositioning it is
      // one `transform`, not four path-d recalculations.
      reticle!.setAttribute('transform', `translate(${startX}, ${startY})`);
      // offset-path takes the pulse dot along the SAME two points the visible
      // line connects, kept in sync on every layout() call rather than drawn
      // once — the line's own geometry can change (window resize, content
      // reflow before the two panels' heights settle), and a stale offset-
      // path would send the "data" dot gliding along a line that no longer
      // matches what's actually drawn.
      pulse!.style.offsetPath = `path("M ${startX} ${startY} L ${endX} ${endY}")`;
    }

    layout();
    window.addEventListener('resize', layout);

    if (wrapper.classList.contains('is-traced')) return;
    // Reveals on the timeline's own 'story-complete' signal, not a separate
    // IntersectionObserver — by the time that fires, the timeline has
    // already been 40%-visible for 4.5s, so the panels below it are
    // reliably in view too; this doesn't need its own visibility check on
    // top of that, just the "wait for the story to finish" gate.
    document.addEventListener(
      'story-complete',
      () => {
        layout(); // recompute right before reveal in case layout shifted meanwhile
        wrapper.classList.add('is-traced');
      },
      { once: true }
    );
  });
</script>

<style>
  /* Morning Summary's own sequenced reveal (human-requested, 2026-08-11,
     replacing a first pass that faded the whole card in as one flat block —
     which itself replaced an earlier infinite gray/black shimmer sweep that
     read as a loading skeleton, not a resolved payoff, and leaned on raw
     one-off hex instead of Contract 4 tokens).

     `.ms-reveal` (the card's outer wrapper) does none of the animating
     itself — it's a plain visibility gate (see the markup comment on
     data-morning-summary above for why it's a fork of `.reveal-story`
     rather than a change to it). Everything below plays off the SAME
     trigger selector, `[data-timeline].is-story-complete ~ .mt-16 <thing>`,
     each with its own `animation-delay` — one shared moment, five staggered
     entrances, reading as a HUD panel booting up in sequence rather than a
     single fade:

       0ms    badge ring + "Morning Summary" heading (heading rises into
              its natural position from a few px lower — the "moves up to
              make room" motion — while the badge fades in alongside it)
       180ms  checkmark draws itself inside the ring (SVG stroke-dashoffset,
              same technique as this file's own trace-line reticle)
       650ms  "No incidents." settles in, a beat after the heading finishes
              rising (460ms) rather than landing the instant it does —
              human-requested slowdown, 2026-08-11: the original 460ms had
              this arriving in the same breath as the heading, reading as
              one event instead of two
       1050ms "Model upgraded overnight." follows (400ms after the line
              above, also widened from the original 240ms gap)
       1450ms the CTA arrives last, 400ms after that (widened from 300ms) —
              the one moment that gets `--ease-spring` (the site's
              "discovery" easing) — every earlier stage stays on the calmer
              `--ease-ios`/`--ease-ios-in-out` decelerate curves, since
              using spring on every stage would read as bouncy rather than
              considered.

     `animation-play-state` (paused → running via the shared trigger), not a
     plain delayed `animation`, so nothing starts its own clock while still
     hidden behind the timeline story — same reasoning `.reveal-story`
     itself already relies on. */
  .ms-reveal {
    visibility: hidden;
  }
  [data-timeline].is-story-complete ~ .mt-16 .ms-reveal {
    visibility: visible;
  }

  /* Heading rises from a few px below its resting spot rather than fading
     in flat — 32px is an eyeballed "it was sitting closer to the badge"
     offset, not a measured value (this sandbox can't render a browser to
     check the real rendered gap — flag it for a visual nudge if it reads as
     too much or too little). */
  .ms-heading {
    animation: ms-heading-in 460ms var(--ease-ios) both;
    animation-play-state: paused;
  }
  @keyframes ms-heading-in {
    from { opacity: 0; transform: translateY(32px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Opacity-only, deliberately no scale/translate — see the markup comment
     on data-trace-end above for why a transform here would corrupt the
     trace-line script's getBoundingClientRect() measurement. */
  .ms-badge {
    animation: ms-badge-in 340ms var(--ease-ios) both;
    animation-play-state: paused;
  }
  @keyframes ms-badge-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Checkmark draws itself in, same pathLength="1" + stroke-dashoffset
     technique as this file's own trace-line reticle and Hero.astro's
     target-lock corners — a `transition`, not a keyframe `animation`,
     since it's a simple one-shot property flip driven by the class change,
     no intermediate stops needed. */
  .ms-check-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 420ms var(--ease-ios) 180ms;
  }
  [data-timeline].is-story-complete ~ .mt-16 .ms-check-path {
    stroke-dashoffset: 0;
  }

  .subtitle-line {
    display: block;
    animation: subtitle-line-in 550ms var(--ease-ios-in-out) both;
    animation-play-state: paused;
  }
  .subtitle-line--1 {
    animation-delay: 650ms;
  }
  .subtitle-line--2 {
    animation-delay: 1050ms;
  }
  [data-timeline].is-story-complete ~ .mt-16 .subtitle-line {
    animation-play-state: running;
  }
  @keyframes subtitle-line-in {
    0% { transform: translateY(8px); filter: brightness(1); }
    45% { transform: translateY(0); filter: brightness(1); }
    58% { filter: brightness(2.4); }
    100% { transform: translateY(0); filter: brightness(1); }
  }

  /* CTA arrives last, and is the one stage that gets --ease-spring — see
     the comment above on why the rest of this sequence deliberately stays
     off it. position/overflow here are for the glint pseudo-element below,
     not the entrance animation. */
  .ms-cta {
    position: relative;
    overflow: hidden;
    animation: ms-cta-in 420ms var(--ease-spring) both;
    animation-play-state: paused;
    animation-delay: 1450ms;
  }
  @keyframes ms-cta-in {
    0% { opacity: 0; transform: translateY(10px) scale(0.92); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  /* Gentle shimmer (human-requested, 2026-08-11) — a soft diagonal glint
     gliding across the glass surface roughly every 5.5s, not a continuous
     scan: this card's OWN comment above already documents rejecting that
     once — an earlier infinite gray/black shimmer sweep read as a loading
     skeleton, not a resolved payoff, and leaned on raw hex instead of
     Contract 4 tokens. Long holds at each end of the keyframe (0-55% held
     off-screen left, 85-100% held off-screen right) are what make this
     read as an occasional gleam rather than a scanner. A `::after` layers
     the highlight OVER the existing glass fill and teal-300 text rather
     than repeating the earlier attempt's text-fill-color trick, so neither
     needs to change. overflow:hidden on .ms-cta above clips the sweep to
     the button's own rounded corners; pointer-events:none keeps it from
     ever intercepting the click. Starts at 1870ms — 1450ms entrance delay
     + 420ms entrance duration — so it only begins once the button has
     actually finished popping in, gated by the same play-state trigger as
     the rest of this sequence rather than its own independent timer. */
  .ms-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 42%,
      color-mix(in srgb, var(--color-offwhite) 35%, transparent) 50%,
      transparent 58%
    );
    pointer-events: none;
    /* backwards: without it, the ~1870ms delay before the first sweep has
       no fill-mode telling the browser what to render meanwhile, so it
       falls through to the un-animated default — transform: none, i.e. the
       gradient sitting statically dead-center on the button — which is
       exactly the "grey smudge that clears up after a moment" bug this
       fixed (human-reported, 2026-08-11). `backwards` applies the 0%
       keyframe's translateX(-130%) for the whole delay, so it stays
       off-screen and invisible until the real sweep actually starts. */
    animation: ms-cta-shimmer 5.5s var(--ease-ios-in-out) infinite backwards;
    animation-play-state: paused;
    animation-delay: 1870ms;
  }
  @keyframes ms-cta-shimmer {
    0%, 55% { transform: translateX(-130%); }
    85%, 100% { transform: translateX(130%); }
  }
  [data-timeline].is-story-complete ~ .mt-16 .ms-heading,
  [data-timeline].is-story-complete ~ .mt-16 .ms-badge,
  [data-timeline].is-story-complete ~ .mt-16 .ms-cta,
  [data-timeline].is-story-complete ~ .mt-16 .ms-cta::after {
    animation-play-state: running;
  }
  @media (prefers-reduced-motion: reduce) {
    .ms-heading,
    .ms-badge,
    .ms-check-path,
    .subtitle-line,
    .ms-cta,
    .ms-cta::after {
      animation: none;
      transition: none;
    }
  }

  /* No staggered cascade below lg (human-requested, 2026-08-11) — the
     5-stage sequence above (badge/heading, checkmark, "No incidents.",
     "Model upgraded overnight.", CTA, ~1.9s end to end) reads as considered
     on a wide desktop card but as sluggish on a phone, where the visitor has
     already waited through the timeline's own 4.5s animation and just wants
     the payoff. Zeroing every stage's delay — not disabling the animations
     outright, unlike the reduced-motion block above — keeps each element's
     own fade/rise/flicker, they just all play at once instead of in
     sequence: one simultaneous reveal rather than a multi-second cascade.
     `lg` matches every other mobile/desktop split in this file (the trace
     line and its reticle are also lg-only) rather than introducing a new
     breakpoint. */
  @media (max-width: 1023px) {
    .subtitle-line--1,
    .subtitle-line--2,
    .ms-cta {
      animation-delay: 0ms;
    }
    .ms-check-path {
      transition: stroke-dashoffset 420ms var(--ease-ios);
    }
  }

  /* Traveling light: dwells at each node for exactly that node's own flash
     duration, then moves at a constant (linear) speed to the next — so the
     orb never sits glowing on a dot that's already cooled back to teal, and
     never looks like it's still gliding in when the flash fires. Total run
     is 4.5s: dot delays/durations below and the timeline-travel keyframe
     percentages are both derived from the same schedule —
     0s dwell(.6s) -> 1.1s dwell(.4s) -> 2.0s dwell(.4s) -> 2.9s dwell(.4s)
     -> 3.8s dwell(.7s) -> 4.5s, with a flat 0.5s linear travel between each
     dwell. Change one side, recompute the other. Desktop-only, same
     breakpoint as the horizontal line it rides (§12 — the line itself is
     lg:block-only). */
  .timeline-glow {
    position: absolute;
    top: 7px;
    left: 10%;
    transform: translate(-50%, -50%);
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    background-color: #fff;
    box-shadow:
      0 0 16px 6px rgba(255, 255, 255, 0.95),
      0 0 34px 12px color-mix(in srgb, var(--color-teal-400) 60%, transparent);
    opacity: 0;
    display: none;
  }
  @media (min-width: 1024px) {
    .timeline-glow {
      display: block;
    }
  }

  .timeline.is-playing .timeline-glow {
    animation: timeline-travel 4.5s linear forwards;
  }
  /* :nth-of-type, not :nth-child — the ol's connecting-line <div> and the
     .timeline-glow <span> both precede the <li>s, so :nth-child(1..5) never
     matched the real list items at all (Drift Detected and Pipeline
     Triggered got no animation; System Healthy's rule landed on Model
     Retrained instead). :nth-of-type counts only among <li> siblings, so
     it's immune to whatever non-<li> markup sits in front of them. */
  .timeline.is-playing li:nth-of-type(1) .timeline-dot {
    animation: timeline-dot-alert 0.6s ease-out forwards;
  }
  .timeline.is-playing li:nth-of-type(2) .timeline-dot {
    animation: timeline-dot-lit 0.4s ease-out 1.1s forwards;
  }
  .timeline.is-playing li:nth-of-type(3) .timeline-dot {
    animation: timeline-dot-lit 0.4s ease-out 2s forwards;
  }
  .timeline.is-playing li:nth-of-type(4) .timeline-dot {
    animation: timeline-dot-lit 0.4s ease-out 2.9s forwards;
  }
  .timeline.is-playing li:nth-of-type(5) .timeline-dot {
    animation: timeline-dot-resolve 0.7s ease-out 3.8s forwards;
  }

  @keyframes timeline-travel {
    0% {
      left: 10%;
      opacity: 0;
      background-color: var(--color-alert-400);
      box-shadow:
        0 0 16px 6px color-mix(in srgb, var(--color-alert-400) 95%, transparent),
        0 0 34px 12px color-mix(in srgb, var(--color-alert-400) 60%, transparent);
    }
    3.33% {
      opacity: 1;
    }
    13.33% {
      /* Drift Detected's flash has settled to red by now — the orb holds that
         same red until it starts moving, then morphs to white over the
         travel to Pipeline Triggered (24.44%), handing off from "alarm" to
         "the pipeline is now doing its normal work". */
      left: 10%;
      opacity: 1;
    }
    24.44% {
      left: 30%;
      background-color: #fff;
      box-shadow:
        0 0 16px 6px rgba(255, 255, 255, 0.95),
        0 0 34px 12px color-mix(in srgb, var(--color-teal-400) 60%, transparent);
    }
    33.33% {
      left: 30%;
    }
    44.44% {
      left: 50%;
    }
    53.33% {
      left: 50%;
    }
    64.44% {
      left: 70%;
    }
    73.33% {
      left: 70%;
    }
    84.44% {
      left: 90%;
      opacity: 1;
    }
    88.89% {
      left: 90%;
      opacity: 0;
    }
    100% {
      left: 90%;
      opacity: 0;
    }
  }

  /* Drift Detected: flashes alert-red, holds red — the one node that stays an
     alert color rather than settling back to teal. */
  @keyframes timeline-dot-alert {
    0% {
      border-color: var(--color-teal-400);
      background-color: var(--color-navy-950);
      box-shadow: none;
      transform: scale(1);
    }
    35% {
      border-color: var(--color-alert-400);
      background-color: var(--color-alert-400);
      box-shadow:
        0 0 14px 5px color-mix(in srgb, var(--color-alert-400) 90%, transparent),
        0 0 32px 14px color-mix(in srgb, var(--color-alert-400) 55%, transparent);
      transform: scale(1.85);
    }
    100% {
      border-color: var(--color-alert-400);
      background-color: var(--color-alert-400);
      box-shadow: 0 0 12px 4px color-mix(in srgb, var(--color-alert-400) 60%, transparent);
      transform: scale(1);
    }
  }

  /* Pipeline Triggered / Model Retrained / Model Promoted: the traveling light
     arrives, flashes white, and settles white too — a neutral "in progress"
     color deliberately distinct from the two colored states that bookend the
     story (Drift Detected's red, System Healthy's green), so those two read
     as the meaningful states rather than blending into a five-dot rainbow. */
  @keyframes timeline-dot-lit {
    0% {
      border-color: var(--color-teal-400);
      background-color: var(--color-navy-950);
      box-shadow: none;
      transform: scale(1);
    }
    50% {
      border-color: #fff;
      background-color: #fff;
      box-shadow:
        0 0 20px 7px rgba(255, 255, 255, 0.95),
        0 0 38px 16px rgba(255, 255, 255, 0.4);
      transform: scale(1.75);
    }
    100% {
      border-color: #fff;
      background-color: #fff;
      box-shadow: 0 0 8px 3px rgba(255, 255, 255, 0.5);
      transform: scale(1);
    }
  }

  /* System Healthy: the story's resolution — flashes success-green, holds green. */
  @keyframes timeline-dot-resolve {
    0% {
      border-color: var(--color-teal-400);
      background-color: var(--color-navy-950);
      box-shadow: none;
      transform: scale(1);
    }
    40% {
      border-color: var(--color-success-400);
      background-color: var(--color-success-400);
      box-shadow:
        0 0 16px 6px color-mix(in srgb, var(--color-success-400) 90%, transparent),
        0 0 36px 15px color-mix(in srgb, var(--color-success-400) 55%, transparent);
      transform: scale(1.85);
    }
    100% {
      border-color: var(--color-success-400);
      background-color: var(--color-success-400);
      box-shadow: 0 0 10px 3px color-mix(in srgb, var(--color-success-400) 60%, transparent);
      transform: scale(1);
    }
  }

  /* Tablet → Morning Summary trace line (human-requested, 2026-08-07 —
     same "Watch Dogs 2, but Apple-sophisticated" reticle family as
     Hero.astro's target-lock corners: white, self-drawing via
     pathLength="1" + stroke-dashoffset, no scan-line/glitch effect).
     x1/y1/x2/y2 are set by the script above from real getBoundingClientRect
     measurements — this block only owns the drawn-in *look*, not the
     geometry. overflow: visible on the wrapper isn't needed since the line
     stays fully inside the wrapper's own box by construction (both
     endpoints are measured relative to it). */
  .tablet-trace {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .tablet-trace line {
    stroke: #fff;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.6));
    transition: stroke-dashoffset var(--dur-slow) var(--ease-ios);
  }
  /* Corner-bracket "lock" on the tablet's own glow point — identical
     technique to Hero.astro's target-lock reticle (four short paths,
     pathLength="1" self-draw), reused rather than reinvented now that it's
     documented in ANIMATION_SCRAPBOOK.md. Arrives just after the line
     finishes drawing, not at the same instant — "here's where it started"
     reads as a beat that follows the line, not a simultaneous flash
     competing with it for attention. Positioned via the `<g>`'s own
     `transform` (set in the script above), so these four paths keep fixed,
     never-recalculated local coordinates regardless of where the tablet
     point actually lands on screen. */
  .tablet-trace-reticle path {
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.7));
    transition: stroke-dashoffset var(--dur-base) var(--ease-ios) var(--dur-slow),
      opacity var(--dur-fast) var(--ease-ios) var(--dur-slow);
  }
  .tablet-trace-reticle path:nth-child(2) { transition-delay: calc(var(--dur-slow) + 40ms); }
  .tablet-trace-reticle path:nth-child(3) { transition-delay: calc(var(--dur-slow) + 80ms); }
  .tablet-trace-reticle path:nth-child(4) { transition-delay: calc(var(--dur-slow) + 120ms); }

  /* The traveling pulse (human-requested follow-up, 2026-08-07 — "more
     Watch Dogs 2 like"): a small dot gliding the line's own path on a slow
     loop, the same "data/energy flowing" cue as this scrapbook's own
     traveling-dot pattern (docs/ANIMATION_SCRAPBOOK.md, Path-based motion).
     This — not just a static connector line — is the actual detail that
     reads as "live data trace" rather than "a line was drawn between two
     things." offset-path is set by the script above to match the line's
     real x1/y1/x2/y2 exactly, so the dot never drifts off the visible
     stroke. Starts only once the line/reticle have finished their own
     draw-in (animation-delay stacks on top of --dur-slow the same way the
     reticle's transition-delay does), and loops gently rather than racing
     back and forth — an ambient "still syncing" read, not an alert. */
  .tablet-trace-pulse {
    fill: #fff;
    opacity: 0;
    filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.9));
  }
  [data-tablet-trace].is-traced .tablet-trace line {
    stroke-dashoffset: 0;
  }
  [data-tablet-trace].is-traced .tablet-trace-reticle path {
    stroke-dashoffset: 0;
    opacity: 1;
  }
  [data-tablet-trace].is-traced .tablet-trace-pulse {
    animation: tablet-trace-pulse-travel 2.6s var(--ease-ios-in-out) calc(var(--dur-slow) + 300ms) infinite;
  }
  @keyframes tablet-trace-pulse-travel {
    0% { offset-distance: 0%; opacity: 0; }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tablet-trace line,
    .tablet-trace-reticle path,
    .tablet-trace-pulse {
      transition: none;
      animation: none;
    }
  }

  /* Overnight Impact content, held back as the story's payoff (see the
     markup comment on data-overnight-impact above) — hidden via
     opacity+visibility, not display:none, so it keeps occupying its own
     layout position throughout (hiding via display:none would collapse the
     card down to just its own padding), and stays genuinely unreachable —
     not just invisible — to keyboard/screen-reader users until it actually
     appears: visibility, unlike opacity alone, removes an element from both
     hit-testing and the tab order. Fade + a gentle scale-up (--ease-spring,
     this project's own "discovery moment" easing) reads as the sleek/
     Apple-like arrival asked for, not a static cut from invisible to
     visible.

     Morning Summary used to share this exact class too, but now runs its
     own multi-stage sequence instead (`.ms-reveal` + `.ms-heading`/
     `.ms-badge`/`.subtitle-line`/`.ms-cta`, human-requested, 2026-08-11 —
     see that block above) — `.reveal-story`/`--delayed` is Overnight
     Impact-only from here on, not a shared contract between the two cards
     anymore. */
  .reveal-story {
    opacity: 0;
    visibility: hidden;
    transform: scale(0.96);
    transition: opacity var(--dur-slow) var(--ease-ios), transform var(--dur-slow) var(--ease-spring),
      visibility 0s linear var(--dur-slow);
  }
  [data-timeline].is-story-complete ~ .mt-16 .reveal-story {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    transition: opacity var(--dur-slow) var(--ease-ios), transform var(--dur-slow) var(--ease-spring), visibility 0s;
  }
  /* Overnight Impact staggers in after Morning Summary's own sequence has
     actually finished (human-requested "stagger" — recalibrated 2026-08-11
     when Morning Summary switched to the multi-stage sequence above, then
     again the same day when that sequence's own gaps were widened: its last
     stage, the CTA, now lands at 1450ms + 420ms ≈ 1870ms). 1950ms picks up
     shortly after the CTA settles — both cards still read as one cascade,
     just a longer one now that Morning Summary has more to say before
     Overnight Impact's turn. */
  [data-timeline].is-story-complete ~ .mt-16 .reveal-story--delayed {
    transition-delay: 1950ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-story {
      transition: opacity var(--dur-fast) linear, visibility 0s linear var(--dur-fast);
    }
    [data-timeline].is-story-complete ~ .mt-16 .reveal-story--delayed {
      transition-delay: 0s;
    }
  }
  /* No stagger below lg either (human-requested, 2026-08-11, same reasoning
     as Morning Summary's own no-cascade override above) — Overnight Impact
     lands together with Morning Summary instead of ~2s behind it. */
  @media (max-width: 1023px) {
    [data-timeline].is-story-complete ~ .mt-16 .reveal-story--delayed {
      transition-delay: 0s;
    }
  }

  /* Glassmorphic CTA (human-requested, 2026-08-07 — "more modern button
     style," picked from a set of concrete options). Translucent teal tint +
     backdrop-blur instead of the site's usual solid-teal fill; text stays
     light (teal-300) since the background is no longer opaque enough for
     dark navy-950 text to read against it. Hover deepens the tint and adds
     the site's own shared glow-shadow token (--shadow-glow-teal, same one
     Button.astro's solid variant already uses) plus a small lift — kept
     consistent with the rest of the site's hover language rather than
     inventing a new one just for this button. */
  .btn-glass {
    background: color-mix(in srgb, var(--color-teal-400) 16%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--color-teal-400) 40%, transparent);
    color: var(--color-teal-300);
    transition: background-color var(--dur-base) var(--ease-ios), border-color var(--dur-base) var(--ease-ios),
      box-shadow var(--dur-base) var(--ease-ios), transform var(--dur-base) var(--ease-ios);
  }
  .btn-glass:hover {
    background: color-mix(in srgb, var(--color-teal-400) 26%, transparent);
    border-color: color-mix(in srgb, var(--color-teal-400) 65%, transparent);
    box-shadow: var(--shadow-glow-teal);
    transform: translateY(-2px);
  }
  .btn-glass:active {
    transform: translateY(0) scale(0.97);
    transition-duration: var(--dur-fast);
  }
</style>
