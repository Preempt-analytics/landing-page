---
// §9.4 Benefits — 4 tiles. The source screenshots were inconsistent (some light,
// some dark); restyled here into one consistent dark-card/teal-icon system, the
// same fix applied to the hero stat tiles. Maps to #solutions (part 1).
import InfoTip from '../InfoTip.astro';
import { useTranslations, DEFAULT_LOCALE } from '../../i18n';

const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
const t = useTranslations(locale).benefits;

// `eco` is a plain-language aside on the environmental angle of each benefit,
// surfaced via a leaf-icon InfoTip (human-requested, 2026-07-31) — deliberately
// qualitative ("typically", "often"), not invented numbers, matching the site's
// existing honesty stance on illustrative content (see CLAUDE.md's Danger
// Zones on illustrative figures). Icon paths are locale-invariant, so they
// stay here; the text comes from the i18n dictionary, index-matched.
const TILE_ICONS = [
  'M12 7v5l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z',
  'M3 17l6-6 4 4 8-8M21 7v5M21 7h-5',
  // Dollar-sign S-curve was mirror-inverted (human review, 2026-07-28) — verified
  // against a real "$" before fixing; the circle itself was already symmetric.
  'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM14.5 9.5a2.5 2.5 0 0 0-2.5-1.5c-1.4 0-2.5.9-2.5 2s1 1.6 2.5 2 2.5 1 2.5 2-1.1 2-2.5 2a2.5 2.5 0 0 1-2.5-1.5M12 6.5v11',
  'M4 20V12M10 20V6M16 20v-9M22 20H2',
];
const benefits = t.tiles.map((b, i) => ({ ...b, icon: TILE_ICONS[i] }));
---

<section id="solutions" class="scroll-mt-20 border-t border-white/5 bg-navy-900 py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-teal-400">
        {t.eyebrow}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-offwhite sm:text-4xl 2xl:text-5xl">
        {t.heading}
      </h2>
    </div>

    <!-- Icon beside the text (not above it), both vertically centered in the tile —
         matches the mockup's layout (Screenshot 2026-07-21 114318.png), not the earlier
         icon-on-top-of-text stack (human review, 2026-07-28). 2 columns rather than 4
         at desktop (human review, 2026-07-28) — 4-across read as cramped/narrow next
         to the mockup's wide tile proportions. -->
    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        benefits.map((b, i) => (
          <div
            class="tile-hover relative flex h-full items-center gap-4 rounded-xl border border-white/10 bg-navy-800/40 p-6"
            data-reveal
            style={`transition-delay: ${i * 70}ms`}
          >
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-teal-400/10 text-teal-400">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d={b.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div class="pr-6">
              {/* pr-6 (mobile-audit fix, 2026-08-07): reserves space for the
                  absolutely-positioned eco-leaf pinned to the card's own
                  top-right corner below — without it, "Lower Maintenance
                  Costs" (the longest title) ran its last word right up
                  against the leaf icon on a single-column mobile card,
                  since an absolutely-positioned sibling doesn't reflow text
                  around itself the way inline content would. */}
              <h3 class="text-lg font-semibold text-offwhite">{b.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{b.body}</p>
            </div>
            {/* Pinned to the card's own top-right corner (not inline after the
                title) — an inline icon's x position would track each title's
                length, and "Increase Operational Efficiency" is long enough
                to have pushed a centered popover off the right edge on a
                narrow, near-full-width mobile card. Fixed at the corner, the
                icon's position is consistent across every card and
                breakpoint, so a plain 'end' anchor (opens leftward, into the
                card's own — always wide-enough — width) is safe everywhere. */}
            <span class="absolute right-4 top-4">
              <InfoTip icon="eco" label={t.ecoTipLabel(b.title)} position="end">
                {b.eco}
              </InfoTip>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Same fix as HowItWorks.astro's li.tile-hover:hover, MlopsSystem's
     .mlops-node:hover, and StatCard.astro's own .tile-hover:hover: the
     shared .tile-hover lift (global.css) gives a hovered card a `transform`,
     making it the containing block — and stacking context — for its own
     absolutely-positioned InfoTip popover, which can otherwise render under
     a later sibling card. Astro's style scoping means the earlier fixes
     don't reach this file, so it's repeated here for Benefits' own
     .tile-hover usage. */
  .tile-hover:hover,
  .tile-hover:focus-within {
    z-index: 10;
  }

  /* Extends InfoTip.astro's own eco-leaf "growing" flourish (undrawn vein +
     spring grow-in-size on the icon's own hover/focus) to the whole card:
     hovering anywhere on the tile — not just the tiny leaf button in its
     corner — sprouts the leaf too, so the animation reads as a property of
     the benefit tile itself, not a fiddly detail you have to find. */
  .tile-hover:hover :global(.eco-leaf),
  .tile-hover:focus-within :global(.eco-leaf) {
    transform: scale(1.15);
  }
  .tile-hover:hover :global(.eco-leaf-vein),
  .tile-hover:focus-within :global(.eco-leaf-vein) {
    stroke-dashoffset: 0;
  }
</style>
