---
import Button from './Button.astro';
import StatRow from './StatRow.astro';
import { withBase } from '../lib/site';
---

<section class="relative overflow-hidden">
  <!--
    Full-bleed hero photo, right side, mirrors design/mockups/Screenshot 2026-07-21 112341.png:
    a background layer behind the copy, not a boxed/bordered image. Two gradient divs (not a
    single photo) fade it into navy-950 on its left and bottom edges so it blends with the page
    instead of reading as a separate card. Desktop-only (§ mobile hides it — see below).

    PREVIEW ASSET: this is prototype-1-hero-image.png (design/visual-assets/), not the approved
    macro-gears photo from docs/IMAGE_ASSETS.md item 1 — swap the src below once one is chosen.
  -->
  <div class="pointer-events-none absolute inset-y-0 right-0 -z-20 hidden w-[62%] lg:block" aria-hidden="true">
    <img
      src={withBase('/images/hero/prototype-1-hero-image.png')}
      alt=""
      class="h-full w-full object-cover"
    />
    <!-- fade into the page background on the left edge -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to right, var(--color-navy-950) 0%, transparent 42%);"
    >
    </div>
    <!-- fade into the page background at the bottom edge -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to bottom, transparent 55%, var(--color-navy-950) 100%);"
    >
    </div>
  </div>

  <!-- Cyberpunk glow overlay (separate from the photo, per §5) -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background:
      radial-gradient(60% 55% at 78% 35%, rgba(45,212,191,0.16), transparent 70%),
      radial-gradient(45% 40% at 12% 8%, rgba(59,130,246,0.14), transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <!-- Copy block -->
    <div class="max-w-2xl">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-blue-500">
        Predictive maintenance, powered by AI
      </p>

      <h1 class="text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl 2xl:text-7xl">
        <span class="text-offwhite">Predict failures.</span><br />
        <span class="text-teal-400">Prevent</span> <span class="text-offwhite">downtime.</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted 2xl:max-w-2xl 2xl:text-xl">
        Preempt Analytics helps manufacturing teams predict machine failures
        before they happen—so you can maximize uptime and efficiency.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <Button href={withBase('/product')} variant="solid">See it in action →</Button>
        <Button href={withBase('/try-it-yourself')} variant="outline">
          Test it on your device
        </Button>
      </div>

      <p class="mt-5 text-xs text-muted/60">
        A capstone project showcase, running on simulated CNC sensor data.
      </p>
    </div>

    <!-- Stat row sits on the dark/faded area, wider than the copy block, as in the mockup -->
    <div class="mt-10 max-w-4xl">
      <StatRow />
    </div>
  </div>
</section>
