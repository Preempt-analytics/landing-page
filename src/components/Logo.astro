---
// Real brand mark (design/visual-assets/logo.png, generated + cropped to a
// square with padding trimmed — ARCHITECTURE.md §7 item 1, now resolved).
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <Image src={logo} width={30} height={30} alt="" class="shrink-0" />
  <span class="leading-tight">
    <span class="block text-[1.05rem] font-semibold tracking-tight text-offwhite">Preempt</span>
    <span class="block text-[0.7rem] font-medium tracking-[0.2em] text-muted uppercase">Analytics</span>
  </span>
</span>
