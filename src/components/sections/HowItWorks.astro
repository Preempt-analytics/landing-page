---
// §9.3 How it works — the birds-eye, non-technical loop. NO tool logos here (that's
// §9.6's job); this is the same system at a shallower zoom. Cards stack on mobile.
// Icon rings + a wraparound feedback arrow (human review, 2026-07-23): each icon
// sits in a gradient ring straddling the card's top edge, and a curved arrow beneath
// the row loops from the last card back to the first — visually spelling out
// "One system. One loop. Always learning." The wraparound arrow only renders at the
// lg breakpoint where all 6 cards share one row (§12 responsive rule); stacked
// layouts get a simple text loop-back cue instead of bent SVG geometry.
import Button from '../Button.astro';
import { withBase } from '../../lib/site';

const steps = [
  { n: '1', title: 'Collect', body: 'Stream sensor data from your machines in real time.', icon: 'pulse' },
  { n: '2', title: 'Predict', body: 'AI models assess failure probability continuously.', icon: 'brain' },
  { n: '3', title: 'Detect', body: 'Anomalies and drift are caught early and automatically.', icon: 'search' },
  { n: '4', title: 'Retrain', body: 'Models retrain on fresh data through the pipeline.', icon: 'refresh' },
  { n: '5', title: 'Improve', body: 'Predictions get better over time — cutting downtime and cost.', icon: 'check' },
];
const outcome = { title: 'Business Impact', body: 'Increase uptime. Lower costs. Extend asset life.', icon: 'chart' };

const icons: Record<string, string> = {
  pulse: 'M3 12h3l2-6 4 12 2-6h4',
  brain: 'M9 3a3 3 0 0 0-3 3 3 3 0 0 0-1 5 3 3 0 0 0 2 5 3 3 0 0 0 6 0V4a3 3 0 0 0-3-1zm6 0a3 3 0 0 1 3 3 3 3 0 0 1 1 5 3 3 0 0 1-2 5',
  search: 'M11 4a7 7 0 1 0 4.2 12.6L21 21m-4.5-9.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z',
  refresh: 'M4 9a8 8 0 0 1 14-3l2 2M20 15a8 8 0 0 1-14 3l-2-2M20 4v4h-4M4 20v-4h4',
  check: 'M20 6 9 17l-5-5',
  chart: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
};

// One gradient per node, cycling through the site's existing teal/blue tokens
// (Contract 4 — new hues aren't introduced, existing ones are recombined).
const ringGradients = [
  'linear-gradient(135deg, var(--color-teal-400), var(--color-blue-500))',
  'linear-gradient(135deg, var(--color-blue-500), var(--color-teal-300))',
  'linear-gradient(135deg, var(--color-teal-300), var(--color-teal-500))',
  'linear-gradient(135deg, var(--color-teal-500), var(--color-blue-500))',
  'linear-gradient(135deg, var(--color-blue-500), var(--color-teal-400))',
];
const outcomeGradient = 'linear-gradient(135deg, var(--color-teal-300), var(--color-teal-400))';
---

<section id="how-it-works" class="scroll-mt-20 border-t border-white/5 bg-navy-950 py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-offwhite sm:text-4xl 2xl:text-5xl">
        The AI + MLOps platform for continuous reliability
      </h2>
      <p class="mt-4 text-lg text-muted 2xl:text-xl">One system. One loop. Always learning.</p>
    </div>

    <!-- Loop: 6 cards, horizontal row at lg, single column below that (human review,
         2026-07-28: no intermediate 2-col tablet break — the row either fits on one
         line or stacks, never splits awkwardly into two columns). -->
    <div class="relative mt-16 pb-14 lg:pb-28 lg:pt-28">
      <ol class="grid gap-x-4 gap-y-10 lg:grid-cols-6 lg:gap-y-4">
        {
          [...steps, outcome].map((s, i) => {
            const isOutcome = i === steps.length;
            const gradient = isOutcome ? outcomeGradient : ringGradients[i];
            return (
              <li class={`relative rounded-xl border pt-9 p-5 ${isOutcome ? 'border-teal-400/60 bg-teal-400/[0.06]' : 'border-white/10 bg-navy-800/40'}`}>
                <div
                  class="absolute -top-7 left-1/2 h-14 w-14 -translate-x-1/2 rounded-full p-[3px] shadow-lg shadow-black/30"
                  style={`background: ${gradient};`}
                >
                  <div class="flex h-full w-full items-center justify-center rounded-full bg-navy-950">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-teal-300">
                      <path d={icons[s.icon]} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </div>
                </div>

                <h3 class="text-center text-base font-semibold text-offwhite lg:text-left">
                  {'n' in s ? `${s.n}. ${s.title}` : s.title}
                </h3>
                <p class="mt-1.5 text-center text-sm leading-relaxed text-muted lg:text-left">{s.body}</p>
                {!isOutcome && (
                  <!-- Connector arrow: a gap-width box centered exactly on the gutter
                       (left-full + w-4 matching gap-x-4), so the icon lands centered
                       between tiles regardless of viewport width (human review,
                       2026-07-28: the old text-glyph arrow was small/hard to see). -->
                  <span class="pointer-events-none absolute left-full top-1/2 z-10 hidden h-8 w-4 -translate-y-1/2 items-center justify-center lg:flex" aria-hidden="true">
                    <svg width="18" height="14" viewBox="0 0 18 14" fill="none">
                      <path d="M1 7h13M9 1l7 6-7 6" stroke="var(--color-teal-400)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                )}
              </li>
            );
          })
        }
      </ol>

      <!-- Feed-forward arrow: Collect (top-left) arcs over the top into Business Impact
           (top-right) — matches simplified_process.png's top arc (human review,
           2026-07-28: this arrow was missing entirely). Desktop only. -->
      <svg
        class="pointer-events-none absolute inset-x-0 top-4 hidden h-20 w-full overflow-visible lg:block"
        viewBox="0 0 1200 90"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="loop-arrow-gradient-top" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--color-teal-400)" stop-opacity="0.15" />
            <stop offset="0.5" stop-color="var(--color-teal-400)" stop-opacity="0.8" />
            <stop offset="1" stop-color="var(--color-teal-400)" stop-opacity="0.9" />
          </linearGradient>
          <marker id="loop-arrow-head-top" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="10" markerHeight="10" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-teal-400)" />
          </marker>
        </defs>
        <path
          d="M 100 60 C 100 35, 100 20, 140 20 L 1060 20 C 1100 20, 1100 35, 1100 60"
          fill="none"
          stroke="url(#loop-arrow-gradient-top)"
          stroke-width="2.5"
          marker-end="url(#loop-arrow-head-top)"
        />
      </svg>

      <!-- Feedback-loop arrow: Business Impact curves back to feed Collect again (desktop only) -->
      <svg
        class="pointer-events-none absolute inset-x-0 bottom-4 hidden h-20 w-full overflow-visible lg:block"
        viewBox="0 0 1200 90"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="loop-arrow-gradient" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--color-teal-400)" stop-opacity="0.9" />
            <stop offset="0.5" stop-color="var(--color-teal-400)" stop-opacity="0.8" />
            <stop offset="1" stop-color="var(--color-teal-400)" stop-opacity="0.15" />
          </linearGradient>
          <marker id="loop-arrow-head" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="10" markerHeight="10" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-teal-400)" />
          </marker>
        </defs>
        <path
          d="M 1100 0 C 1100 45, 1100 65, 1060 65 L 140 65 C 100 65, 100 45, 100 0"
          fill="none"
          stroke="url(#loop-arrow-gradient)"
          stroke-width="2.5"
          marker-end="url(#loop-arrow-head)"
        />
      </svg>

      <!-- Same loop-back cue, as text, when cards are stacked and the curved arrows don't fit -->
      <p class="absolute inset-x-0 bottom-0 text-center text-xs font-medium text-teal-400/70 lg:hidden">
        ↻ feeds back into Collect — always learning
      </p>
    </div>

    <div class="mt-4 flex flex-wrap justify-center gap-4">
      <Button href={withBase('/product')} variant="solid">See it in action →</Button>
      <Button href={withBase('/try-it-yourself')} variant="outline">Test it on your device</Button>
    </div>
  </div>
</section>
