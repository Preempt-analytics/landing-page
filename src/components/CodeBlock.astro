---
// Terminal command block with a copy button (mobile-audit fix, 2026-08-07).
// The whole point of these snippets is to be pasted into a terminal — on a
// narrow phone screen the command scrolls off the edge of its own box (long
// git clone URLs especially), so selecting the exact text by hand is fiddly
// even though the box scrolls correctly. A copy button sidesteps that
// entirely: tap once, paste, done, without ever needing to read or select
// the full command. Extracted here rather than repeated three times inline
// on try-it-yourself.astro (the only page with commands to copy).
import { useTranslations, DEFAULT_LOCALE, type Locale } from '../i18n';

interface Props {
  code: string;
  locale?: Locale;
}
const { code, locale = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(locale).codeBlock;
---

<div class="code-block relative mt-5 overflow-x-auto rounded-lg border border-white/10 bg-navy-950 p-4">
  <button
    type="button"
    class="copy-btn absolute right-2 top-2 inline-flex items-center gap-1 rounded-md border border-white/10 bg-navy-800/80 px-2 py-1 text-xs font-medium text-muted transition-colors duration-[var(--dur-fast)] hover:bg-white/10 hover:text-offwhite"
    aria-label={t.copyAriaLabel}
    data-copied-label={t.copied}
  >
    <!-- Copy/check icon pair — only one shown at a time, toggled by the
         script's `is-copied` class below. Text label stays alongside (not
         icon-only) so the state change doesn't rely on the icon swap alone. -->
    <svg class="copy-btn-icon-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
    </svg>
    <svg class="copy-btn-icon-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5" />
    </svg>
    <span class="copy-btn-label">{t.copy}</span>
  </button>
  <pre class="pr-14 text-sm text-teal-200"><code>{code}</code></pre>
</div>

<script>
  // Reads from the rendered <code> element's own textContent rather than a
  // separate copy of the string, so the copied text can never drift from
  // what's actually displayed. Astro dedupes this module script once per
  // page regardless of how many <CodeBlock> instances render (same reasoning
  // as InfoTip.astro's own script).
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.code-block').forEach((block) => {
      const btn = block.querySelector<HTMLButtonElement>('.copy-btn');
      const code = block.querySelector('code');
      const label = block.querySelector<HTMLElement>('.copy-btn-label');
      if (!btn || !code || !label) return;
      const defaultLabel = label.textContent;
      const copiedLabel = btn.dataset.copiedLabel || 'Copied!';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          label.textContent = copiedLabel;
          btn.classList.add('is-copied');
          setTimeout(() => {
            label.textContent = defaultLabel;
            btn.classList.remove('is-copied');
          }, 1500);
        } catch {
          // Clipboard API can fail (permissions, insecure context) — fail
          // quietly rather than showing a misleading "Copied!" state.
        }
      });
    });
  });
</script>

<style>
  /* Only one of the two icons shows at a time — check replaces copy while
     `.is-copied` is set (see the script above), same 1500ms window the
     "Copied!" text label already used before this icon pair existed. */
  .copy-btn-icon-check {
    display: none;
  }
  .copy-btn.is-copied .copy-btn-icon-copy {
    display: none;
  }
  .copy-btn.is-copied .copy-btn-icon-check {
    display: block;
  }
</style>
