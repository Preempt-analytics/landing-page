---
// §9.2 Live Factory — connective tissue between the abstract hero and the physical
// hardware. Real isometric CNC-floor photo (design/visual-assets/cnc_factory_floor.png,
// human review 2026-07-28), with the drift-alert callout as a UI overlay on top.
// No card border/fill (human review, 2026-07-28): a soft radial mask fades the photo
// to transparent at the edges instead, so it bleeds into the section's own bg-navy-900
// rather than sitting in a boxed card.
import { withBase } from '../../lib/site';
import { liveMachines } from '../../lib/live-machines';

// Mini sparkline for each machine's hover card — the same recorded run
// /product's Live Machines panel replays (src/data/live-machines.json), drawn
// at BUILD time as a plain <svg polyline>, so this costs zero client JS and no
// extra payload beyond the points string itself.
//
// NOTE ON NAMING: the CNC-0N names in this section are illustrative (see the
// `machines` comment below); the traces are real. CNC-0N maps to the recording's
// machine_0N, and the card labels the line as a recorded run rather than as
// live telemetry from the illustrated machine.
const recording = liveMachines();
const PROB = recording._meta.fields.indexOf('failure_prob');

function sparkPoints(name: string): string {
  const idx = Number(name.split('-')[1]) - 1;
  const frames = recording.machines[idx]?.frames ?? [];
  if (frames.length < 2) return '';
  // ~40 points is plenty at this size and keeps each points string short.
  const stride = Math.max(1, Math.round(frames.length / 40));
  const pts: string[] = [];
  for (let i = 0; i < frames.length; i += stride) {
    const p = Number(frames[i][PROB]);
    pts.push(`${((i / (frames.length - 1)) * 100).toFixed(1)},${(18 - p * 16).toFixed(1)}`);
  }
  return pts.join(' ');
}

// Named for immersion (human-requested, 2026-07-28) — CNC-01 matches the exact
// machine name already used in UserStory.astro's "Tool-wear shift spotted on
// CNC-01" beat, so this section's alert ties into that same story rather than
// introducing a second, disconnected machine id. Coordinates/delays unchanged
// from the original pin placement (read directly off cnc-factory-floor.png).
// bootDelay staggers the one-time "power-up" flash each pin plays the first
// time the section scrolls into view (human-requested, 2026-07-28) — a
// separate concern from `delay`, which offsets each pin's *continuous*
// ambient pulse so five sensors don't breathe in lockstep. Both live on the
// same element at once (see .sensor-pin's two-animation rule in <style>).
const machines = [
  { name: 'CNC-02', left: 27.7, top: 30.8, delay: '-0.6s', bootDelay: '0ms', alert: false },
  { name: 'CNC-01', left: 61.5, top: 24.4, delay: '0s', bootDelay: '150ms', alert: true },
  { name: 'CNC-03', left: 80.1, top: 26.9, delay: '-1.7s', bootDelay: '300ms', alert: false },
  { name: 'CNC-04', left: 39.1, top: 56.2, delay: '-0.9s', bootDelay: '450ms', alert: false },
  { name: 'CNC-05', left: 67.1, top: 56.6, delay: '-2.1s', bootDelay: '600ms', alert: false },
];

// Scattered catwalk/background indicator lights (human-requested, 2026-07-28,
// replacing an earlier roaming-spotlight version) — deliberately placed away
// from the 5 machines above and the drift callout's own corner (roughly
// left 40–54%, top 3–20%) so they read as background texture, not more
// things demanding attention next to the section's actual focal points.
// Durations are all different (and not simple multiples of each other) so
// no two lights ever visibly fall into sync. bootDelay staggers each light's
// one-time "power surging on" flicker the first time the section scrolls
// into view (human-requested, 2026-07-28) — deliberately NOT the same
// stagger schedule as the machines' own bootDelay above, so the whole
// scene's lights don't power on in two neat, separately-timed sequences —
// some of these flicker on before, between, and after the machine pins do,
// reading as one uneven facility waking up rather than two clean cascades.
const structureLights = [
  { left: 8, top: 18, duration: 5.2, delay: 0, bootDelay: 0.05 },
  { left: 92, top: 14, duration: 7.4, delay: 1.1, bootDelay: 0.5 },
  { left: 14, top: 62, duration: 6.1, delay: 2.6, bootDelay: 0.25 },
  { left: 90, top: 66, duration: 8.7, delay: 0.4, bootDelay: 0.7 },
  { left: 50, top: 78, duration: 9.6, delay: 3.3, bootDelay: 0.4 },
];
---

<section class="relative overflow-hidden border-t border-white/5 bg-navy-900 py-20" id="live-factory">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 md:px-8 lg:grid-cols-2">
    <!-- Copy -->
    <div data-reveal>
      <h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl 2xl:text-6xl">
        <span class="text-offwhite">Live Factory.</span><br />
        <span class="text-teal-400">Real Predictions.</span>
      </h2>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted 2xl:max-w-xl 2xl:text-xl">
        The system can watch CNC milling machines around the clock. The moment
        tool wear, or process temperature starts to shift, it catches the change — often
        hours before that could cause a failure.
      </p>
    </div>

    <!-- CNC floor photo -->
    <div class="factory-scene relative z-0" data-reveal style="transition-delay: 100ms">
      <!-- Ambient glow behind the photo — same slow breathing treatment as
           Hero's ambient light (global.css's ambient-breathe), so the two
           sections read as one consistent "the scene is alive" system
           rather than motion being a one-off on the homepage's first fold.
           z-0 above (not just relative) so this -z-10 layer stays contained
           behind the photo instead of escaping to paint behind unrelated
           page content — the exact bug Hero.astro's own z-0 comment flags. -->
      <div
        class="hero-glow pointer-events-none absolute -inset-8 -z-10"
        style="background: radial-gradient(50% 50% at 50% 40%, rgba(45,212,191,0.18), transparent 70%); animation-duration: 13s; filter: blur(20px);"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative aspect-[3/2] w-full overflow-hidden"
        style="mask-image: radial-gradient(ellipse 100% 100% at center, black 15%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 100% 100% at center, black 15%, transparent 100%);"
      >
        <img
          src={withBase('/images/live-factory/cnc-factory-floor.png')}
          alt="Isometric view of a CNC milling factory floor with five machines, glowing teal sensor lights, and a catwalk structure."
          class="factory-photo-parallax h-full w-full object-cover"
        />
      </div>

      <!-- Structure lights: small, dim indicator lights scattered around the
           catwalk/background — NOT the 5 named machines' own sensor pins
           below, a separate, more numerous layer of tiny ambient lights that
           blink occasionally and irregularly rather than breathing smoothly
           (human-requested, 2026-07-28, replacing an earlier roaming-
           spotlight version — this reads as "a real industrial facility,"
           since real indicator/catwalk lighting flickers unevenly, not in
           one uniform pulse). Each gets its own animation-duration/delay so
           they blink independently, never in sync with each other. -->
      {
        structureLights.map((l) => (
          <span
            class="structure-light"
            style={`left: ${l.left}%; top: ${l.top}%; animation-duration: ${l.duration}s, 1.3s; animation-delay: ${l.delay}s, ${l.bootDelay}s;`}
            aria-hidden="true"
          />
        ))
      }

      <!-- Sensor-light overlay: each pin sits on that machine's actual antenna/
           mount stub in the photo (coordinates read directly off
           cnc-factory-floor.png, not the old placeholder-SVG percentages).
           4 teal = healthy; CNC-01 (back-center) is red — its callout card
           below sits immediately above it, close enough that proximity alone
           says which machine it's about (no leader line needed: a long
           diagonal across the whole scene makes the viewer trace a line
           to find the answer, where sitting right next to it gives the
           answer for free — Krug/Redish, human review 2026-07-28).

           Each pin is now wrapped in a real <button> hotspot (human-requested,
           2026-07-28): hovering/focusing a healthy machine reveals its own
           "No drift detected" card, mirroring CNC-01's always-visible one but
           in green — proximity again does the disambiguation, since each
           card is anchored to its own hotspot, not a shared/roaming tooltip.
           CNC-01 keeps its callout always visible (the section's main "aha"
           moment shouldn't require a hover to see) but still gets the same
           hotspot wrapper so its glow gets the same hover-pause affordance
           as the other four. -->
      {
        machines.map((m) => (
          <button
            type="button"
            class={`machine-hotspot ${m.alert ? 'machine-hotspot--alert' : ''}`}
            style={`left: ${m.left}%; top: ${m.top}%;`}
            aria-label={
              m.alert
                ? `${m.name}: drift detected, tool wear shift, 2.3 hours to failure`
                : `${m.name}: no drift detected, Safe `
            }
          >
            <span
              class={`sensor-pin ${m.alert ? 'sensor-pin--alert' : ''}`}
              style={`animation-delay: ${m.bootDelay}, ${m.delay};`}
              aria-hidden="true"
            />
            {!m.alert && (
              <span class="machine-card machine-card--healthy">
                <span class="machine-card-header">
                  <span class="machine-card-status">
                    <span class="machine-card-dot" aria-hidden="true" />
                    No drift detected
                  </span>
                  <span class="machine-card-name">{m.name}</span>
                </span>
                <span class="machine-card-detail">Nominal — no anomalies</span>
              </span>
            )}
          </button>
        ))
      }

      <!-- Drift callout card (UI overlay, independent of the photo underneath).
           Sits directly above the alerting machine, its bottom edge almost
           touching that pin and clearly closer to it than to the left or
           right machine — proximity alone disambiguates which one it means.
           Left always-visible by default (unchanged from before) rather than
           folded into the hover-only .machine-card treatment above, so a
           visitor who never hovers anything still sees the section's point. -->
      <a href={withBase('/product/#live-machines')} class="drift-card tile-hover">
        <span class="machine-card-header">
          <span class="machine-card-status">
            <span class="machine-card-dot" aria-hidden="true"></span>
            Drift detected
          </span>
          <span class="machine-card-name">CNC-01</span>
        </span>
        <span class="machine-card-title">Tool Wear Shift</span>
        <span class="machine-card-detail">2.3 hrs to failure</span>
        <span class="machine-spark machine-spark--reveal">
          <svg viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
            <polyline points={sparkPoints('CNC-01')} />
          </svg>
          <span class="machine-spark-cta">See it in action →</span>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  // Touch devices have no :hover, and iOS Safari never moves real focus to a
  // tapped <button> (so :focus/:focus-visible don't fire either) — without
  // this, the healthy-machine cards would be unreachable on mobile. Tapping a
  // hotspot toggles .is-tapped (which the CSS below treats like hover/focus);
  // tapping it again, tapping a different hotspot, or tapping anywhere else
  // closes it. Bound to astro:page-load, not top-level: this section lives
  // inside <main>, which isn't transition:persist-ed, so a fresh <script>
  // arrives every time a visitor navigates back to "/" via a client-side
  // transition, not just on the first hard load.
  document.addEventListener('astro:page-load', () => {
    const hotspots = document.querySelectorAll<HTMLButtonElement>('.machine-hotspot');

    hotspots.forEach((hotspot) => {
      hotspot.addEventListener('click', (event) => {
        event.stopPropagation();
        const wasOpen = hotspot.classList.contains('is-tapped');
        hotspots.forEach((h) => h.classList.remove('is-tapped'));
        if (!wasOpen) hotspot.classList.add('is-tapped');
      });
    });

    document.addEventListener('click', () => {
      hotspots.forEach((h) => h.classList.remove('is-tapped'));
    });
  });
</script>

<style>
  /* Invisible ~2rem hit target centered on the pin's coordinate — the visible
     dot is only 0.65rem, well under a real tap/click target size, so the
     button is sized for touch/click while the dot inside stays visually
     small. Reset to look like nothing (no button chrome) until its contents
     are styled below. */
  .machine-hotspot {
    position: absolute;
    z-index: 20;
    transform: translate(-50%, -50%);
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* .machine-card's z-index:40 only wins *inside* this button's own stacking
     context — its permanent `transform` above (for centering) creates one,
     per spec. From outside, the whole button is just one auto-z-index box,
     so the always-visible red drift card (later in the DOM, same level)
     paints over it regardless of the popup's z-index. Raising the button's
     own z-index — only while its card is actually showing — is what lets
     the popup rise above the red card where they overlap
     (human-requested, 2026-07-28). */
  .machine-hotspot:hover,
  .machine-hotspot:focus-visible,
  .machine-hotspot:focus {
    z-index: 50;
  }

  /* Reuses global.css's pulse-pin keyframe. Per-pin animation-delay is
     negative so each starts mid-cycle at a different phase — five sensors
     pulsing in lockstep would read as one fake blinking light, not five
     independent machines. Positioned centered *within* the hotspot button
     (left/top 50% + its own translate), the same technique the button uses
     to center on its coordinate in the photo — keeps this rule reusable
     regardless of what it's nested inside. */
  .sensor-pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 9999px;
    transform: translate(-50%, -50%);
    background-color: var(--color-teal-400);
    box-shadow: 0 0 10px 3px color-mix(in srgb, var(--color-teal-400) 70%, transparent);
    /* Two animations, always both listed (never redeclared later) so the
       inline animation-delay="{bootDelay}, {delay}" above always matches up
       positionally — pulse-pin is the continuous ambient breathing (as
       before); boot-flash is the one-time "power-up" this pin plays the
       first time the section scrolls into view. boot-flash starts *paused*
       — frozen on its neutral 0% frame, so it visibly does nothing — until
       .factory-scene.is-visible below flips it to running. Without this
       gate it would just play immediately on page load, off-screen, and be
       long over by the time anyone actually scrolls down to see it. */
    animation: pulse-pin 3.6s var(--ease-ios-in-out) infinite, boot-flash 0.7s var(--ease-ios) both;
    animation-play-state: running, paused;
  }
  .factory-scene.is-visible .sensor-pin {
    animation-play-state: running, running;
  }
  @keyframes boot-flash {
    0% { filter: brightness(1); }
    40% { filter: brightness(2.2); }
    100% { filter: brightness(1); }
  }
  .sensor-pin--alert {
    background-color: var(--color-alert-400);
    box-shadow: 0 0 12px 4px color-mix(in srgb, var(--color-alert-400) 75%, transparent);
    animation-duration: 2.4s;
  }
  /* Hovering/focusing a hotspot settles its own light rather than leaving it
     pulsing right next to the card that just appeared — a small "focused"
     cue, and one less thing competing for attention with the card's text. */
  .machine-hotspot:hover .sensor-pin,
  .machine-hotspot:focus-visible .sensor-pin,
  .machine-hotspot.is-tapped .sensor-pin {
    animation-play-state: paused;
    transform: translate(-50%, -50%) scale(1.2);
  }

  /* Per-machine hover/focus card — same proven hover+focus popover technique
     as InfoTip.astro's glossary popover (opacity/transform/visibility, not
     display, so it can transition), sized and typeset to match CNC-01's
     always-visible callout below so the two read as one design system. Not
     gated behind (hover: hover): unlike the purely decorative .tile-hover
     lift used elsewhere, this card *is* the requested feature, so it also
     has to work via tap-to-focus on touch devices, not just mouse hover. */
  /* Shared type/padding scale for BOTH card kinds, so the always-visible red
     drift card and the hover-only green cards read as one system rather than
     two lookalikes that drift apart. Compact below sm — at phone widths the
     old fixed widths were too narrow for the header to fit on one line, which
     is what made "NO DRIFT / DETECTED" and "CNC-\n01" wrap into the squashed
     proportions this replaces. */
  .machine-card,
  .drift-card {
    --fc-pad: 0.55rem;
    --fc-label: 0.55rem;
    --fc-name: 0.5rem;
    --fc-detail: 0.65rem;
    --fc-title: 0.78rem;
  }
  @media (min-width: 640px) {
    .machine-card,
    .drift-card {
      --fc-pad: 0.75rem;
      --fc-label: 0.65rem;
      --fc-name: 0.6rem;
      --fc-detail: 0.75rem;
      --fc-title: 0.875rem;
    }
  }

  /* Always-visible drift callout. Below sm it moves to the top-left corner:
     at phone widths the photo is short, so a card anchored above CNC-01 (at
     61.5%/24.4%) inevitably collided with that machine's own pin. Top-left
     keeps it horizontally clear of the pin instead of stacked on top of it. */
  .drift-card {
    position: absolute;
    display: block;
    text-decoration: none;
    left: 1%;
    top: 2%;
    z-index: 10;
    width: max-content;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-alert-400) 50%, transparent);
    background: color-mix(in srgb, var(--color-navy-950) 90%, transparent);
    backdrop-filter: blur(4px);
    padding: var(--fc-pad);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
  }
  @media (min-width: 640px) {
    .drift-card {
      left: 47%;
      top: 3%;
    }
  }
  .drift-card .machine-card-status,
  .drift-card .machine-card-dot {
    color: var(--color-alert-400);
    background-color: transparent;
  }
  .drift-card .machine-card-dot {
    background-color: var(--color-alert-400);
  }
  .machine-card-title {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--fc-title);
    font-weight: 600;
    color: var(--color-offwhite);
  }

  .machine-card {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    z-index: 40;
    width: max-content;
    transform: translate(-50%, 4px) scale(0.96);
    transform-origin: bottom center;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-success-400) 50%, transparent);
    background: color-mix(in srgb, var(--color-navy-950) 90%, transparent);
    backdrop-filter: blur(4px);
    padding: var(--fc-pad);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-ios), transform var(--dur-base) var(--ease-ios),
      visibility 0s linear var(--dur-base);
  }
  /* .is-tapped: touch equivalent of :hover/:focus-visible, toggled by the script
     below. iOS Safari doesn't move real DOM focus to a tapped <button> (a
     long-standing WebKit quirk), so :focus-visible/:focus alone never fire on
     mobile — without this, the healthy-machine cards would be permanently
     unreachable for touch users. */
  .machine-hotspot:hover .machine-card,
  .machine-hotspot:focus-visible .machine-card,
  .machine-hotspot:focus .machine-card,
  .machine-hotspot.is-tapped .machine-card {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0) scale(1);
    /* --ease-spring only on the way in — a slight overshoot reads as a small
       "discovery" delight when the card appears. The hide direction (base
       .machine-card rule above) keeps --ease-ios: overshooting on the way
       OUT would look like a glitch, not a pop. */
    transition: opacity var(--dur-fast) var(--ease-ios), transform var(--dur-base) var(--ease-spring), visibility 0s;
  }
  /* Header row: status on the left (the point of the card), machine name
     small/muted in the upper-right corner — a label for context, not
     competing with the status for attention (human-requested, 2026-07-28). */
  /* nowrap on both halves + width:max-content on the cards is what keeps the
     status label and the machine name on a single line at every width. */
  .machine-card-header {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .machine-card-status {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    font-size: var(--fc-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-success-400);
  }
  .machine-card-dot {
    display: inline-block;
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background-color: var(--color-success-400);
  }
  .machine-card-name {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: var(--fc-name);
    font-weight: 500;
    color: var(--color-muted);
    opacity: 0.7;
  }
  .machine-card-detail {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--fc-detail);
    color: var(--color-muted);
  }

  /* Mini version of /product's Live Machines trace — the same recorded run,
     drawn at build time (see sparkPoints() in the frontmatter). Purely an
     <svg polyline>, so it costs no client JS and nothing is computed live.
     Drift card only (human review, 2026-08-05): on the four healthy cards it
     was decoration on a card whose whole message is "nothing to see here". */
  .machine-spark {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-alert-400);
  }
  .machine-spark svg {
    display: block;
    width: 100%;
    height: 1.3rem;
  }
  .machine-spark polyline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    /* preserveAspectRatio="none" stretches the viewBox non-uniformly, which
       would smear the stroke thickness with it without this. */
    vector-effect: non-scaling-stroke;
  }
  /* "See it in action" is the site's settled look-verb CTA for /product
     (ARCHITECTURE.md §5) — reused verbatim rather than inventing a card-sized
     synonym, since the two-verb system is explicitly a Danger Zone. */
  .machine-spark-cta {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-teal-300);
  }

  /* The drift card is always visible, so its sparkline stays collapsed until
     CNC-01 is hovered/focused/tapped — otherwise the extra height would push
     the card back down onto that machine's own pin, the overlap this pass
     just fixed. :has() lets the sibling hotspot drive it with no extra JS;
     browsers without :has() simply never expand it, which is a clean no-op. */
  .machine-spark--reveal {
    max-height: 0;
    margin-top: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height var(--dur-base) var(--ease-ios),
      margin-top var(--dur-base) var(--ease-ios),
      opacity var(--dur-fast) var(--ease-ios);
  }
  .drift-card:hover .machine-spark--reveal,
  .drift-card:focus-visible .machine-spark--reveal,
  .factory-scene:has(.machine-hotspot--alert:hover) .machine-spark--reveal,
  .factory-scene:has(.machine-hotspot--alert:focus-visible) .machine-spark--reveal,
  .factory-scene:has(.machine-hotspot--alert.is-tapped) .machine-spark--reveal {
    max-height: 3.5rem;
    margin-top: 0.4rem;
    opacity: 1;
  }

  /* Structure lights (see the markup comment above): small, dim indicator
     dots, each with its own animation-duration/delay set inline so they
     never blink in sync. The keyframe stays dim for nearly the whole cycle
     with one sharp spike near the end — an occasional flicker, not a smooth
     breathing pulse (that's what the machines' own .sensor-pin already
     does, and this needs to read as a visually distinct, lesser layer, not
     five more sensor pins). Positioned with left/top directly (not
     transform), same reasoning as the roaming spotlight this replaced: an
     animated `transform` here would have to repeat this element's static
     centering translate in every keyframe stop or lose it outright (the
     transform-composition gotcha) — animating left/top instead sidesteps
     that category of bug entirely rather than working around it. */
  .structure-light {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    transform: translate(-50%, -50%);
    background-color: #eafffb;
    box-shadow: 0 0 4px 1px rgba(234, 255, 251, 0.8);
    opacity: 0.15;
