---
// §9.3 How it works — the birds-eye, non-technical loop. NO tool logos here (that's
// §9.6's job); this is the same system at a shallower zoom. Cards stack on mobile.
// Icon rings + a wraparound feedback arrow (human review, 2026-07-23): each icon
// sits in a gradient ring straddling the card's top edge, and a curved arrow beneath
// the row loops from the last card back to the first — visually spelling out
// "One system. One loop. Always learning." The wraparound arrow only renders at the
// lg breakpoint where all 6 cards share one row (§12 responsive rule); stacked
// layouts get a simple text loop-back cue instead of bent SVG geometry.
import Button from '../Button.astro';
import InfoTip from '../InfoTip.astro';
import { withBase } from '../../lib/site';

// Longer, plain-language explanation per card (Krug/Redish: what happens, why
// it matters, how it connects to the rest of the loop) — surfaced via an
// InfoTip so the cards themselves stay scannable at a glance, per the
// existing card body copy, while a curious/non-technical reader can dig one
// level deeper without leaving the page.
const steps = [
  {
    n: '1',
    title: 'Collect',
    body: 'Stream sensor data from your machines in real time.',
    icon: 'pulse',
    info: "Sensors on your machines send in real-time readings — temperature, vibration, pressure — every few seconds. Nothing else in this loop works without this: it's the raw material every prediction is built on. Think of it as the system's eyes and ears on the factory floor.",
  },
  {
    n: '2',
    title: 'Predict',
    body: 'AI models assess failure probability continuously.',
    icon: 'brain',
    info: 'AI models look at those incoming readings and continuously estimate how likely each machine is to fail soon. Instead of waiting for a scheduled inspection, you get an early, ongoing read on machine health. This is what turns raw sensor data into a warning you can actually act on.',
  },
  {
    n: '3',
    title: 'Detect',
    body: 'Anomalies and drift are caught early and automatically.',
    icon: 'search',
    info: 'The system watches for two kinds of change: early warning signs of failure, and a shift in the incoming data itself (called "drift") that could make predictions less reliable. Catching drift automatically means problems get flagged before predictions quietly get worse. This step is what keeps the whole loop trustworthy.',
  },
  {
    n: '4',
    title: 'Retrain',
    body: 'Models retrain on fresh data through the pipeline.',
    icon: 'refresh',
    info: "When drift or new patterns are detected, the model is automatically retrained on the freshest data — no engineer has to notice a problem and kick it off by hand. This keeps predictions accurate as machines age or conditions change. It's what makes this a living system instead of a one-time model that slowly goes stale.",
  },
  {
    n: '5',
    title: 'Improve',
    body: 'Predictions get better over time — cutting downtime and cost.',
    icon: 'check',
    info: 'With an up-to-date model back in place, predictions get sharper instead of drifting downward over time. That means fewer surprise breakdowns and less time and money spent on unnecessary maintenance. This is where the loop pays off — every trip around Collect → Predict → Detect → Retrain leaves the system a little better than before.',
  },
];
const outcome = {
  title: 'Business Impact',
  body: 'Increase uptime. Lower costs. Extend asset life.',
  icon: 'chart',
  info: 'All of the above adds up to fewer unplanned stoppages, lower maintenance costs, and equipment that lasts longer before it needs replacing. This is the reason the whole loop exists — every technical step earns its place by producing this outcome. The results then feed back into Collect, so the improvement never stops.',
};

const icons: Record<string, string> = {
  pulse: 'M3 12h3l2-6 4 12 2-6h4',
  brain: 'M9 3a3 3 0 0 0-3 3 3 3 0 0 0-1 5 3 3 0 0 0 2 5 3 3 0 0 0 6 0V4a3 3 0 0 0-3-1zm6 0a3 3 0 0 1 3 3 3 3 0 0 1 1 5 3 3 0 0 1-2 5',
  search: 'M4 11a7 7 0 1 0 14 0 7 7 0 1 0-14 0zM16 16l5 5',
  refresh: 'M4 9a8 8 0 0 1 14-3l2 2M20 15a8 8 0 0 1-14 3l-2-2M20 4v4h-4M4 20v-4h4',
  check: 'M20 6 9 17l-5-5',
  chart: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
};

// One gradient per node, cycling through the site's existing teal/blue tokens
// (Contract 4 — new hues aren't introduced, existing ones are recombined).
const ringGradients = [
  'linear-gradient(135deg, var(--color-teal-400), var(--color-blue-500))',
  'linear-gradient(135deg, var(--color-blue-500), var(--color-teal-300))',
  'linear-gradient(135deg, var(--color-teal-300), var(--color-teal-500))',
  'linear-gradient(135deg, var(--color-teal-500), var(--color-blue-500))',
  'linear-gradient(135deg, var(--color-blue-500), var(--color-teal-400))',
];
const outcomeGradient = 'linear-gradient(135deg, var(--color-teal-300), var(--color-teal-400))';
---

<section id="how-it-works" class="scroll-mt-20 border-t border-white/5 bg-navy-950 py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="text-3xl font-bold tracking-tight text-offwhite sm:text-4xl 2xl:text-5xl">
        The AI + MLOps platform for continuous reliability
      </h2>
      <p class="mt-4 text-lg text-muted 2xl:text-xl">One system. One loop. Always learning.</p>
    </div>

    <!-- Loop: 6 cards, horizontal row at lg, single column below that (human review,
         2026-07-28: no intermediate 2-col tablet break — the row either fits on one
         line or stacks, never splits awkwardly into two columns). Stacked gap bumped
         to gap-y-20 (human review, 2026-07-28): the next card's icon ring extends 28px
         above its own top edge, so the old gap-y-10 (40px) left only ~12px of true
         open space for the connector arrow before it entered the ring's own "air
         space" — 80px leaves a clean ~52px gap for the arrow, clear of the ring. -->
    <div class="relative mt-16 pb-14 lg:pb-28 lg:pt-28">
      <!-- Wraps just the <ol> (not the padded lg-only arc space around it) so the
           mobile loop-back arrow below, sized via inset-y-0, exactly matches the
           stack's real height — however tall 6 cards of varying body-text length
           actually render (human review, 2026-07-28). -->
      <div class="relative">
      <ol class="grid gap-x-4 gap-y-20 lg:grid-cols-6 lg:gap-y-4">
        {
          [...steps, outcome].map((s, i) => {
            const isOutcome = i === steps.length;
            const gradient = isOutcome ? outcomeGradient : ringGradients[i];
            return (
              <li
                class={`group tile-hover relative max-lg:w-[60%] max-lg:justify-self-center rounded-xl border pt-9 p-5 ${isOutcome ? 'border-teal-400/60 bg-teal-400/[0.06]' : 'border-white/10 bg-navy-800/40'}`}
                data-reveal
                style={`transition-delay: ${i * 70}ms`}
              >
                <div
                  class="absolute -top-7 left-1/2 h-14 w-14 -translate-x-1/2 rounded-full p-[3px] shadow-lg shadow-black/30 transition-transform duration-[var(--dur-base)] ease-[var(--ease-ios)] group-hover:scale-110"
                  style={`background: ${gradient};`}
                >
                  <div class="flex h-full w-full items-center justify-center rounded-full bg-navy-950">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-teal-300">
                      <path d={icons[s.icon]} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </div>
                </div>

                <h3 class="text-center text-base font-semibold text-offwhite lg:text-left">
                  {'n' in s ? `${s.n}. ${s.title}` : s.title}
                  <InfoTip
                    label={`More about ${s.title}`}
                    position={i === 0 ? 'start-lg' : isOutcome ? 'end-lg' : 'center'}
                  >
                    {s.info}
                  </InfoTip>
                </h3>
                <p class="mt-1.5 text-center text-sm leading-relaxed text-muted lg:text-left">{s.body}</p>
                {!isOutcome && (
                  <>
                    <!-- Horizontal connector (lg row layout): a gap-width box centered
                         exactly on the gutter (left-full + w-4 matching gap-x-4), so the
                         icon lands centered between tiles regardless of viewport width
                         (human review, 2026-07-28: the old text-glyph arrow was small/
                         hard to see). -->
                    <span class="pointer-events-none absolute left-full top-1/2 z-10 hidden h-8 w-4 -translate-y-1/2 items-center justify-center lg:flex" aria-hidden="true">
                      <svg width="18" height="14" viewBox="0 0 18 14" fill="none">
                        <path d="M1 7h13M9 1l7 6-7 6" stroke="var(--color-teal-400)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                    <!-- Vertical connector (stacked layout below lg): same idea, rotated.
                         Sits in the first ~half of the gap-y-20 gutter (mt-4, h-7) so it
                         stays clear of the NEXT card's icon ring, which extends 28px above
                         its own top edge and otherwise overlaps the arrow (human review,
                         2026-07-28 — the first version violated the ring's "air space"). -->
                    <span class="pointer-events-none absolute left-1/2 top-full z-10 mt-4 flex h-7 w-8 -translate-x-1/2 items-center justify-center lg:hidden" aria-hidden="true">
                      <svg width="14" height="18" viewBox="0 0 14 18" fill="none">
                        <path d="M7 1v13M1 9l6 7 6-7" stroke="var(--color-teal-400)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </>
                )}
              </li>
            );
          })
        }
      </ol>

      <!-- Mobile pair of gutter arrows, mirroring the desktop's top/bottom arcs —
           freed up by capping each card to 60% width and centering it, leaving a
           gutter on BOTH sides (human review, 2026-07-28, replacing the earlier
           68%-left-aligned/right-gutter-only version).

           Fix (human review, 2026-07-28): `h-full` is load-bearing, not decorative.
           An SVG is a "replaced element" — with only `inset-y-0` (top:0/bottom:0)
           and no explicit height, browsers size it from the viewBox's own intrinsic
           aspect ratio (width × 10, since the viewBox here is 30:300) instead of
           actually stretching to fill the parent. That silently produced a box far
           taller than the real card stack at wider widths (confirmed: height was
           exactly width×10 at every breakpoint tested, up to 3000px+ tall at
           tablet width) — long enough to visibly run into the sections below.
           `h-full` gives the SVG an explicit, definite height, so it actually
           stretches to match this wrapper (sized by the `<ol>` alone) instead.

           Slenderness (human review, 2026-07-28): stroke-width dropped from 2 to
           0.6 — at this viewBox's stretch factor the old value rendered as a thick,
           "bulky" line rather than a slender connector.

           Nominal viewBox is narrow/tall to roughly match each gutter's real
           proportions; preserveAspectRatio="none" stretches it to whatever height
           6 stacked cards actually render at (dynamic — depends on each card's body
           text length), and overflow-visible lets the curve's ends reach sideways,
           into the cards, past each gutter's own narrow box. -->

      <!-- Left gutter: feed-forward, Collect → Business Impact (mirrors the desktop
           top arc's direction) — arrowhead arrives pointing right, into Business
           Impact. -->
      <svg
        class="pointer-events-none absolute left-0 top-0 h-full w-[19%] overflow-visible lg:hidden"
        viewBox="0 0 30 300"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="loop-arrow-gradient-mobile-fwd" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--color-teal-400)" stop-opacity="0.9" />
            <stop offset="0.5" stop-color="var(--color-teal-400)" stop-opacity="0.8" />
            <stop offset="1" stop-color="var(--color-teal-400)" stop-opacity="0.15" />
          </linearGradient>
          <marker id="loop-arrow-head-mobile-fwd" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="4" markerHeight="4" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-teal-400)" />
          </marker>
        </defs>
        <path
          d="M 38 8 C 16 8, 10 15, 10 35 L 10 255 C 10 275, 16 291, 38 291"
          fill="none"
          stroke="url(#loop-arrow-gradient-mobile-fwd)"
          stroke-width="0.6"
          marker-end="url(#loop-arrow-head-mobile-fwd)"
        />
      </svg>

      <!-- Right gutter: loop-back, Business Impact → Collect — arrowhead arrives
           pointing left, into Collect. -->
      <svg
        class="pointer-events-none absolute right-0 top-0 h-full w-[19%] overflow-visible lg:hidden"
        viewBox="0 0 30 300"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="loop-arrow-gradient-mobile-back" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--color-teal-400)" stop-opacity="0.15" />
            <stop offset="0.5" stop-color="var(--color-teal-400)" stop-opacity="0.8" />
            <stop offset="1" stop-color="var(--color-teal-400)" stop-opacity="0.9" />
          </linearGradient>
          <marker id="loop-arrow-head-mobile-back" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="4" markerHeight="4" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-teal-400)" />
          </marker>
        </defs>
        <path
          d="M -8 291 C 14 291, 20 275, 20 255 L 20 35 C 20 15, 14 8, -8 8"
          fill="none"
          stroke="url(#loop-arrow-gradient-mobile-back)"
          stroke-width="0.6"
          marker-end="url(#loop-arrow-head-mobile-back)"
        />
      </svg>
      </div>

      <!-- Feed-forward arrow: Collect (top-left) arcs over the top into Business Impact
           (top-right) — matches simplified_process.png's top arc (human review,
           2026-07-28: this arrow was missing entirely). Desktop only. -->
      <svg
        class="pointer-events-none absolute inset-x-0 top-4 hidden h-20 w-full overflow-visible lg:block"
        viewBox="0 0 1200 90"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="loop-arrow-gradient-top" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--color-teal-400)" stop-opacity="0.15" />
            <stop offset="0.5" stop-color="var(--color-teal-400)" stop-opacity="0.8" />
            <stop offset="1" stop-color="var(--color-teal-400)" stop-opacity="0.9" />
          </linearGradient>
          <marker id="loop-arrow-head-top" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="10" markerHeight="10" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-teal-400)" />
          </marker>
        </defs>
        <path
          d="M 100 60 C 100 35, 100 20, 140 20 L 1060 20 C 1100 20, 1100 35, 1100 60"
          fill="none"
          stroke="url(#loop-arrow-gradient-top)"
          stroke-width="2.5"
          marker-end="url(#loop-arrow-head-top)"
        />
      </svg>

      <!-- Feedback-loop arrow: Business Impact curves back to feed Collect again (desktop only) -->
      <svg
        class="pointer-events-none absolute inset-x-0 bottom-4 hidden h-20 w-full overflow-visible lg:block"
        viewBox="0 0 1200 90"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="loop-arrow-gradient" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--color-teal-400)" stop-opacity="0.9" />
            <stop offset="0.5" stop-color="var(--color-teal-400)" stop-opacity="0.8" />
            <stop offset="1" stop-color="var(--color-teal-400)" stop-opacity="0.15" />
          </linearGradient>
          <marker id="loop-arrow-head" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="10" markerHeight="10" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 Z" fill="var(--color-teal-400)" />
          </marker>
        </defs>
        <path
          d="M 1100 0 C 1100 45, 1100 65, 1060 65 L 140 65 C 100 65, 100 45, 100 0"
          fill="none"
          stroke="url(#loop-arrow-gradient)"
          stroke-width="2.5"
          marker-end="url(#loop-arrow-head)"
        />
      </svg>

      <!-- Text confirmation of what the side arrow above already shows visually —
           kept short since the arrow (not this caption) now carries the meaning. -->
      <p class="mt-3 text-center text-xs font-medium text-teal-400/70 lg:hidden">
        feeds back into Collect — always learning
      </p>
    </div>

    <div class="mt-4 flex flex-wrap justify-center gap-4">
      <Button href={withBase('/product')} variant="solid">See it in action →</Button>
      <Button href={withBase('/try-it-yourself')} variant="outline">Test it on your device</Button>
    </div>
  </div>
</section>

<style>
  /* The shared .tile-hover lift (global.css) puts a `transform` on whichever
     card is hovered, and `transform` makes an element the containing block
     for its own absolutely-positioned descendants — including that card's
     InfoTip popover. Without this, a hovered card's popover can render
     UNDER a later sibling card: z-index only ranks elements within a shared
     stacking context, and the transform just gave each card its own. Bumping
     z-index on hover lets the open popover's whole stacking context win
     against neighboring cards regardless of DOM order. */
  @media (hover: hover) and (pointer: fine) {
    li.tile-hover:hover {
      z-index: 30;
    }
  }
</style>
