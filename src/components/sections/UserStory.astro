  /* Tablet → Morning Summary trace line (human-requested, 2026-08-07 —
     same "Watch Dogs 2, but Apple-sophisticated" reticle family as
     Hero.astro's target-lock corners: white, self-drawing via
     pathLength="1" + stroke-dashoffset, no scan-line/glitch effect).
     x1/y1/x2/y2 are set by the script above from real getBoundingClientRect
     measurements — this block only owns the drawn-in *look*, not the
     geometry. overflow: visible on the wrapper isn't needed since the line
     stays fully inside the wrapper's own box by construction (both
     endpoints are measured relative to it). */
  .tablet-trace {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .tablet-trace line {
    stroke: #fff;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.6));
    transition: stroke-dashoffset var(--dur-slow) var(--ease-ios);
  }
  /* Corner-bracket "lock" on the tablet's own glow point — identical
     technique to Hero.astro's target-lock reticle (four short paths,
     pathLength="1" self-draw), reused rather than reinvented now that it's
     documented in ANIMATION_SCRAPBOOK.md. Arrives just after the line
     finishes drawing, not at the same instant — "here's where it started"
     reads as a beat that follows the line, not a simultaneous flash
     competing with it for attention. Positioned via the `<g>`'s own
     `transform` (set in the script above), so these four paths keep fixed,
     never-recalculated local coordinates regardless of where the tablet
     point actually lands on screen. */
  .tablet-trace-reticle path {
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.7));
    transition: stroke-dashoffset var(--dur-base) var(--ease-ios) var(--dur-slow),
      opacity var(--dur-fast) var(--ease-ios) var(--dur-slow);
  }
  .tablet-trace-reticle path:nth-child(2) { transition-delay: calc(var(--dur-slow) + 40ms); }
  .tablet-trace-reticle path:nth-child(3) { transition-delay: calc(var(--dur-slow) + 80ms); }
  .tablet-trace-reticle path:nth-child(4) { transition-delay: calc(var(--dur-slow) + 120ms); }

  /* The traveling pulse (human-requested follow-up, 2026-08-07 — "more
     Watch Dogs 2 like"): a small dot gliding the line's own path on a slow
     loop, the same "data/energy flowing" cue as this scrapbook's own
     traveling-dot pattern (docs/ANIMATION_SCRAPBOOK.md, Path-based motion).
     This — not just a static connector line — is the actual detail that
     reads as "live data trace" rather than "a line was drawn between two
     things." offset-path is set by the script above to match the line's
     real x1/y1/x2/y2 exactly, so the dot never drifts off the visible
     stroke. Starts only once the line/reticle have finished their own
     draw-in (animation-delay stacks on top of --dur-slow the same way the
     reticle's transition-delay does), and loops gently rather than racing
     back and forth — an ambient "still syncing" read, not an alert. */
  .tablet-trace-pulse {
    fill: #fff;
    opacity: 0;
    filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.9));
  }
  [data-tablet-trace].is-traced .tablet-trace line {
    stroke-dashoffset: 0;
  }
  [data-tablet-trace].is-traced .tablet-trace-reticle path {
    stroke-dashoffset: 0;
    opacity: 1;
  }
  [data-tablet-trace].is-traced .tablet-trace-pulse {
    animation: tablet-trace-pulse-travel 2.6s var(--ease-ios-in-out) calc(var(--dur-slow) + 300ms) infinite;
  }
  @keyframes tablet-trace-pulse-travel {
    0% { offset-distance: 0%; opacity: 0; }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tablet-trace line,
    .tablet-trace-reticle path,
    .tablet-trace-pulse {
      transition: none;
      animation: none;
    }
  }

  /* Overnight Impact + Morning Summary content, both held back as the
     story's payoff (see the markup comments on data-overnight-impact/
     data-morning-summary above) — hidden via opacity+visibility, not
     display:none, so each keeps occupying its own layout position
     throughout (the trace line's own endpoint math depends on measuring
     Morning Summary's real position even before it's visually revealed,
     and hiding via display:none would also collapse Overnight Impact's
     card down to just its own padding) and so Morning Summary's "See the
     dashboard" link is genuinely unreachable — not just invisible — to
     keyboard/screen-reader users until it actually appears: visibility,
     unlike opacity alone, removes an element from both hit-testing and the
     tab order. Fade + a gentle scale-up (--ease-spring, this project's own
     "discovery moment" easing, reserved for exactly this kind of one-off
     reveal rather than routine hovers) reads as the sleek/Apple-like arrival
     asked for, not a static cut from invisible to visible. */
  .reveal-story {
    opacity: 0;
    visibility: hidden;
    transform: scale(0.96);
    transition: opacity var(--dur-slow) var(--ease-ios), transform var(--dur-slow) var(--ease-spring),
      visibility 0s linear var(--dur-slow);
  }
  [data-timeline].is-story-complete ~ .mt-16 .reveal-story {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    transition: opacity var(--dur-slow) var(--ease-ios), transform var(--dur-slow) var(--ease-spring), visibility 0s;
  }
  /* Overnight Impact staggers in after Morning Summary (human-requested
     "stagger", order reversed 2026-08-11 — Morning Summary now lands
     first, Overnight Impact settles in after) — both cards are the
     story's payoff, but revealing them at the exact same instant read as
     one flat event rather than two; an offset reads as a cascade instead.
     480ms (an earlier pass tried 150ms, then 300ms, then 400ms — all in
     the original Overnight-Impact-first order or before settling on the
     final value; 150ms in particular read as simultaneous against the
     650ms `--dur-slow` reveal, too small a fraction of the transition to
     register as two beats). Same specificity as the rule above (one
     attribute + three classes each), so this — coming later in source
     order — only overrides the one longhand (transition-delay) it names,
     inheriting duration/easing from the shorthand above rather than
     needing to repeat the whole transition declaration. */
  [data-timeline].is-story-complete ~ .mt-16 .reveal-story--delayed {
    transition-delay: 480ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-story {
      transition: opacity var(--dur-fast) linear, visibility 0s linear var(--dur-fast);
    }
    [data-timeline].is-story-complete ~ .mt-16 .reveal-story--delayed {
      transition-delay: 0s;
    }
  }

