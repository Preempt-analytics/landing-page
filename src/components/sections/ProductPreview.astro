---
// §9.1 Product Preview — the "See it in action" destination. The dashboard is a
// finished screenshot shown inside browser chrome, framed as a Concept preview so
// its (deliberately) dead interactivity reads as intentional. A team-recorded
// in-action clip drops into the same frame later (open item §7).
import { Image } from 'astro:assets';
import dashboard from '../../assets/dashboard.png';
---

<section id="product" class="scroll-mt-20 border-t border-white/5 bg-navy-950 py-20">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-teal-400">
        The product
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-offwhite sm:text-4xl 2xl:text-5xl">
        Here's what the dashboard looks like.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        A maintenance control center: fleet health, machines ranked by failure
        probability, and live sensor readings — all in one place.
      </p>
    </div>

    <!-- Framed concept preview -->
    <figure class="relative mx-auto mt-12 max-w-5xl" data-reveal>
      <div class="product-mockup group overflow-hidden rounded-xl border border-white/10 bg-navy-900 shadow-2xl shadow-black/40">
        <!-- browser chrome -->
        <div class="flex items-center gap-2 border-b border-white/10 bg-navy-800/60 px-4 py-2.5">
          <span class="h-3 w-3 rounded-full bg-alert-400/70"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-400/60"></span>
          <span class="h-3 w-3 rounded-full bg-teal-400/70"></span>
          <span class="ml-3 truncate text-xs text-muted/60">preempt-analytics · maintenance control center</span>
        </div>
        <Image
          src={dashboard}
          alt="Preempt Analytics maintenance dashboard: an Overall Fleet Health tile at 94%, a Priority Maintenance Queue ranking machines such as Press-07 (97% failure probability, critical) and CNC-03 (89%, high), a failure-probability trend chart, and live sensor tiles for temperature, vibration, rotational speed, torque and tool wear."
          widths={[640, 960, 1280]}
          sizes="(max-width: 1024px) 100vw, 1024px"
          class="block w-full select-none transition-transform duration-[var(--dur-slow)] ease-[var(--ease-ios)] group-hover:scale-[1.02]"
          draggable="false"
        />
      </div>

      <!-- Concept-preview cue: this is a picture of the app, not the live app -->
      <figcaption class="absolute right-4 top-14 rounded-full border border-teal-400/40 bg-navy-950/80 px-3 py-1 text-[0.7rem] font-medium text-teal-300 backdrop-blur-sm">
        Concept preview
      </figcaption>
    </figure>

    <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-muted/70">
      A static preview of the interface — an animated walkthrough of the system
      running is on the way.
    </p>
  </div>
</section>

<script>
  // Bound to astro:page-load, not top-level: this section lives inside <main>,
  // which isn't transition:persist-ed, so a fresh, unbound instance of this
  // markup arrives on every client-side navigation to a page that renders it.
  document.addEventListener('astro:page-load', () => {
    // Toned-down cursor-parallax tilt on the framed dashboard mockup (moved
    // here from LiveFactory.astro, human-requested, 2026-07-28 — this is a
    // single coherent "device" shot with no competing hover interactions
    // and no live DOM text to skew under the rotation (the screenshot is one
    // rasterized image), so a subtle 3° perspective tilt reads as "looking
    // at a product photo from a slight angle" rather than fighting for
    // attention against anything else. Coexists with the image's own
    // group-hover:scale-[1.02] above — that's the image zooming inside the
    // frame, this is the whole frame tilting; different elements, same
    // hover moment. Skipped entirely (not just slowed down) for touch/no-
    // hover and for prefers-reduced-motion — continuous pointer-follow
    // motion is exactly the kind of thing that setting exists to opt out
    // of, not just soften.
    const mockup = document.querySelector<HTMLElement>('.product-mockup');
    const canTilt =
      mockup &&
      window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (canTilt && mockup) {
      const MAX_TILT_DEG = 3;
      mockup.addEventListener('mousemove', (e) => {
        const rect = mockup.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        mockup.style.transform = `perspective(1000px) rotateX(${(-y * MAX_TILT_DEG * 2).toFixed(2)}deg) rotateY(${(x * MAX_TILT_DEG * 2).toFixed(2)}deg)`;
      });
      mockup.addEventListener('mouseleave', () => {
        mockup.style.transform = '';
      });
    }
  });
</script>

<style>
  /* Perspective tilt target for the cursor-parallax script above. No
     [data-reveal] collision to worry about here (unlike a couple of earlier
     spots in this pass) — data-reveal lives on the outer <figure>, this
     transition is on the inner .product-mockup div, a different element
     with no competing transition of its own. */
  .product-mockup {
    transition: transform 300ms var(--ease-ios-in-out);
  }
</style>
