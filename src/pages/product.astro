---
// §9.1 Product Preview, now its own subpage rather than an early homepage section
// (human review: the dashboard-specific "here's the product" content was too
// specific to sit right after the hero, before the site had explained anything
// about how the system works). Reuses BaseLayout + Nav + Footer like /try-it-yourself.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductPreview from '../components/sections/ProductPreview.astro';
import Button from '../components/Button.astro';
import { withBase } from '../lib/site';
import { useTranslations, DEFAULT_LOCALE } from '../i18n';

const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
const t = useTranslations(locale).productPage;
const tCommon = useTranslations(locale).common;
---

<BaseLayout title={t.title} description={t.description}>
  <div class="mx-auto max-w-6xl px-5 pt-10 md:px-8">
    <a href={withBase('/', locale)} class="text-sm text-teal-400 hover:text-teal-300">{tCommon.backToHome}</a>
  </div>
  <ProductPreview />
  <div class="mx-auto max-w-6xl px-5 pb-20 md:px-8">
    <div class="flex justify-center">
      <Button href={withBase('/try-it-yourself', locale)} variant="solid">{tCommon.testItOnYourDeviceArrow}</Button>
    </div>
  </div>
</BaseLayout>
