---
// German /try-it-yourself page — mirrors src/pages/try-it-yourself.astro
// exactly (see that file's own comments for the section's history). Only the
// relative import depth changes (one directory deeper under /de/); all copy
// comes from the i18n dictionary via Astro.currentLocale, resolved
// automatically from this file's location under Astro's i18n routing
// (astro.config.mjs). Keep this file's composition in sync with
// try-it-yourself.astro's whenever it changes — the shell commands
// (git clone, docker compose, ./preempt.sh) stay untranslated on purpose,
// same as the English version.
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTip from '../../components/InfoTip.astro';
import BeginnersTrail from '../../components/BeginnersTrail.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import StatCard from '../../components/StatCard.astro';
import { REPO_URL, withBase } from '../../lib/site';
import { isLive, retrainCount, relativeTime } from '../../lib/metrics';
import { isCiLive, totalCiRuns, lastCiRunAt } from '../../lib/ci';
import { useTranslations, DEFAULT_LOCALE } from '../../i18n';

const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
const t = useTranslations(locale).tryItYourselfPage;
const tCommon = useTranslations(locale).common;

const metricsLive = isLive();
const retrains = retrainCount();
const retrainsCaption = metricsLive ? tCommon.liveUpdatedHourly : tCommon.sampleMetric;

const ciLive = isCiLive();
const ciRuns = totalCiRuns();
const ciCaption = ciLive ? t.ciLiveLastRun(relativeTime(lastCiRunAt(), locale)) : tCommon.sampleMetric;
---

<BaseLayout title={t.title} description={t.description}>
  <section class="relative z-0 overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[420px] sm:h-[480px]" aria-hidden="true">
      <img
        src={withBase('/images/try-it-yourself/macro-gears.png')}
        alt=""
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-navy-950/75"></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(to bottom, transparent 15%, var(--color-navy-950) 100%);"
      >
      </div>
    </div>

    <div class="relative mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-24">
    <a href={withBase('/', locale)} class="text-sm text-teal-400 hover:text-teal-300">{tCommon.backToHome}</a>

    <h1 class="mt-6 text-4xl font-bold tracking-tight text-offwhite sm:text-5xl">
      {t.heading}
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-muted">
      {t.subheading}
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <StatCard
        value={String(retrains)}
        label={t.modelRetrains}
        caption={retrainsCaption}
        captionTone={metricsLive ? 'live' : 'plain'}
        info={t.modelRetrainsInfo}
        locale={locale}
      >
        <svg slot="icon" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 9a8 8 0 0 1 14-3l2 2M20 15a8 8 0 0 1-14 3l-2-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M20 4v4h-4M4 20v-4h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </StatCard>
      <StatCard
        value={String(ciRuns)}
        label={t.ciPipelineRuns}
        caption={ciCaption}
        captionTone={ciLive ? 'live' : 'plain'}
        info={t.ciPipelineInfo}
        locale={locale}
      >
        <svg slot="icon" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="5" cy="12" r="2.2" stroke="currentColor" stroke-width="1.6" />
          <circle cx="12" cy="12" r="2.2" stroke="currentColor" stroke-width="1.6" />
          <circle cx="19" cy="12" r="2.2" stroke="currentColor" stroke-width="1.6" />
          <path d="M7.2 12h2.6M14.2 12h2.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </StatCard>
    </div>

    <BeginnersTrail title={t.trail1.title} locale={locale}>
      <p>{t.trail1.body1}</p>
      <p>
        {t.trail1.step1}<br />
        {t.trail1.step2}<br />
        {t.trail1.step3}
      </p>
      <p>
        {t.trail1.closing}
      </p>
    </BeginnersTrail>

    <div class="mt-10 rounded-xl border border-white/10 bg-navy-800/40 p-5">
      <p class="text-sm font-semibold text-offwhite">{t.prerequisitesIntro}</p>
      <ul class="mt-3 space-y-3 text-sm text-muted">
        <li>
          <a
            href="https://www.docker.com/products/docker-desktop/"
            target="_blank"
            rel="noopener"
            class="text-teal-300 underline decoration-teal-400/40 underline-offset-4 hover:text-teal-200"
          >
            {t.dockerLinkText}
          </a>
          <InfoTip label={t.dockerInfoLabel}>
            {t.dockerInfoBody}
          </InfoTip>
          {t.dockerTrailing}
        </li>
        <li>
          <a
            href="https://git-scm.com/downloads"
            target="_blank"
            rel="noopener"
            class="text-teal-300 underline decoration-teal-400/40 underline-offset-4 hover:text-teal-200"
          >
            {t.gitLinkText}
          </a>
          <InfoTip label={t.gitInfoLabel}>
            {t.gitInfoBody}
          </InfoTip>
          {t.gitTrailing}
        </li>
      </ul>
    </div>

    <h2 class="mt-16 text-xl font-semibold text-offwhite">{t.getCodeHeading}</h2>
    <p class="mt-3 text-muted">{t.openTerminal}</p>
    <CodeBlock code={`git clone https://github.com/Preempt-Analytics-Demo/predictive-maintenance-demo.git
cd predictive-maintenance-demo`} locale={locale} />
    <p class="mt-4 text-sm text-muted">
      {t.thatFolderNote}{' '}
      <a href={REPO_URL} target="_blank" rel="noopener" class="text-teal-400 hover:text-teal-300">
        {t.viewSourceOnGithub}
      </a>
    </p>

    <BeginnersTrail title={t.trail2.title} locale={locale}>
      <p>
        {t.trail2.body1}
      </p>
      <p>
        {t.trail2.body2Prefix} <code>{t.trail2.body2Code}</code> {t.trail2.body2Suffix}
      </p>
      <p>
        {t.trail2.body3}
      </p>
    </BeginnersTrail>

    <h2 class="mt-16 text-xl font-semibold text-offwhite">{t.easyWayHeading}</h2>
    <p class="mt-3 text-muted">
      {t.easyWayBody}
    </p>
    <CodeBlock code={`${t.macLinuxComment}
./preempt.sh

${t.windowsComment}
.\\preempt.ps1`} locale={locale} />
    <p class="mt-4 text-sm text-muted">
      {t.pressSixNote}
    </p>

    <h2 class="mt-16 text-xl font-semibold text-offwhite">{t.typeItHeading}</h2>
    <p class="mt-3 text-muted">
      {t.typeItBody}
    </p>
    <CodeBlock code={`git clone https://github.com/Preempt-Analytics-Demo/predictive-maintenance-demo.git
cd predictive-maintenance-demo
docker compose up -d`} locale={locale} />
    <p class="mt-4 text-sm text-muted">
      {t.fromThereNote}
    </p>

    <div class="mt-10 rounded-xl border border-teal-400/20 bg-teal-400/[0.04] p-5">
      <p class="text-sm text-muted">
        <span class="font-semibold text-teal-300">{t.headsUpLead}</span> {t.headsUpBody}
      </p>
    </div>

    <div class="mt-12">
      <a
        href={REPO_URL}
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-lg bg-teal-400 px-6 py-3 text-sm font-semibold text-navy-950 transition-colors hover:bg-teal-300"
      >
        {t.fullInstructions}
      </a>
    </div>
    </div>
  </section>
</BaseLayout>
