---
// One hero stat tile. Styling rule (§5): all values render the same off-white;
// teal is reserved for the icon + a 1px top-border accent — one consistent system.
import InfoTip from './InfoTip.astro';
import { useTranslations, DEFAULT_LOCALE, type Locale } from '../i18n';

interface Props {
  value: string;
  label: string;
  caption: string;
  locale?: Locale;
  /** 'live' shows a teal dot; 'illustrative' is a quiet honesty label. */
  captionTone?: 'live' | 'illustrative' | 'plain';
  /** Optional plain-language explanation of the metric, surfaced via an InfoTip. */
  info?: string;
  /** One-time "tap for details" callout pointing at this card's InfoTip —
      meant for exactly one stat tile in StatRow.astro (currently "Retrains
      Automatically" — moved there 2026-08-06 from "Failure Recall", which
      had less vertical room above its icon before the value number), so a
      first-time visitor learns the (i) icons are interactive at all. Only
      ever set on one card at a time; move it by moving the prop, not by
      duplicating this treatment. Deliberately not part of InfoTip itself,
      which is reused at a dozen-plus other spots sitewide (HowItWorks,
      Benefits, MlopsSystem, ProductPreview) — repeating this hint at every
      one of those would be noise, not help. Says "Tap", not "Hover"
      (mobile-audit fix, 2026-08-07) — most visitors are on a touch device,
      which has no hover, so telling them to hover was asking for something
      they couldn't do; "tap" reads fine for a mouse user too. Dismiss was
      originally CSS-only (an adjacent-sibling :hover/:focus-within rule,
      still present below as a no-JS fallback) but that snapped the bubble
      straight back the instant the pointer left — human-requested follow-up,
      2026-08-07: make the first real interaction dismiss it for good instead
      of it being able to reappear on a later pass over the icon. Permanence
      needs the small client script below (CSS alone has no memory once
      :hover/:focus-within stops matching), mirroring Hero.astro's
      hero-marker-hint fade-out animation. InfoTip.astro's own tap-to-focus
      script (2026-08-07) is what makes :focus-within/focusin — and
      therefore this dismissal — actually reachable by tapping, not just by
      mouse hover. Hidden outright on fine-pointer/hover-capable devices (see
      the `@media (hover: hover)` rule below, 2026-08-07 follow-up) — a mouse
      user already gets the popover from a plain hover with no instruction
      needed, so "Tap for details" would be both wrong (they didn't tap) and
      redundant there. */
  hint?: boolean;
}
const { value, label, caption, captionTone = 'plain', info, hint = false, locale = DEFAULT_LOCALE } = Astro.props;
const tCommon = useTranslations(locale).common;
const tStatCard = useTranslations(locale).statCard;
---

<div class="tile-hover relative rounded-xl border border-white/10 border-t-teal-400/70 bg-navy-800/40 p-5 backdrop-blur-sm">
  <div class="mb-3 text-teal-400">
    <slot name="icon" />
  </div>
  <div class="text-2xl font-bold text-offwhite">{value}</div>
  <div class="mt-0.5 flex items-center gap-1 text-sm font-medium text-offwhite/90">
    {label}
    {info && (
      <span class="relative inline-flex">
        <InfoTip label={tCommon.whatIs(label)} position="center">
          {info}
        </InfoTip>
        {hint && (
          <span class="stat-hint" aria-hidden="true">
            {tStatCard.tapForDetails}
          </span>
        )}
      </span>
    )}
  </div>
  <div class="mt-2 flex items-center gap-1.5 text-xs text-muted/70">
    {
      captionTone === 'live' && (
        <span class="live-dot inline-block h-1.5 w-1.5 rounded-full bg-teal-400" aria-hidden="true" />
      )
    }
    <span>{caption}</span>
  </div>
</div>

<script>
  // Permanent one-time dismissal for `.stat-hint` (see the `hint` prop
  // comment above) — the CSS-only adjacent-sibling rule further down can
  // only ever react to the CURRENT :hover/:focus-within state, so it snaps
  // the bubble straight back the moment the pointer leaves instead of
  // remembering it was already shown once. `{ once: true }` on both
  // listeners is what makes this "first interaction only": the handler
  // removes itself after firing, so there's no extra state to track beyond
  // the class it adds. Astro dedupes a component's own inline module script
  // across every usage of that component on a page (same note as
  // InfoTip.astro's own script), so this still runs once regardless of how
  // many StatCard instances render.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.stat-hint').forEach((hint) => {
      const infoTip = hint.previousElementSibling;
      if (!(infoTip instanceof HTMLElement)) return;
      const dismiss = () => hint.classList.add('stat-hint--dismissed');
      infoTip.addEventListener('mouseenter', dismiss, { once: true });
      infoTip.addEventListener('focusin', dismiss, { once: true });
    });
  });
</script>

<style>
  /* Same fix as HowItWorks.astro's li.tile-hover:hover and MlopsSystem's
     .mlops-node:hover: .tile-hover's hover lift (global.css) puts a
     `transform` on this card, making it the containing block — and stacking
     context — for its own absolutely-positioned InfoTip popover, which can
     otherwise render under a later sibling card in the same row. Astro's
     style scoping means that earlier fix doesn't reach this file, so it's
     repeated here for StatCard's own .tile-hover usage. */
  .tile-hover:hover,
  .tile-hover:focus-within {
    z-index: 10;
  }

  /* "Tap for details" discovery bubble (see the `hint` prop comment above).
     Nested inside its own `relative inline-flex` wrapper alongside the
     InfoTip in the template so `bottom: 100%` anchors it directly above the
     (i) icon itself — the actual thing it's telling you to hover. Left-
     anchored (not centered) with the tail near its own left edge, so the
     bubble body grows rightward into open card space instead of spreading
     left back over the row's own label text or the value number above
     (human-requested follow-up, 2026-08-06: tail on the left pointing
     straight down at the icon, bubble shouldn't block either piece of text).
     z-index is scoped safely within this card's own stacking context
     (backdrop-filter on .tile-hover already creates one, same as `filter`),
     so it never needs to out-rank a neighboring card. */
  .stat-hint {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    z-index: 15;
    white-space: nowrap;
    border-radius: 0.5rem;
    border: 1px solid rgba(45, 212, 191, 0.35);
    background: color-mix(in srgb, var(--color-navy-800) 95%, transparent);
    color: var(--color-teal-300);
    padding: 0.3rem 0.6rem;
    font-size: 0.68rem;
    font-weight: 600;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    pointer-events: none;
    animation: stat-hint-bob 2.2s var(--ease-ios-in-out) infinite;
    transition: opacity var(--dur-fast) var(--ease-ios);
  }
  /* Speech-bubble tail: a rotated square clipped to its bottom-right border,
     `border/background: inherit` so it always matches the bubble exactly
     regardless of future color tweaks, rather than a second hardcoded color.
     Fixed 8px from the bubble's own left edge — roughly the icon's own
     horizontal center (the icon is 1.15rem/18.4px wide) — not centered under
     the whole bubble, since the bubble itself is left-anchored to the icon
     now, not centered over it. */
  .stat-hint::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 8px;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    transform: rotate(45deg);
    background: inherit;
    border: inherit;
    border-top: none;
    border-left: none;
  }
  @keyframes stat-hint-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
  /* Adjacent-sibling, not :has() — .stat-hint is a plain sibling of .info-tip
     inside their shared wrapper span now, so this is the simpler selector.
     Kept as a no-JS fallback even though the script above now also handles
     dismissal permanently: if JS fails to load, hovering/focusing the (i)
     still hides the bubble out of the popover's way while it's open, even
     though it isn't able to stay dismissed afterward in that case. */
  .info-tip:hover + .stat-hint,
  .info-tip:focus-within + .stat-hint {
    opacity: 0;
  }
  /* Permanent dismissal (see the `hint` prop comment and the script above) —
     added once, by JS, on the first real hover/focus and never removed.
     Fades and lifts out through its own @keyframes rather than just
     snapping to `display: none`, echoing Hero.astro's hero-marker-hint exit
     — then `forwards` holds the 100% end state so it stays gone instead of
     reverting once the (short) animation finishes. */
  .stat-hint--dismissed {
    animation: stat-hint-dismiss var(--dur-base) var(--ease-ios) forwards;
  }
  @keyframes stat-hint-dismiss {
    0% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(-4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .stat-hint {
      animation: none;
    }
  }
  /* Fine-pointer + hover-capable devices (mouse/trackpad, not touch) don't
     need telling to "Tap" — hovering the (i) icon already opens the popover
     with no extra step needed, and an always-visible bubble reads as
     overwhelming next to a row of stat cards on a desktop viewport
     (human-requested, 2026-08-07 — briefly tried swapping the wording to
     "Hover for details" instead of hiding it, reverted same session: simply
     not showing it there won out). Same feature-detection pattern
     MlopsSystem.astro already uses to gate its own hover-only affordance. */
  @media (hover: hover) and (pointer: fine) {
    .stat-hint {
      display: none;
    }
  }
  /* Apple-style "live" status pulse — slow, gentle breathing, not an urgent
     blink. Reuses global.css's ambient-breathe keyframe (already used for
     the hero's background glow layers) rather than pulse-pin, which bakes
     in a translate(-50%,-50%) centering offset meant for absolutely-
     positioned dots; this one is a plain inline dot with no such offset.
     prefers-reduced-motion is already handled globally (global.css). */
  .live-dot {
    animation: ambient-breathe 2.6s var(--ease-ios-in-out) infinite;
  }
</style>
