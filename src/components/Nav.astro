---
import Logo from './Logo.astro';
import AccessibilityMenu from './AccessibilityMenu.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getNavLinks, withBase } from '../lib/site';
import { useTranslations, DEFAULT_LOCALE } from '../i18n';

const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const navLinks = getNavLinks(locale);
---

<!-- transition:name is keyed by locale, not a fixed string, so this only
     persists across same-locale navigations. Astro matches persisted
     elements by transition:name between the old and new page; a fixed name
     would match the German page's <header> against the already-rendered
     English one and keep the OLD (English) DOM in place after clicking the
     language switcher, silently leaving the nav in English under German
     page content until a hard refresh. A name mismatch on that one
     cross-locale hop just falls back to Astro's normal (re-rendered)
     transition, which is what's actually wanted there. -->
<header
  class="nav-header sticky top-0 z-50 border-b border-white/5 bg-navy-950/80 backdrop-blur-md"
  data-nav
  transition:persist
  transition:name={`site-nav-${locale}`}
>
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-3.5 md:px-8">
    <a
      href={withBase('/', locale)}
      class="inline-block shrink-0 transition-transform duration-[var(--dur-base)] ease-[var(--ease-ios)] hover:scale-105 active:scale-95"
      aria-label={t.nav.homeAriaLabel}
    >
      <Logo />
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-7 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link text-sm font-medium text-muted hover:text-offwhite">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Accessibility + language controls: two separate, self-evident
         controls rather than one combined menu (Krug review, 2026-08-12 —
         customization and content-language are different mental models, and
         folding both under one icon adds a click of ambiguity neither
         needs). Sits between the nav links and the mobile toggle so it's
         reachable at every breakpoint, unlike the links themselves which
         collapse into the mobile menu below lg. -->
    <div class="flex items-center gap-2">
      <LanguageSwitcher locale={locale} />
      <AccessibilityMenu locale={locale} />

      <!-- Mobile toggle -->
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex items-center justify-center rounded-md p-2 text-muted transition-[color,transform] duration-[var(--dur-fast)] ease-[var(--ease-ios)] hover:text-offwhite active:scale-90 lg:hidden"
        aria-label={t.nav.toggleMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
      <!-- Mobile-audit fix (2026-08-07): three independently-transformable
           lines instead of one combined path, so the icon can morph into an
           X when open (below) — the button already toggled `aria-expanded`
           correctly, but with a static hamburger glyph that never changed,
           there was no visual confirmation the menu was actually open, or
           an obvious "tap here to close" affordance beyond re-tapping the
           same unchanged icon. -->
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path class="nav-toggle-line nav-toggle-line--top" d="M4 6h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path class="nav-toggle-line nav-toggle-line--mid" d="M4 12h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path class="nav-toggle-line nav-toggle-line--bottom" d="M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="border-t border-white/5 lg:hidden">
    <ul class="mx-auto flex max-w-7xl flex-col gap-1 px-5 py-3">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-3 py-2.5 text-sm font-medium text-muted transition-colors duration-[var(--dur-fast)] hover:bg-white/5 hover:text-offwhite"
              data-mobile-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Runs once: <header> is transition:persist-ed, so its DOM node (and every
  // listener bound below) survives every client-side navigation rather than
  // being torn down and rebuilt — no astro:page-load rebinding needed here,
  // unlike the non-persisted <main> content elsewhere on the site.
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  // Close the menu after tapping a link.
  document.querySelectorAll('[data-mobile-link]').forEach((el) =>
    el.addEventListener('click', () => {
      menu?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );

  // Hairline/shadow once scrolled — re-checked on every transition too, since
  // a new page loads scrolled to the top even though this header persists.
  const header = document.querySelector('[data-nav]');
  const syncScrolled = () => header?.classList.toggle('nav-scrolled', window.scrollY > 8);
  syncScrolled();
  window.addEventListener('scroll', syncScrolled, { passive: true });
  document.addEventListener('astro:page-load', syncScrolled);

  // Watch Dogs 2-style "lock-on" reticule for the Project & Team link
  // (human-requested, 2026-08-12) — a one-shot visual cue that frames
  // Footer.astro's #team-panel as the page scrolls to it, so the jump reads
  // as landing somewhere specific rather than an anonymous scroll. Scoped to
  // only this one link, not generalized to the other three homepage-anchor
  // links — a deliberate, specific ask, not a new sitewide pattern.
  //
  // Positioned with position:absolute at the target's own document
  // coordinates (rect + scrollY/scrollX), not position:fixed re-measured on
  // a scroll listener — an absolutely-positioned box scrolls with the page
  // like any other document content, so it stays glued to the target for
  // free with no rAF tracking loop needed, and can be spawned immediately on
  // click (before smooth-scroll even starts) since a target's document
  // position doesn't change as the page scrolls, only what's visible does.
  function fireTargetingReticule(target: HTMLElement) {
    document.querySelector('.targeting-reticule')?.remove();
    const rect = target.getBoundingClientRect();
    const box = document.createElement('div');
    box.className = 'targeting-reticule';
    box.style.top = `${rect.top + window.scrollY}px`;
    box.style.left = `${rect.left + window.scrollX}px`;
    box.style.width = `${rect.width}px`;
    box.style.height = `${rect.height}px`;
    box.innerHTML =
      '<span class="reticule-corner reticule-corner--tl"></span>' +
      '<span class="reticule-corner reticule-corner--tr"></span>' +
      '<span class="reticule-corner reticule-corner--bl"></span>' +
      '<span class="reticule-corner reticule-corner--br"></span>';
    document.body.appendChild(box);
    // Matches the CSS animation's own total run time (global.css's
    // reticule-life keyframes) — removed from the DOM rather than left
    // display:none so a lingering pointer-events:none box can't outlive its
    // own visible animation.
    window.setTimeout(() => box.remove(), 1500);
  }

  // True only between a click on a cross-page copy of this link and the
  // resulting astro:page-load — never set (and so never consulted) by a
  // same-page click, which fires immediately below instead. This is what
  // stops a same-page click from ever double-firing the reticule regardless
  // of whether Astro's ClientRouter also happens to raise astro:page-load
  // for a same-pathname, hash-only navigation.
  let reticuleArmed = false;
  document.querySelectorAll<HTMLAnchorElement>('a[href*="#project-team"]').forEach((link) => {
    link.addEventListener('click', () => {
      if (link.pathname !== location.pathname) {
        reticuleArmed = true;
        return;
      }
      const target = document.getElementById('team-panel');
      if (target) fireTargetingReticule(target);
    });
  });
  document.addEventListener('astro:page-load', () => {
    if (!reticuleArmed) return;
    reticuleArmed = false;
    // Lets the browser's own fragment-scroll settle before framing it —
    // firing on the same tick would measure the pre-scroll layout.
    window.setTimeout(() => {
      const target = document.getElementById('team-panel');
      if (target) fireTargetingReticule(target);
    }, 350);
  });
</script>

<style>
  .nav-header {
    transition: box-shadow var(--dur-base) var(--ease-ios), border-color var(--dur-base) var(--ease-ios);
  }
  .nav-header.nav-scrolled {
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.6);
  }

  .nav-link {
    position: relative;
    transition: color var(--dur-base) var(--ease-ios-in-out);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--color-teal-400);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-base) var(--ease-ios);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  /* Hamburger → X morph (mobile-audit fix, 2026-08-07), keyed off the same
     `aria-expanded` the click handler above already sets — no extra JS.
     transform-origin is the icon's own center (12,12 in its 24×24 viewBox);
     translating each outer line to the middle position and rotating 45°
     around that shared center is the standard hamburger/X recipe — the
     translate happens in the untransformed (screen) axis since it's listed
     before rotate() in the function list, so "down"/"up" stay literal
     regardless of the rotation stacked after them. */
  .nav-toggle-line {
    transform-origin: 12px 12px;
    transition: transform var(--dur-base) var(--ease-ios), opacity var(--dur-fast) var(--ease-ios);
  }
  #nav-toggle[aria-expanded='true'] .nav-toggle-line--top {
    transform: translateY(6px) rotate(45deg);
  }
  #nav-toggle[aria-expanded='true'] .nav-toggle-line--mid {
    opacity: 0;
  }
  #nav-toggle[aria-expanded='true'] .nav-toggle-line--bottom {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Height/opacity reveal instead of an instant display cut. visibility (not
     just opacity) keeps the collapsed menu's links out of the tab order —
     same technique as InfoTip.astro's popover, applied to a bigger panel. */
  #mobile-menu {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    transition: max-height var(--dur-base) var(--ease-ios), opacity var(--dur-fast) var(--ease-ios),
      visibility 0s linear var(--dur-base);
  }
  #mobile-menu.is-open {
    max-height: 28rem;
    opacity: 1;
    visibility: visible;
    transition: max-height var(--dur-base) var(--ease-ios), opacity var(--dur-fast) var(--ease-ios), visibility 0s;
  }
</style>
