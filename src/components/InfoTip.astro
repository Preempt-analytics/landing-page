---
// Small reusable "what is this?" info icon — a CSS-only hover/focus popover
// (no client JS, per the Second Law) giving a short, plain-language definition
// of a jargon term inline in copy. Distinct from BeginnersTrail.astro: this is
// a one-line glossary entry, that's a guided walkthrough for bigger concepts.
interface Props {
  label?: string;
}
const { label = 'What is this?' } = Astro.props;
---

<span class="info-tip">
  <button type="button" class="info-tip-btn" aria-label={label}>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="8" r="1.15" fill="currentColor" stroke="none" />
      <path d="M12 11.5v5" />
    </svg>
  </button>
  <span class="info-tip-pop" role="tooltip"><slot /></span>
</span>

<style>
  .info-tip {
    position: relative;
    display: inline-flex;
    vertical-align: middle;
    margin: 0 0.15em;
  }
  .info-tip-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    padding: 0;
    border: none;
    border-radius: 9999px;
    background: none;
    color: var(--color-muted);
    cursor: help;
    opacity: 0.75;
    transition: color var(--dur-fast) var(--ease-ios-in-out), opacity var(--dur-fast) var(--ease-ios-in-out);
  }
  .info-tip:hover .info-tip-btn,
  .info-tip:focus-visible .info-tip-btn {
    color: var(--color-teal-300);
    opacity: 1;
  }
  .info-tip-pop {
    position: absolute;
    left: 0;
    top: calc(100% + 8px);
    z-index: 20;
    width: 15rem;
    max-width: calc(100vw - 3rem);
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--color-navy-800);
    color: var(--color-offwhite);
    padding: 0.65rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(2px) scale(0.97);
    transform-origin: top left;
    transition: opacity var(--dur-fast) var(--ease-ios), transform var(--dur-base) var(--ease-ios), visibility 0s linear var(--dur-base);
  }
  .info-tip:hover .info-tip-pop,
  .info-tip:focus-within .info-tip-pop {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    transition: opacity var(--dur-fast) var(--ease-ios), transform var(--dur-base) var(--ease-ios), visibility 0s;
  }
</style>
